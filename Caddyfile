# Caddy at the edge of the Compose project. Uses the ACME DNS-01 challenge
# via Cloudflare so we can manage a wildcard cert for *.fanout.run and stay
# compatible with Cloudflare's proxy mode (HTTP-01 would be blocked by the
# orange-cloud edge terminating :80). The CF_API_TOKEN secret is a single
# Cloudflare API token with `Zone.Zone:Read` + `Zone.DNS:Edit` on both the
# `fanout.run` and `labstack.com` zones — passed in via .env on the deploy
# host. `fanout-site`, `fanout-demo`, and `fanout` are resolved over the
# Compose default bridge DNS.

{
	email {$LETSENCRYPT_EMAIL}
	acme_dns cloudflare {env.CF_API_TOKEN}
}

# Wildcard cert covers any *.fanout.run subdomain. As of Caddy 2.10 the
# wildcard is reused for individual subdomain site blocks too, so adding a
# new subdomain later means just a host matcher here — no new cert.
*.fanout.run {
	@demo host demo.fanout.run
	handle @demo {
		reverse_proxy fanout-demo:7520
	}

	# Fallback for not-yet-configured subdomains.
	handle {
		abort
	}
	encode gzip zstd
}

# Wildcards don't cover the apex — separate site block.
fanout.run, www.fanout.run {
	reverse_proxy fanout-site:80
	encode gzip zstd
}

fanout.labstack.com {
	reverse_proxy fanout:7520
	encode gzip zstd
}

# OTLP/gRPC ingest on the standard port, reusing the cert Caddy manages
# for the host on :443. Caddy speaks h2c (HTTP/2 cleartext) to the gRPC
# server inside the Compose bridge.
fanout.labstack.com:4317 {
	reverse_proxy h2c://fanout:4317
}
