# Production instance settings.
# Copy to fanout/.env (gitignored) and fill in real values.
# Do NOT commit fanout/.env.

# Passwordless email-code HMAC secret. Generate with:
#   openssl rand -hex 32
AUTH_CODE_SECRET=

# Canonical external browser URL. Required for Secure cookies because Traefik
# terminates HTTPS before forwarding to Fanout.
PUBLIC_URL=https://fanout.example.com

# CIDR of the Docker/Traefik network that is allowed to supply X-Forwarded-For.
# Determine the concrete subnet with docker network inspect; do not trust all
# private networks.
TRUSTED_PROXY_CIDRS=

# Fallback namespace for OTLP payloads without a service.namespace attribute.
DEFAULT_NAMESPACE=default

# Note: INGEST_ENDPOINT (the OTLP endpoint shown in the UI hint) is set in
# docker-compose.yaml, not here — it's fixed infra config, not a per-host secret.

# Note: MCP_PUBLIC_URL (this instance's public /mcp URL — the OAuth
# issuer/audience for remote MCP clients) is likewise set in
# docker-compose.yaml, not here.

# SMTP for email-code login. Same provider as demo (Resend, port 465 implicit TLS).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Fanout <noreply@fanout.example.com>

# Agent runtime (inside the single Fanout binary).
AI_PROVIDER=anthropic
AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
