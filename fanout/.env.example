# fanout.labstack.com — own production instance.
# Copy to fanout/.env (gitignored) and fill in real values.
# Do NOT commit fanout/.env.

# Access + refresh token signing keys. Generate with:
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Default namespace shown in the UI when no x-fanout-namespace header is set.
DEFAULT_NAMESPACE=labstack

# Note: INGEST_ENDPOINT (the OTLP endpoint shown in the UI hint) is set in
# docker-compose.yaml, not here — it's fixed infra config, not a per-host secret.

# SMTP for email-code login. Same provider as demo (Resend, port 465 implicit TLS).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Fanout <noreply@fanout.labstack.com>

# AI chat / report generation. Anthropic API key + model.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
