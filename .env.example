# =============================================================================
# Fanout — environment template (committed; copy to .env and fill in)
# =============================================================================
# Effective precedence (highest first):
#   1. .env.{ENV}         per-env overrides; overwrites anything else
#   2. real OS env vars   e.g. exported in shell or injected by a container
#   3. .env               this file — shared baseline; does NOT overwrite #2
#   4. envDefault tags    in internal/env/config.go
#
# ENV selects the profile and defaults to "development". Missing .env files are
# not an error — containers inject env directly.
# =============================================================================

# Network
HTTP_ADDR=:7520
OTLP_GRPC_ADDR=127.0.0.1:4317

# Storage
DATA_DIR=./data

# AI chat (required)
AI_PROVIDER=anthropic
AI_API_KEY=replace-with-your-ai-api-key

# SMTP (required — email-code login)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=replace-with-your-smtp-password
SMTP_FROM=Fanout <noreply@example.com>

# Auth secrets (required — at least 32 chars each, and different)
JWT_SECRET=replace-with-a-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-chars

# Optional: public OTLP ingest (TLS-protected)
# OTLP_TLS_CERT_FILE=/etc/fanout/certs/server.pem
# OTLP_TLS_KEY_FILE=/etc/fanout/certs/server-key.pem
