# =============================================================================
# Fanout — environment template (committed; copy to .env and fill in)
# =============================================================================
# Effective precedence (highest first):
#   1. .env.{ENV}         per-env overrides; overwrites anything else
#   2. real OS env vars   e.g. exported in shell or injected by a container
#   3. .env               this file — shared baseline; does NOT overwrite #2
#   4. envDefault tags    in internal/env/config.go
#
# ENV selects the profile and defaults to "development". Missing .env files are
# not an error — containers inject env directly.
# =============================================================================

# Network
HTTP_ADDR=:7520
OTLP_GRPC_ADDR=127.0.0.1:4317
# Canonical public MCP URL (HTTPS, ending in /mcp) — the OAuth issuer/audience
# for /mcp; external MCP clients can only authenticate against this exact URL.
MCP_PUBLIC_URL=https://demo.fanout.test/mcp

# Storage
DATA_DIR=./data

# Agent runtime (runs inside the Fanout Go process)
AI_PROVIDER=anthropic
AI_API_KEY=replace-with-your-ai-api-key
# Optional provider model/base URL overrides.
# AI_MODEL=
# AI_BASE_URL=

# SMTP (required — email-code login)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=replace-with-your-smtp-password
SMTP_FROM=Fanout <noreply@example.com>

# Browser authentication
AUTH_MODE=local
AUTH_CODE_SECRET=replace-with-a-random-secret-at-least-32-chars
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=168h

# Set this to the canonical external HTTPS origin when a reverse proxy
# terminates TLS; Fanout uses it for Secure cookies and OIDC callbacks.
# PUBLIC_URL is mandatory when AUTH_MODE=oidc.
# PUBLIC_URL=https://fanout.example.com

# Public/demo controls are independent. Leave all false on private instances.
PUBLIC_READ=false
PUBLIC_INGEST=false
METRICS_PUBLIC=false
METRICS_TOKEN=

# Trust Forwarded/X-Forwarded-For only when Fanout is reachable exclusively
# through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# OIDC mode (instead of local SMTP login)
# OIDC_ISSUER_URL=https://identity.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_EMAIL_CLAIM=email
# OIDC_EMAIL_VERIFICATION=required
# OIDC_AUTO_PROVISION=false
# OIDC_ALLOWED_GROUPS=
# OIDC_ALLOWED_DOMAINS=
# OIDC_DEFAULT_ROLE=viewer
# OIDC_OPERATOR_GROUPS=
# OIDC_ADMIN_GROUPS=

# Optional: TLS cert/key. When set, Echo serves HTTPS on HTTP_ADDR and the
# OTLP gRPC listener accepts TLS connections (required for public OTLP ingest).
# When unset, HTTP is plaintext (reverse-proxy this in production) and OTLP
# can only run in private mode.
# TLS_CERT_FILE=/etc/fanout/certs/server.pem
# TLS_KEY_FILE=/etc/fanout/certs/server-key.pem
