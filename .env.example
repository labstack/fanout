# Generated by cmd/fanout-docgen from internal/config/config.go.
# Regenerate with just docs-generate; verify with just docs-generate-check.
# Fanout does not load dotenv files. Inject through your launcher or deployment.
# Precedence: built-in defaults < --config YAML < nonempty environment values.
# All settings require restart. Empty environment values mean no override.
# Secret entries below are empty placeholders; use runtime secret injection.
# Local authentication requires FANOUT_AUTH_CODE_SECRET (32+ characters).
# Chat is disabled unless FANOUT_AI_PROVIDER selects anthropic or openai; its key is required.

# ai.anthropic.api_key; string; secret
# Required when ai.provider is anthropic.
# Default: (empty)
ANTHROPIC_API_KEY=

# ai.anthropic.base_url; string
# Defaults to https://api.anthropic.com. Fanout appends /v1/messages, preserving any gateway path prefix. Use an HTTP(S) base URL without embedded credentials, a query, or a fragment.
# Default: (empty)
ANTHROPIC_BASE_URL=

# ai.model; string
# Overrides the provider's default: claude-sonnet-5-5 for Anthropic and gpt-6.1-sol for OpenAI. The OpenAI provider expects a reasoning model supporting reasoning.encrypted_content for stateless Responses replay. A 400 rejecting encrypted content is reported as a server-side configuration error; choose a compatible reasoning model with ai.model.
# Default: (empty)
FANOUT_AI_MODEL=

# ai.openai.api_key; string; secret
# Required when ai.provider is openai.
# Default: (empty)
OPENAI_API_KEY=

# ai.openai.base_url; string
# Defaults to https://api.openai.com/v1. Fanout appends /responses, preserving the API version and any gateway path prefix. Use an HTTP(S) base URL without embedded credentials, a query, or a fragment.
# Default: (empty)
OPENAI_BASE_URL=

# ai.provider; string
# Enables chat by selecting exactly anthropic or openai. Empty disables chat.
# Default: (empty)
FANOUT_AI_PROVIDER=

# alerts.enabled; boolean
# Runs the alert evaluation engine.
# Default: true
FANOUT_ALERTS_ENABLED=

# alerts.evaluation_interval; duration
# Schedules alert evaluation; use a Go duration of at least 1s.
# Default: 30s
FANOUT_ALERTS_EVALUATION_INTERVAL=

# alerts.history_days; integer
# Sets alert history retention in days.
# Default: 7
FANOUT_ALERTS_HISTORY_DAYS=

# auth.code_secret; string; secret
# Signs local sign-in codes; required in local mode with at least 32 characters.
# Default: (empty)
FANOUT_AUTH_CODE_SECRET=

# auth.mode; string
# Selects local sign-in or oidc; each mode validates its prerequisites.
# Default: local
FANOUT_AUTH_MODE=

# auth.oidc.admin_groups; string
# Lists identity-provider groups mapped to admin, separated by commas.
# Default: (empty)
FANOUT_OIDC_ADMIN_GROUPS=

# auth.oidc.allowed_domains; string
# Lists allowed email domains, separated by commas; wildcard * requires verified email.
# Default: (empty)
FANOUT_OIDC_ALLOWED_DOMAINS=

# auth.oidc.allowed_groups; string
# Lists allowed identity-provider groups, separated by commas.
# Default: (empty)
FANOUT_OIDC_ALLOWED_GROUPS=

# auth.oidc.auto_provision; boolean
# Creates accounts on OIDC sign-in; requires an allowed group or domain.
# Default: false
FANOUT_OIDC_AUTO_PROVISION=

# auth.oidc.client_id; string
# Identifies Fanout's client registration; required in OIDC mode.
# Default: (empty)
FANOUT_OIDC_CLIENT_ID=

# auth.oidc.client_secret; string; secret
# Authenticates Fanout's client registration; required in OIDC mode.
# Default: (empty)
FANOUT_OIDC_CLIENT_SECRET=

# auth.oidc.default_role; string
# Assigns viewer, operator, or admin to users without a group role mapping.
# Default: viewer
FANOUT_OIDC_DEFAULT_ROLE=

# auth.oidc.email_claim; string
# Names the claim containing the user's email address.
# Default: email
FANOUT_OIDC_EMAIL_CLAIM=

# auth.oidc.email_verification; string
# Selects required verified-email claims or issuer trust; issuer trust requires an allowlist.
# Default: required
FANOUT_OIDC_EMAIL_VERIFICATION=

# auth.oidc.issuer_url; string
# Selects the identity provider issuer; required in OIDC mode.
# Default: (empty)
FANOUT_OIDC_ISSUER_URL=

# auth.oidc.operator_groups; string
# Lists identity-provider groups mapped to operator, separated by commas.
# Default: (empty)
FANOUT_OIDC_OPERATOR_GROUPS=

# auth.self_signup; boolean
# Allows verified email addresses to create viewer accounts; requires local auth and SMTP.
# Default: false
FANOUT_SELF_SIGNUP=

# auth.session_absolute_ttl; duration
# Limits total session lifetime; it must be at least session_idle_ttl.
# Default: 168h
FANOUT_SESSION_ABSOLUTE_TTL=

# auth.session_idle_ttl; duration
# Expires inactive sessions; use a Go duration of at least 5m.
# Default: 12h
FANOUT_SESSION_IDLE_TTL=

# ingest.batch_size; integer
# Limits telemetry rows per batch; valid values are 1–50000.
# Default: 50000
FANOUT_INGEST_BATCH_SIZE=

# ingest.default_namespace; string
# Supplies the namespace for telemetry without one.
# Default: default
FANOUT_DEFAULT_NAMESPACE=

# ingest.max_in_flight_bytes; integer
# Caps the decoded telemetry the process will hold across concurrent requests. Concurrency is HTTP/2 streams times connections and each handler holds its batch until the commit is durable, so without a ceiling a burst is bounded only by memory. Zero is unbounded, which is the behaviour that predates this setting.
# Default: 268435456
FANOUT_INGEST_MAX_IN_FLIGHT_BYTES=

# mcp.enabled; boolean
# Serves the MCP endpoint at /mcp.
# Default: true
FANOUT_MCP_ENABLED=

# metrics.public; boolean
# Allows unauthenticated Prometheus scrapes.
# Default: false
FANOUT_METRICS_PUBLIC=

# metrics.token; string; secret
# Authorizes Prometheus scrapes with a bearer token; optional when using an admin session.
# Default: (empty)
FANOUT_METRICS_TOKEN=

# server.addr; string
# Binds the browser, API, MCP, OTLP/gRPC and OTLP/HTTP listener.
# Default: :7520
FANOUT_ADDR=

# server.pprof_enabled; boolean
# Exposes Go's net/http/pprof handlers at /debug/pprof/* for CPU/heap/mutex/goroutine profiling under load. Off by default; the routes require an admin browser session with operations:read.
# Default: false
FANOUT_PPROF_ENABLED=

# server.public_url; string
# Sets the external browser origin. Required for OIDC; HTTPS is required with MCP.
# Default: (empty)
FANOUT_PUBLIC_URL=

# server.tls.cert_file; string
# Selects the TLS certificate file; requires tls.key_file.
# Default: (empty)
FANOUT_TLS_CERT_FILE=

# server.tls.key_file; string
# Selects the TLS private key file; requires tls.cert_file.
# Default: (empty)
FANOUT_TLS_KEY_FILE=

# server.trusted_proxy_cidrs; string
# Lists trusted proxy networks, separated by commas; empty trusts no forwarded client addresses.
# Default: (empty)
FANOUT_TRUSTED_PROXY_CIDRS=

# smtp.from; string
# Sets the email sender address; required with SMTP.
# Default: (empty)
FANOUT_SMTP_FROM=

# smtp.host; string
# Selects the mail server. Host, username, password, and from must all be set to enable SMTP.
# Default: (empty)
FANOUT_SMTP_HOST=

# smtp.password; string; secret
# Authenticates to the mail server; required with SMTP.
# Default: (empty)
FANOUT_SMTP_PASSWORD=

# smtp.port; integer
# Sets the mail server's positive TCP port.
# Default: 587
FANOUT_SMTP_PORT=

# smtp.username; string
# Authenticates to the mail server; required with SMTP.
# Default: (empty)
FANOUT_SMTP_USERNAME=

# storage.data_dir; string
# Stores telemetry, query state, and the control database.
# Default: ./data
FANOUT_DATA_DIR=

# storage.duckdb.max_connections; integer
# Caps the DuckDB connection pool. Reads scan immutable Parquet concurrently; rollup-cache writes are serialized by the query write gate. Zero means "size it from the machine" — the same spelling DuckDBThreads uses for deferring to a default. Resolution happens in resolveSizing and is reported in the startup configuration log.
# Default: 0
FANOUT_DUCKDB_MAX_CONNECTIONS=

# storage.duckdb.memory; string
# Caps DuckDB's memory (e.g. "8GB"). Empty means Fanout sizes it from detected memory, reserving headroom for the Go runtime; see resolveSizing. DuckDB's own default is 80% of detected RAM, which is calculated as though DuckDB owned the machine and has been observed to get the process OOM-killed once the Go heap is added on top.
# Default: (empty)
FANOUT_DUCKDB_MEMORY=

# storage.duckdb.threads; integer
# Caps DuckDB's global query worker pool. Zero leaves DuckDB's own default in place (one worker per core). Set it to leave cores free for ingest on a query-heavy co-tenant host.
# Default: (empty)
FANOUT_DUCKDB_THREADS=

# storage.maintenance_interval; duration
# Controls Parquet retention and compaction, and query-cache checkpointing.
# Default: 1h
FANOUT_MAINTENANCE_INTERVAL=

# storage.retention_days; integer
# Sets telemetry retention in days; zero disables expiry.
# Default: 30
FANOUT_RETENTION_DAYS=

# storage.rollup_interval; duration
# Schedules analytical rollups; use a Go duration of at least 1s.
# Default: 1m
FANOUT_ROLLUP_INTERVAL=

# storage.rollup_skip_to_latest; boolean
# RollupSkipToLatest, set once at boot, advances the service and edge rollup watermarks to the current max ingested timestamp. Existing history is not aggregated into those analytical rollups. Completed-batch trace caches still rebuild all retained history in bounded passes; uncached files remain immediately queryable. Useful for large pre-seeded datasets (benchmarks, restores); off in normal operation.
# Default: false
FANOUT_ROLLUP_SKIP_TO_LATEST=
