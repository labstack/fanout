# Dependencies and their tool caches, in every workspace.
node_modules/

# Binaries
/bin/
/.cache/
*.exe

# Data
/data/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Browser assets are committed/generated because go:embed requires them when
# building directly from a source checkout. These are the workspace-local
# outputs, which are not what gets embedded.
ui/host/dist/
ui/host/tsconfig.tsbuildinfo
ui/host/playwright-report/
ui/host/test-results/

# Documentation site workspace outputs.
site/dist/
site/.astro/
site/src/assets/landing/*.webm
site/src/assets/landing/*.mp4

# Test/temp
# Root-scoped: a bare `testdata/` would also ignore Go package fixtures, which
# are source and must be committed (see internal/brand/testdata/favicon.svg).
/testdata/
*.pid
tmp/
.tmp/
coverage.out
coverage.html
cover.out

# Personal environment files and operator secret profiles remain private.
.env*
!/.env.example
/secrets/
/.sops.yaml

# Root-scoped for the same reason as testdata/: a bare `*.png` would silently
# swallow committed image assets anywhere in the tree.
/*.png

# Local agent and editor tooling indexes — machine-specific, never committed.
.claude/
.codegraph/
.serena/
.superpowers/
.playwright-mcp/
.firecrawl/

# Ad-hoc output from `go build` without -o (named after the package).
/bench
/fanout
/fanout-docgen
