# Demo (demo.fanout.run) — environment template.
# Copy to demo/.env (gitignored) and fill in the secrets at the bottom.
# yeet.sh scp's demo/ to the host; docker compose loads this file via
# env_file: on each service that needs it.

# =============================================================================
# Pinned to otel-demo v2.2.0
# https://github.com/open-telemetry/opentelemetry-demo/releases/tag/2.2.0
# =============================================================================

# Compose
COMPOSE_PROJECT_NAME=fanout-demo

# Demo App images
IMAGE_VERSION=2.2.0
IMAGE_NAME=ghcr.io/open-telemetry/demo
DEMO_VERSION=2.2.0

# Dependent images
COLLECTOR_CONTRIB_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.145.0
FLAGD_IMAGE=ghcr.io/open-feature/flagd:v0.12.9
VALKEY_IMAGE=valkey/valkey:9.0.1-alpine3.23

# Platform
ENV_PLATFORM=local
IPV6_ENABLED=false

# OpenTelemetry Collector
HOST_FILESYSTEM=/
DOCKER_SOCK=/var/run/docker.sock
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# OpenTelemetry Resource
OTEL_RESOURCE_ATTRIBUTES=service.namespace=otel-demo,service.version=2.2.0
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:8080/otlp-http/v1/traces

# Ad Service
AD_PORT=9555
AD_ADDR=ad:9555

# Cart Service
CART_PORT=7070
CART_ADDR=cart:7070

# Checkout Service
CHECKOUT_PORT=5050
CHECKOUT_ADDR=checkout:5050

# Currency Service
CURRENCY_PORT=7001
CURRENCY_ADDR=currency:7001

# Email Service
EMAIL_PORT=6060
EMAIL_ADDR=http://email:6060

# Frontend
FRONTEND_PORT=8080
FRONTEND_ADDR=frontend:8080
FRONTEND_HOST=frontend

# Frontend Proxy (Envoy)
ENVOY_ADDR=0.0.0.0
ENVOY_PORT=8080
ENVOY_ADMIN_PORT=10000
FRONTEND_PROXY_ADDR=frontend-proxy:8080

# Image Provider
IMAGE_PROVIDER_HOST=image-provider
IMAGE_PROVIDER_PORT=8081

# Load Generator
LOCUST_WEB_PORT=8089
LOCUST_USERS=5
LOCUST_HOST=http://frontend-proxy:8080
LOCUST_WEB_HOST=load-generator
LOCUST_AUTOSTART=true
LOCUST_HEADLESS=false

# Payment Service
PAYMENT_PORT=50051
PAYMENT_ADDR=payment:50051

# Product Catalog Service
PRODUCT_CATALOG_RELOAD_INTERVAL=10
PRODUCT_CATALOG_PORT=3550
PRODUCT_CATALOG_ADDR=product-catalog:3550

# Quote Service
QUOTE_PORT=8090
QUOTE_ADDR=http://quote:8090

# Recommendation Service
RECOMMENDATION_PORT=9001
RECOMMENDATION_ADDR=recommendation:9001

# Shipping Service
SHIPPING_PORT=50050
SHIPPING_ADDR=http://shipping:50050

# Flagd
FLAGD_HOST=flagd
FLAGD_PORT=8013
FLAGD_OFREP_PORT=8016

# Valkey
VALKEY_PORT=6379
VALKEY_ADDR=valkey-cart:6379

# Kafka
KAFKA_PORT=9092
KAFKA_HOST=kafka
KAFKA_ADDR=kafka:9092

# Product Reviews Service
PRODUCT_REVIEWS_PORT=3551
PRODUCT_REVIEWS_ADDR=product-reviews:3551

# LLM Service (fake)
LLM_HOST=llm
LLM_PORT=8000
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL=astronomy-llm
OPENAI_API_KEY=dummy

# Flagd UI
FLAGD_UI_PORT=4000

# PostgreSQL
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=otel
POSTGRES_PASSWORD=otel
POSTGRES_IMAGE=postgres:16.6

# =============================================================================
# Demo fanout instance secrets (replace the placeholders below)
# Required set + constraints: internal/env/config.go Validate().
# =============================================================================

AI_PROVIDER=anthropic
AI_API_KEY=replace-with-anthropic-or-openai-api-key
AI_MODEL=claude-haiku-4-5

# Each ≥ 32 chars; JWT_SECRET and JWT_REFRESH_SECRET must differ.
JWT_SECRET=replace-with-random-access-secret-32-chars-or-more
JWT_REFRESH_SECRET=replace-with-different-random-refresh-secret-32-chars-or-more

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Fanout demo <noreply@example.com>
