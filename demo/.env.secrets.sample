# Secrets for the demo instance of fanout (demo.fanout.run).
# Copy to demo/.env.secrets (gitignored) and fill in real values.
# Required set + constraints: internal/env/config.go Validate().

AI_PROVIDER=anthropic
AI_API_KEY=replace-with-anthropic-or-openai-api-key
AI_MODEL=claude-haiku-4-5

# Each ≥ 32 chars; JWT_SECRET and JWT_REFRESH_SECRET must differ.
JWT_SECRET=replace-with-random-access-secret-32-chars-or-more
JWT_REFRESH_SECRET=replace-with-different-random-refresh-secret-32-chars-or-more

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Fanout demo <noreply@example.com>
