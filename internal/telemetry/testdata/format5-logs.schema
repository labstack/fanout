message logs {
	optional binary _r_container_id (STRING);
	optional binary _r_container_image_name (STRING);
	optional binary _r_deployment_environment_name (STRING);
	optional binary _r_k8s_cluster_name (STRING);
	optional binary _r_k8s_cluster_uid (STRING);
	optional binary _r_k8s_container_name (STRING);
	optional int64 _r_k8s_container_restart_count (INT(64,true));
	optional binary _r_k8s_cronjob_name (STRING);
	optional binary _r_k8s_cronjob_uid (STRING);
	optional binary _r_k8s_daemonset_name (STRING);
	optional binary _r_k8s_daemonset_uid (STRING);
	optional binary _r_k8s_deployment_name (STRING);
	optional binary _r_k8s_deployment_uid (STRING);
	optional binary _r_k8s_job_name (STRING);
	optional binary _r_k8s_job_uid (STRING);
	optional binary _r_k8s_namespace_name (STRING);
	optional binary _r_k8s_node_name (STRING);
	optional binary _r_k8s_node_uid (STRING);
	optional binary _r_k8s_pod_hostname (STRING);
	optional binary _r_k8s_pod_ip (STRING);
	optional binary _r_k8s_pod_name (STRING);
	optional binary _r_k8s_pod_start_time (STRING);
	optional binary _r_k8s_pod_uid (STRING);
	optional binary _r_k8s_replicaset_name (STRING);
	optional binary _r_k8s_replicaset_uid (STRING);
	optional binary _r_k8s_statefulset_name (STRING);
	optional binary _r_k8s_statefulset_uid (STRING);
	optional binary _r_service_instance_id (STRING);
	optional binary _r_service_version (STRING);
	required int64 _spill (INT(64,false));
	optional group attributes (VARIANT) {
		required binary metadata;
		optional binary value;
		optional group typed_value {
			required group messaging.destination.name {
				optional binary value;
				optional binary typed_value (STRING);
			}
			required group messaging.system {
				optional binary value;
				optional binary typed_value (STRING);
			}
		}
	}
	required binary body (STRING);
	required binary body_template (STRING);
	required int64 flags (INT(64,true));
	required int64 ingested_at (TIMESTAMP(isAdjustedToUTC=true,unit=NANOS));
	required int64 ingested_unix_nano (INT(64,true));
	required int64 log_time (TIMESTAMP(isAdjustedToUTC=true,unit=NANOS));
	required binary namespace (STRING);
	required int64 observed_time (TIMESTAMP(isAdjustedToUTC=true,unit=NANOS));
	required int64 observed_time_unix_nano (INT(64,true));
	optional group resource (VARIANT) {
		required binary metadata;
		optional binary value;
		optional group typed_value {
			required group service.name {
				optional binary value;
				optional binary typed_value (STRING);
			}
			required group service.namespace {
				optional binary value;
				optional binary typed_value (STRING);
			}
		}
	}
	required binary scope_name (STRING);
	required binary scope_version (STRING);
	required binary service (STRING);
	required binary severity (STRING);
	required int64 severity_number (INT(64,true));
	required binary span_id (STRING);
	required int64 time_unix_nano (INT(64,true));
	required binary trace_id (STRING);
}
