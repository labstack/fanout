message metrics {
	optional group attributes (VARIANT) {
		required binary metadata;
		optional binary value;
		optional group typed_value {
			required group messaging.destination.name {
				optional binary value;
				optional binary typed_value (STRING);
			}
			required group messaging.system {
				optional binary value;
				optional binary typed_value (STRING);
			}
		}
	}
	required binary description (STRING);
	required binary exemplars_json (STRING);
	required binary hist_bounds_json (STRING);
	required int64 hist_count (INT(64,true));
	required binary hist_counts_json (STRING);
	required double hist_sum;
	required int64 ingested_at (TIMESTAMP(isAdjustedToUTC=true,unit=NANOS));
	required int64 ingested_unix_nano (INT(64,true));
	required int64 metric_time (TIMESTAMP(isAdjustedToUTC=true,unit=NANOS));
	required binary metric_type (STRING);
	required boolean monotonic;
	required binary name (STRING);
	required binary namespace (STRING);
	optional group resource (VARIANT) {
		required binary metadata;
		optional binary value;
		optional group typed_value {
			required group deployment.environment.name {
				optional binary value;
				optional binary typed_value (STRING);
			}
			required group service.name {
				optional binary value;
				optional binary typed_value (STRING);
			}
			required group service.namespace {
				optional binary value;
				optional binary typed_value (STRING);
			}
			required group service.version {
				optional binary value;
				optional binary typed_value (STRING);
			}
		}
	}
	required binary scope_name (STRING);
	required binary scope_version (STRING);
	required int64 series_id (INT(64,false));
	required binary service (STRING);
	required int64 start_time_unix_nano (INT(64,true));
	required binary temporality (STRING);
	required int64 time_unix_nano (INT(64,true));
	required binary unit (STRING);
	required double value;
}
