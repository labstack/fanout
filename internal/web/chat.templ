package web

import "strings"

type ChatData struct {
	HasAPIKey   bool
	NeedsAuth   bool
	Suggestions []string
}

templ Chat(data ChatData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Fanout</title>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css" integrity="sha384-VNjXcWTFgkXi1VXtuRlXBLNB44AvISAfti9WbOPCBCiNPnUpJ6dHx1Y3XmTii9pB" crossorigin="anonymous"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/dark.css" integrity="sha384-GWYIqFA394qpD/MvZTDi2pLPBjEux2y3wDvsvEa/s+DXOt1YxPYCRsisFUKlaJf/" crossorigin="anonymous"/>
			<script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace-autoloader.js" integrity="sha384-of8LXlkyMCAT14b4mQEBHRclQhowQAA+z328bANMFZBR6em9yjBEmyaeq59nXe/x" crossorigin="anonymous"></script>
			<style>
				:root {
					--bg-primary: #f5f6f8;
					--bg-secondary: #ffffff;
					--bg-tertiary: #edf0f4;
					--text-primary: #1a1d23;
					--text-secondary: #5a6270;
					--text-muted: #8b95a5;
					--border-color: #e2e6ec;
					--accent: #6366f1;
					--accent-hover: #4f46e5;
					--accent-subtle: rgba(99, 102, 241, 0.06);
					--success: #22c55e;
					--warning: #f59e0b;
					--danger: #ef4444;
					--signal-trace: #0ea5e9;
					--signal-log: #d97706;
					--signal-metric: #059669;
					--signal-error: #ef4444;
					--font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
					--font-mono: 'JetBrains Mono', 'SF Mono', Monaco, monospace;
					--radius: 0.5rem;
					--transition: 120ms cubic-bezier(0.4, 0, 0.2, 1);
				}
				.sl-theme-dark {
					--bg-primary: #0d1117;
					--bg-secondary: #161b22;
					--bg-tertiary: #21262d;
					--text-primary: #e6edf3;
					--text-secondary: #8b949e;
					--text-muted: #6e7681;
					--border-color: #30363d;
					--accent-subtle: rgba(99, 102, 241, 0.12);
				}
				* { margin: 0; padding: 0; box-sizing: border-box; }
				body {
					font-family: var(--font-sans);
					background: var(--bg-primary);
					color: var(--text-primary);
					height: 100vh;
					display: flex;
					flex-direction: column;
				}

				/* Header */
				.header {
					background: var(--bg-secondary);
					border-bottom: 1px solid var(--border-color);
					display: flex;
					align-items: center;
					padding: 0 1rem;
					height: 52px;
					flex-shrink: 0;
					gap: 0.75rem;
				}
				.header-brand {
					font-size: 1rem;
					font-weight: 700;
					color: var(--text-primary);
					text-decoration: none;
					display: flex;
					align-items: center;
					gap: 0.5rem;
				}
				.header-logo { width: 24px; height: 24px; border-radius: 5px; }
				.header-spacer { flex: 1; }

				/* Messages area */
				#messages {
					flex: 1;
					overflow-y: auto;
					padding: 1rem 0;
				}
				.messages-inner {
					max-width: 800px;
					margin: 0 auto;
					padding: 0 1rem;
				}

				/* Message bubbles */
				.msg { margin-bottom: 1.5rem; }
				.msg-user {
					display: flex;
					justify-content: flex-end;
				}
				.msg-user .msg-content {
					background: var(--accent);
					color: white;
					padding: 0.625rem 1rem;
					border-radius: var(--radius) var(--radius) 0.125rem var(--radius);
					max-width: 80%;
					font-size: 0.9rem;
					line-height: 1.5;
				}
				.msg-ai { display: flex; flex-direction: column; gap: 0.5rem; }
				.msg-ai .msg-text {
					font-size: 0.9rem;
					line-height: 1.7;
					color: var(--text-primary);
				}
				.msg-ai .msg-text p { margin-bottom: 0.5rem; }
				.msg-ai .msg-text p:last-child { margin-bottom: 0; }
				.msg-ai .msg-text code {
					background: var(--bg-tertiary);
					padding: 0.125rem 0.375rem;
					border-radius: 0.25rem;
					font-family: var(--font-mono);
					font-size: 0.85em;
				}
				.msg-ai .msg-text pre {
					background: var(--bg-tertiary);
					padding: 0.75rem;
					border-radius: var(--radius);
					overflow-x: auto;
					margin: 0.5rem 0;
				}
				.msg-ai .msg-text pre code {
					background: none;
					padding: 0;
				}
				.msg-ai .msg-text strong { font-weight: 600; }

				/* Tool status */
				.tool-status {
					display: inline-flex;
					align-items: center;
					gap: 0.375rem;
					font-size: 0.75rem;
					color: var(--text-muted);
					padding: 0.25rem 0;
				}
				.tool-status sl-spinner { font-size: 0.875rem; }

				/* Cards from render tool */
				.chat-card {
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: var(--radius);
					padding: 1rem;
					margin: 0.5rem 0;
					overflow-x: auto;
				}

				/* Support LLM-generated styles inside cards */
				.chat-card sl-card { display: block; width: 100%; }
				.chat-card sl-card::part(base) {
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
				}
				.chat-card sl-card::part(body) { padding: 0.75rem; }
				.chat-card .metric-value {
					font-size: 1.25rem;
					font-weight: 700;
					color: var(--text-primary);
					line-height: 1;
					font-feature-settings: 'tnum';
				}
				.chat-card .metric-label {
					font-size: 0.65rem;
					color: var(--text-muted);
					margin-top: 0.25rem;
					text-transform: uppercase;
					letter-spacing: 0.05em;
					font-weight: 500;
				}
				.chat-card .table {
					width: 100%;
					border-collapse: collapse;
					font-size: 0.8125rem;
				}
				.chat-card .table th, .chat-card .table td {
					padding: 0.5rem 0.75rem;
					text-align: left;
					border-bottom: 1px solid var(--border-color);
				}
				.chat-card .table th {
					font-weight: 600;
					color: var(--text-muted);
					font-size: 0.65rem;
					text-transform: uppercase;
					letter-spacing: 0.05em;
				}
				.chat-card .vega-chart { min-height: 200px; }
				.chat-card .mono {
					font-family: var(--font-mono);
					font-size: 0.8rem;
				}

				/* Bookmark button on messages */
				.msg-actions {
					display: flex;
					gap: 0.25rem;
					margin-top: 0.25rem;
					opacity: 0;
					transition: opacity var(--transition);
				}
				.msg-ai:hover .msg-actions { opacity: 1; }

				/* Thinking indicator */
				.thinking {
					display: flex;
					align-items: center;
					gap: 0.5rem;
					color: var(--text-muted);
					font-size: 0.8rem;
					padding: 0.5rem 0;
				}
				.thinking-dots {
					display: flex;
					gap: 0.25rem;
				}
				.thinking-dots span {
					width: 6px;
					height: 6px;
					background: var(--text-muted);
					border-radius: 50%;
					animation: thinking 1.4s infinite;
				}
				.thinking-dots span:nth-child(2) { animation-delay: 0.2s; }
				.thinking-dots span:nth-child(3) { animation-delay: 0.4s; }
				@keyframes thinking {
					0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
					40% { opacity: 1; transform: scale(1); }
				}

				/* Cold start panel */
				.cold-start {
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					min-height: 60vh;
					text-align: center;
					gap: 2rem;
				}
				.cold-start-title {
					font-size: 1.5rem;
					font-weight: 700;
					letter-spacing: -0.025em;
				}
				.cold-start-subtitle {
					color: var(--text-secondary);
					font-size: 0.9rem;
				}
				.suggestions {
					display: flex;
					flex-wrap: wrap;
					gap: 0.5rem;
					justify-content: center;
					max-width: 600px;
				}
				.suggestion-chip {
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: 2rem;
					padding: 0.5rem 1rem;
					font-size: 0.85rem;
					color: var(--text-secondary);
					cursor: pointer;
					transition: all var(--transition);
					font-family: var(--font-sans);
				}
				.suggestion-chip:hover {
					border-color: var(--accent);
					color: var(--accent);
					background: var(--accent-subtle);
				}

				/* Input area */
				.input-area {
					background: var(--bg-secondary);
					border-top: 1px solid var(--border-color);
					padding: 0.75rem 1rem;
					flex-shrink: 0;
				}
				.input-inner {
					max-width: 800px;
					margin: 0 auto;
					display: flex;
					gap: 0.5rem;
					align-items: flex-end;
				}
				.input-inner textarea {
					flex: 1;
					resize: none;
					border: 1px solid var(--border-color);
					border-radius: var(--radius);
					padding: 0.625rem 0.75rem;
					font-family: var(--font-sans);
					font-size: 0.9rem;
					line-height: 1.5;
					background: var(--bg-primary);
					color: var(--text-primary);
					outline: none;
					min-height: 42px;
					max-height: 200px;
					transition: border-color var(--transition);
				}
				.input-inner textarea:focus {
					border-color: var(--accent);
				}
				.input-inner textarea::placeholder {
					color: var(--text-muted);
				}
				#send-btn {
					width: 42px;
					height: 42px;
					border-radius: var(--radius);
					background: var(--accent);
					color: white;
					border: none;
					cursor: pointer;
					display: flex;
					align-items: center;
					justify-content: center;
					flex-shrink: 0;
					transition: background var(--transition);
				}
				#send-btn:hover { background: var(--accent-hover); }
				#send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
				#send-btn svg { width: 20px; height: 20px; }

				/* Setup message */
				.setup-msg {
					max-width: 500px;
					text-align: center;
					padding: 2rem;
				}
				.setup-msg h2 {
					margin-bottom: 1rem;
					font-size: 1.25rem;
				}
				.setup-msg code {
					background: var(--bg-tertiary);
					padding: 0.5rem 0.75rem;
					border-radius: var(--radius);
					display: block;
					margin: 1rem 0;
					font-family: var(--font-mono);
					font-size: 0.85rem;
				}
			</style>
		</head>
		<body class="sl-theme-light">
			<header class="header">
				<a href="/" class="header-brand">
					<img src="/favicon.svg" class="header-logo" alt="Fanout"/>
					Fanout
				</a>
				<div class="header-spacer"></div>
				<sl-icon-button name="bookmark" id="bookmarks-btn" label="Bookmarks"></sl-icon-button>
				<sl-icon-button name="moon" id="theme-toggle" label="Toggle theme"></sl-icon-button>
			</header>
			<div id="messages">
				<div class="messages-inner">
					if data.HasAPIKey {
						<div class="cold-start" id="cold-start">
							<div>
								<div class="cold-start-title">Ask anything about your system</div>
								<div class="cold-start-subtitle">I can analyze traces, logs, metrics, and service health</div>
							</div>
							if len(data.Suggestions) > 0 {
								<div class="suggestions">
									for _, s := range data.Suggestions {
										<button class="suggestion-chip" onclick={ templ.ComponentScript{Call: "sendMessage('" + escapeJS(s) + "')"} }>{ s }</button>
									}
								</div>
							}
						</div>
					} else {
						<div class="cold-start">
							<div class="setup-msg">
								<h2>AI Chat Setup</h2>
								<p style="color: var(--text-secondary); margin-bottom: 1rem;">Set your LLM API key to enable the chat interface. Ingest and health endpoints are still active.</p>
								<code>AI_API_KEY=your-api-key ./fanout</code>
								<p style="color: var(--text-muted); font-size: 0.8rem;">Supports Anthropic (default) and OpenAI-compatible providers via AI_PROVIDER.</p>
							</div>
						</div>
					}
				</div>
			</div>
			<div class="input-area">
				<div class="input-inner">
					<textarea
						id="chat-input"
						placeholder="Ask about your system..."
						rows="1"
						disabled?={ !data.HasAPIKey }
					></textarea>
					<button id="send-btn" disabled?={ !data.HasAPIKey }>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="22" y1="2" x2="11" y2="13"></line>
							<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
						</svg>
					</button>
				</div>
			</div>
			<!-- Bookmarks drawer -->
			<sl-drawer id="bookmarks-drawer" label="Bookmarks" placement="end">
				<div id="bookmarks-list"></div>
				<sl-button slot="footer" variant="primary" onclick="document.getElementById('bookmarks-drawer').hide()">Close</sl-button>
			</sl-drawer>
			<!-- Auth config -->
			<script id="cfg" type="application/json">
				if data.NeedsAuth {
					{ "{\"needsAuth\":true}" }
				} else {
					{ "{\"needsAuth\":false}" }
				}
			</script>
			<script>
				(function() {
					// Theme
					const body = document.body;
					const toggle = document.getElementById('theme-toggle');
					const saved = localStorage.getItem('theme');
					if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
						body.classList.replace('sl-theme-light', 'sl-theme-dark');
						toggle.name = 'sun';
					}
					toggle.addEventListener('click', () => {
						const isDark = body.classList.contains('sl-theme-dark');
						body.classList.replace(isDark ? 'sl-theme-dark' : 'sl-theme-light', isDark ? 'sl-theme-light' : 'sl-theme-dark');
						toggle.name = isDark ? 'moon' : 'sun';
						localStorage.setItem('theme', isDark ? 'light' : 'dark');
					});

					// Config — token stored in localStorage, never embedded in HTML
					const cfg = (function() {
						try { return JSON.parse(document.getElementById('cfg').textContent); }
						catch(e) { return { needsAuth: false }; }
					})();

					function getApiToken() {
						if (!cfg.needsAuth) return '';
						return localStorage.getItem('fanout_token') || '';
					}

					function authHeaders() {
						const token = getApiToken();
						if (!token) return {};
						return { 'Authorization': 'Bearer ' + token };
					}

					// WebSocket
					const messagesEl = document.getElementById('messages');
					const messagesInner = messagesEl.querySelector('.messages-inner');
					const input = document.getElementById('chat-input');
					const sendBtn = document.getElementById('send-btn');
					let ws = null;
					let currentAiMsg = null;
					let currentTextEl = null;
					let textBuffer = '';
					let rafPending = false;
					let reconnectDelay = 1000;
					const maxReconnectDelay = 30000;

					function connect() {
						const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
						let url = proto + '//' + location.host + '/ws/chat';
						const token = getApiToken();
						if (token) url += '?token=' + encodeURIComponent(token);
						ws = new WebSocket(url);
						ws.onopen = () => {
							reconnectDelay = 1000;
							updateConnectionStatus(true);
						};
						ws.onmessage = handleEvent;
						ws.onclose = (e) => {
							updateConnectionStatus(false);
							// Auth failure — prompt for token
							if (e.code === 1008 || e.code === 4401) {
								promptForToken();
								return;
							}
							setTimeout(connect, reconnectDelay);
							reconnectDelay = Math.min(reconnectDelay * 2, maxReconnectDelay);
						};
						ws.onerror = () => { ws.close(); };
					}

					function updateConnectionStatus(connected) {
						let indicator = document.getElementById('ws-status');
						if (!indicator) {
							indicator = document.createElement('div');
							indicator.id = 'ws-status';
							indicator.style.cssText = 'position:fixed;bottom:60px;right:1rem;font-size:0.7rem;color:var(--text-muted);display:flex;align-items:center;gap:0.25rem;';
							document.body.appendChild(indicator);
						}
						if (connected) {
							indicator.style.display = 'none';
						} else {
							indicator.style.display = 'flex';
							indicator.innerHTML = '<span style="width:6px;height:6px;background:var(--warning);border-radius:50%;"></span> Reconnecting...';
						}
					}

					function promptForToken() {
						const token = prompt('Enter API token:');
						if (token) {
							localStorage.setItem('fanout_token', token);
							connect();
						}
					}

					function handleEvent(e) {
						let data;
						try {
							data = JSON.parse(e.data);
						} catch(err) {
							console.error('failed to parse WS message:', err);
							return;
						}
						switch (data.type) {
							case 'token':
								if (!currentAiMsg) startAiMessage();
								textBuffer += data.content;
								if (!rafPending) {
									rafPending = true;
									requestAnimationFrame(flushText);
								}
								break;
							case 'tool_call':
								if (!currentAiMsg) startAiMessage();
								addToolStatus(data.name, true);
								break;
							case 'tool_result':
								updateToolStatus(data.name);
								break;
							case 'card':
								if (!currentAiMsg) startAiMessage();
								addCard(data.html);
								break;
							case 'error':
								addError(data.error);
								enableInput();
								break;
							case 'done':
								flushText();
								finishAiMessage();
								enableInput();
								break;
						}
					}

					function startAiMessage() {
						// Remove cold start if present
						const coldStart = document.getElementById('cold-start');
						if (coldStart) coldStart.remove();

						currentAiMsg = document.createElement('div');
						currentAiMsg.className = 'msg msg-ai';
						currentTextEl = document.createElement('div');
						currentTextEl.className = 'msg-text';
						currentAiMsg.appendChild(currentTextEl);
						messagesInner.appendChild(currentAiMsg);
						textBuffer = '';
					}

					function flushText() {
						rafPending = false;
						if (currentTextEl && textBuffer) {
							currentTextEl.innerHTML = renderMarkdown(textBuffer);
							scrollToBottom();
						}
					}

					function addToolStatus(name, loading) {
						const el = document.createElement('div');
						el.className = 'tool-status';
						el.dataset.tool = name;
						if (loading) {
							el.innerHTML = '<sl-spinner></sl-spinner> Querying ' + escapeHtml(name) + '...';
						} else {
							el.innerHTML = '<sl-icon name="check2-circle" style="color:var(--success)"></sl-icon> ' + escapeHtml(name);
						}
						if (currentAiMsg) {
							currentAiMsg.appendChild(el);
							scrollToBottom();
						}
					}

					function updateToolStatus(name) {
						if (!currentAiMsg) return;
						const el = currentAiMsg.querySelector('.tool-status[data-tool="' + name + '"]');
						if (el) {
							el.innerHTML = '<sl-icon name="check2-circle" style="color:var(--success)"></sl-icon> ' + escapeHtml(name);
						}
					}

					function addCard(html) {
						const card = document.createElement('div');
						card.className = 'chat-card';
						card.innerHTML = html;
						if (currentAiMsg) {
							currentAiMsg.appendChild(card);
							initVegaCharts(card);
							scrollToBottom();
						}
					}

					function addError(msg) {
						const el = document.createElement('div');
						el.className = 'msg msg-ai';
						el.innerHTML = '<div style="color:var(--danger);font-size:0.85rem"><sl-icon name="exclamation-triangle"></sl-icon> ' + escapeHtml(msg) + '</div>';
						messagesInner.appendChild(el);
						scrollToBottom();
					}

					function finishAiMessage() {
						if (currentAiMsg) {
							// Capture reference before nulling
							const msgEl = currentAiMsg;
							const actions = document.createElement('div');
							actions.className = 'msg-actions';
							actions.innerHTML = '<sl-icon-button name="bookmark" label="Save" style="font-size:0.875rem"></sl-icon-button>';
							actions.querySelector('sl-icon-button').addEventListener('click', () => {
								const html = msgEl.innerHTML;
								const question = getLastUserMessage();
								saveBookmark(question, html);
							});
							msgEl.appendChild(actions);
						}
						currentAiMsg = null;
						currentTextEl = null;
						textBuffer = '';
					}

					function getLastUserMessage() {
						const msgs = messagesInner.querySelectorAll('.msg-user .msg-content');
						return msgs.length > 0 ? msgs[msgs.length - 1].textContent : '';
					}

					function showToast(message, variant) {
						const toast = Object.assign(document.createElement('sl-alert'), {
							variant: variant || 'primary', closable: true, duration: 3000,
							innerHTML: '<sl-icon name="' + (variant === 'danger' ? 'exclamation-triangle' : 'check2-circle') + '" slot="icon"></sl-icon> ' + escapeHtml(message)
						});
						document.body.appendChild(toast);
						toast.toast();
					}

					// Send message
					window.sendMessage = function(text) {
						if (!text || !ws || ws.readyState !== 1) return;

						// Remove cold start
						const coldStart = document.getElementById('cold-start');
						if (coldStart) coldStart.remove();

						// Add user message
						const userMsg = document.createElement('div');
						userMsg.className = 'msg msg-user';
						userMsg.innerHTML = '<div class="msg-content">' + escapeHtml(text) + '</div>';
						messagesInner.appendChild(userMsg);
						scrollToBottom();

						// Send to server
						ws.send(JSON.stringify({
							type: 'message',
							content: text,
							window: 60,
							namespace: ''
						}));

						input.value = '';
						input.style.height = 'auto';
						disableInput();
					};

					function disableInput() {
						sendBtn.disabled = true;
					}

					function enableInput() {
						sendBtn.disabled = false;
						input.focus();
					}

					// Input handlers
					input.addEventListener('keydown', (e) => {
						if (e.key === 'Enter' && !e.shiftKey) {
							e.preventDefault();
							sendMessage(input.value.trim());
						}
						if (e.key === 'Escape') {
							if (ws && ws.readyState === 1) {
								ws.send(JSON.stringify({ type: 'cancel' }));
							}
						}
					});

					// Auto-resize textarea
					input.addEventListener('input', () => {
						input.style.height = 'auto';
						input.style.height = Math.min(input.scrollHeight, 200) + 'px';
					});

					sendBtn.addEventListener('click', () => {
						sendMessage(input.value.trim());
					});

					// Cmd+K to clear
					document.addEventListener('keydown', (e) => {
						if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
							e.preventDefault();
							messagesInner.innerHTML = '';
						}
					});

					// Scroll
					function scrollToBottom() {
						messagesEl.scrollTop = messagesEl.scrollHeight;
					}

					// Markdown renderer (lightweight, XSS-safe)
					function renderMarkdown(text) {
						// Extract code blocks first to protect from escaping
						const codeBlocks = [];
						text = text.replace(/```(\w*)\n([\s\S]*?)```/g, function(_, lang, code) {
							codeBlocks.push('<pre><code>' + escapeHtml(code) + '</code></pre>');
							return '\x00CB' + (codeBlocks.length - 1) + '\x00';
						});
						// Extract inline code
						const inlineCode = [];
						text = text.replace(/`([^`]+)`/g, function(_, code) {
							inlineCode.push('<code>' + escapeHtml(code) + '</code>');
							return '\x00IC' + (inlineCode.length - 1) + '\x00';
						});
						// HTML-escape remaining text to prevent XSS
						text = escapeHtml(text);
						// Bold
						text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
						// Italic
						text = text.replace(/\*(.+?)\*/g, '<em>$1</em>');
						// Line breaks to paragraphs
						const lines = text.split('\n\n');
						if (lines.length > 1) {
							text = lines.map(function(l) { return '<p>' + l.replace(/\n/g, '<br>') + '</p>'; }).join('');
						} else {
							text = text.replace(/\n/g, '<br>');
						}
						// Restore code blocks and inline code
						text = text.replace(/\x00CB(\d+)\x00/g, function(_, i) { return codeBlocks[i]; });
						text = text.replace(/\x00IC(\d+)\x00/g, function(_, i) { return inlineCode[i]; });
						return text;
					}

					function escapeHtml(s) {
						const d = document.createElement('div');
						d.textContent = s;
						return d.innerHTML;
					}

					// Vega-Lite chart initializer
					let vegaLoadPromise = null;
					function loadVega() {
						if (vegaLoadPromise) return vegaLoadPromise;
						if (window.vegaEmbed) return Promise.resolve();
						vegaLoadPromise = new Promise(async (resolve, reject) => {
							try {
								await loadScript('https://cdn.jsdelivr.net/npm/vega@6.2.0', 'sha384-0Wc8+KeboSkAq/fK81pd4uFbWKu4ouB+y4KWCYxlC69hRWol7vnc6zZSruXOtc0F');
								await loadScript('https://cdn.jsdelivr.net/npm/vega-lite@6.4.1', 'sha384-QtG7pnWvq1Tk0Rcvl53B1TEVw7U1PUqfciCz3XMUqSmi1fNpJwiv5ml+m5NeOOzH');
								await loadScript('https://cdn.jsdelivr.net/npm/vega-embed@7.1.0', 'sha384-giTAWqsEDsWuWzWKi6NCvjgwi160SClnTYYXWPLuy/DnaQTqmk4soinrpxcCS4dx');
								resolve();
							} catch(e) { reject(e); }
						});
						return vegaLoadPromise;
					}
					function loadScript(src, integrity) {
						return new Promise((resolve, reject) => {
							const existing = document.querySelector('script[src="' + src + '"]');
							if (existing) { if (existing._loaded) resolve(); else existing.addEventListener('load', resolve); return; }
							const s = document.createElement('script');
							s.src = src;
							if (integrity) { s.integrity = integrity; s.crossOrigin = 'anonymous'; }
							s.onload = () => { s._loaded = true; resolve(); };
							s.onerror = reject;
							document.head.appendChild(s);
						});
					}
					function initVegaCharts(container) {
						const els = container.querySelectorAll('.vega-chart');
						if (els.length === 0) return;
						loadVega().then(() => {
							els.forEach(el => {
								if (el._vegaInit) return;
								el._vegaInit = true;
								try {
									const spec = JSON.parse(el.dataset.spec || el.getAttribute('data-spec'));
									vegaEmbed(el, spec, { actions: false, theme: body.classList.contains('sl-theme-dark') ? 'dark' : undefined });
								} catch(e) {
									console.error('Vega error:', e);
									el.textContent = 'Chart failed to load';
									el.style.cssText = 'display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:0.8rem;min-height:100px;';
								}
							});
						}).catch((e) => { console.error('Failed to load Vega libraries:', e); });
					}

					// MutationObserver for auto-upgrading Vega charts in dynamically added content
					const observer = new MutationObserver((mutations) => {
						for (const mutation of mutations) {
							for (const node of mutation.addedNodes) {
								if (node.nodeType === 1) {
									initVegaCharts(node);
								}
							}
						}
					});
					observer.observe(messagesInner, { childList: true, subtree: true });

					// Bookmarks
					document.getElementById('bookmarks-btn').addEventListener('click', () => {
						loadBookmarks();
						document.getElementById('bookmarks-drawer').show();
					});

					function loadBookmarks() {
						fetch('/api/bookmarks', { headers: authHeaders() })
							.then(r => r.json())
							.then(bookmarks => {
								const list = document.getElementById('bookmarks-list');
								if (!bookmarks || bookmarks.length === 0) {
									list.innerHTML = '<div style="color:var(--text-muted);text-align:center;padding:2rem">No bookmarks yet</div>';
									return;
								}
								list.innerHTML = bookmarks.map(b =>
									'<div style="padding:0.75rem;border-bottom:1px solid var(--border-color)">' +
									'<div style="font-weight:500;font-size:0.875rem;margin-bottom:0.25rem">' + escapeHtml(b.question) + '</div>' +
									'<div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.5rem">' +
									'<sl-button size="small" onclick="loadBookmark(\'' + b.id + '\')">View</sl-button>' +
									'<sl-button size="small" variant="danger" outline onclick="deleteBookmark(\'' + b.id + '\')">Delete</sl-button>' +
									'</div></div>'
								).join('');
							})
							.catch((e) => {
								console.error('Failed to load bookmarks:', e);
								showToast('Failed to load bookmarks', 'danger');
							});
					}

					window.saveBookmark = function(question, html) {
						fetch('/api/bookmarks', {
							method: 'POST',
							headers: Object.assign({ 'Content-Type': 'application/json' }, authHeaders()),
							body: JSON.stringify({ question: question, answer_html: html })
						}).then(r => {
							if (!r.ok) throw new Error('save failed');
							showToast('Bookmark saved', 'success');
						}).catch((e) => {
							console.error('Failed to save bookmark:', e);
							showToast('Failed to save bookmark', 'danger');
						});
					};

					window.deleteBookmark = function(id) {
						fetch('/api/bookmarks/' + id, { method: 'DELETE', headers: authHeaders() })
							.then(r => {
								if (!r.ok) throw new Error('delete failed');
								loadBookmarks();
							})
							.catch((e) => {
								console.error('Failed to delete bookmark:', e);
								showToast('Failed to delete bookmark', 'danger');
							});
					};

					window.loadBookmark = function(id) {
						// For now just close drawer - could restore answer
						document.getElementById('bookmarks-drawer').hide();
					};

					// Connect WebSocket
					if (document.querySelector('[id="chat-input"]:not([disabled])')) {
						if (cfg.needsAuth && !getApiToken()) {
							promptForToken();
						} else {
							connect();
						}
					}
				})();
			</script>
		</body>
	</html>
}

func escapeJS(s string) string {
	s = strings.ReplaceAll(s, "\\", "\\\\")
	s = strings.ReplaceAll(s, "'", "\\'")
	s = strings.ReplaceAll(s, "\n", "\\n")
	s = strings.ReplaceAll(s, "\r", "\\r")
	s = strings.ReplaceAll(s, "</", "<\\/")
	return s
}

