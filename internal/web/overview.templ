package web

import "fmt"

// OverviewData contains all data for the overview page
type OverviewData struct {
	Healthy          bool
	Summary          string
	Services         ServiceSummary
	TopIssues        []TopIssue
	ThroughputPerMin int64
	P95Ms            float64
	ErrorRate        float64
	Topology         TopologyData
	Timeline         TimelineData
	Window           int
}

type ServiceSummary struct {
	Total     int
	Healthy   int
	Degraded  int
	Unhealthy int
}

type TopIssue struct {
	Service string
	Issue   string
	Value   float64
	Detail  string
}

type TopologyData struct {
	Nodes  []ServiceNode
	Edges  []ServiceEdge
	Window int
}

type ServiceNode struct {
	Name      string
	Status    string
	SpanCount int64
	P95Ms     float64
	ErrorRate float64
}

type ServiceEdge struct {
	From      string
	To        string
	CallCount int64
	AvgMs     float64
	ErrorRate float64
	Status    string
}

type TimelineData struct {
	Buckets   []TimelineBucket
	Anomalies []Anomaly
	AvgP95Ms  float64
}

type TimelineBucket struct {
	Time         string
	RequestCount int64
	ErrorCount   int64
	P95Ms        float64
	ErrorRate    float64
	IsAnomaly    bool
}

type Anomaly struct {
	Time        string
	Type        string
	Description string
}

// Overview renders the main overview page
templ Overview(data OverviewData) {
	@Layout("Overview", "overview", data.Window) {
		<div
			id="overview-content"
			class="loading-overlay"
			hx-get={ "/partials/overview?window=" + fmt.Sprintf("%d", data.Window) }
			hx-trigger="every 30s"
			hx-swap="innerHTML"
			hx-indicator="#overview-spinner"
		>
			@OverviewContent(data)
		</div>
	}
}

func statusVariant(status string) string {
	switch status {
	case "healthy":
		return "success"
	case "degraded":
		return "warning"
	case "unhealthy":
		return "danger"
	default:
		return "warning"
	}
}

templ timelineChart(data TimelineData) {
	if len(data.Buckets) == 0 {
		<p style="color: var(--text-muted); text-align: center; padding: 2rem;">No data available</p>
	} else {
		<div class="chart" data-vega={ timelineSpec(data) }></div>
	}
}

func timelineSpec(data TimelineData) string {
	values := make([]map[string]any, len(data.Buckets))
	for i, b := range data.Buckets {
		values[i] = map[string]any{
			"time":     b.Time,
			"requests": b.RequestCount,
			"p95":      b.P95Ms,
			"anomaly":  b.IsAnomaly,
		}
	}

	spec := map[string]any{
		"$schema": "https://vega.github.io/schema/vega-lite/v6.json",
		"width":   "container",
		"height":  250,
		"data":    map[string]any{"values": values},
		"layer": []map[string]any{
			{
				"mark": map[string]any{"type": "area", "opacity": 0.3, "line": true},
				"encoding": map[string]any{
					"x": map[string]any{
						"field":    "time",
						"type":     "temporal",
						"timeUnit": "yearmonthdatehoursminutes",
						"axis":     map[string]any{"title": nil, "format": "%H:%M", "labelAngle": 0, "tickCount": 8},
					},
					"y": map[string]any{"field": "requests", "type": "quantitative", "axis": map[string]any{"title": "Requests"}},
				},
			},
			{
				"mark": map[string]any{"type": "line", "point": false, "strokeWidth": 2},
				"encoding": map[string]any{
					"x":     map[string]any{"field": "time", "type": "temporal", "timeUnit": "yearmonthdatehoursminutes"},
					"y":     map[string]any{"field": "requests", "type": "quantitative"},
					"color": map[string]any{"condition": map[string]any{"test": "datum.anomaly", "value": "#ef4444"}, "value": "#0ea5e9"},
				},
			},
		},
	}

	return mustJSON(spec, "{}")
}

templ alertBanner(anomalies []Anomaly) {
	<sl-alert variant="warning" open closable class="anomaly-alert" id="anomaly-banner" data-count={ fmt.Sprintf("%d", len(anomalies)) }>
		<sl-icon slot="icon" name="exclamation-triangle"></sl-icon>
		<strong>{ fmt.Sprintf("%d anomal", len(anomalies)) }{ anomalyPlural(len(anomalies)) } detected</strong>
		<span style="margin-left: 0.5rem; opacity: 0.9;">
			for i, a := range anomalies {
				if i > 0 {
					<span>| </span>
				}
				if i < 3 {
					<span>{ anomalyIcon(a.Type) } { a.Description }</span>
				}
			}
			if len(anomalies) > 3 {
				<span>and { fmt.Sprintf("%d", len(anomalies)-3) } more...</span>
			}
		</span>
	</sl-alert>
	<script>
		(function() {
			const banner = document.getElementById('anomaly-banner');
			if (!banner) return;

			const count = banner.dataset.count;
			const key = 'anomaly-dismissed-' + count;
			const dismissed = localStorage.getItem(key);

			// Auto-hide if dismissed within last hour
			if (dismissed) {
				const dismissedAt = parseInt(dismissed, 10);
				if (Date.now() - dismissedAt < 3600000) {
					banner.open = false;
				} else {
					localStorage.removeItem(key);
				}
			}

			banner.addEventListener('sl-after-hide', () => {
				localStorage.setItem(key, Date.now().toString());
			});
		})();
	</script>
}

func anomalyIcon(atype string) string {
	switch atype {
	case "latency_spike":
		return "Latency:"
	case "error_spike":
		return "Errors:"
	case "traffic_drop":
		return "Traffic:"
	default:
		return ""
	}
}

func anomalyPlural(n int) string {
	if n == 1 {
		return "y"
	}
	return "ies"
}
