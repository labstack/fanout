package web

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
)

// MetricsData for the metrics explorer page
type MetricsData struct {
	Names    []string
	Selected string
	Service  string
	Window   int
	Metrics  []MetricRow
	Limit    int
	Offset   int
	HasMore  bool
}

type MetricRow struct {
	Time    string
	Name    string
	Service string
	Type    string
	Value   float64
}

// Metrics renders the metrics explorer page
templ Metrics(data MetricsData) {
	@Layout("Metrics", "metrics", data.Window) {
		<div class="page-header">
			<h1 class="page-title">Metrics Explorer</h1>
			<p class="page-subtitle">Browse raw metrics data</p>
		</div>
		<!-- Search Form -->
		<div class="card" style="margin-bottom: 1.5rem;">
			<form method="GET" action="/metrics" class="search-form">
				<div class="form-row">
					<sl-select name="name" label="Metric Name" value={ data.Selected }>
						<sl-option value="">All metrics</sl-option>
						for _, n := range data.Names {
							<sl-option value={ n }>{ n }</sl-option>
						}
					</sl-select>
					<sl-input name="service" label="Service" placeholder="All services" value={ data.Service }></sl-input>
					<sl-select name="window" label="Time Window" value={ fmt.Sprintf("%d", data.Window) }>
						<sl-option value="15">Last 15 min</sl-option>
						<sl-option value="30">Last 30 min</sl-option>
						<sl-option value="60">Last 1 hour</sl-option>
						<sl-option value="180">Last 3 hours</sl-option>
						<sl-option value="360">Last 6 hours</sl-option>
						<sl-option value="1440">Last 24 hours</sl-option>
					</sl-select>
					<sl-button type="submit" variant="primary">Search</sl-button>
				</div>
			</form>
		</div>
		<!-- Results -->
		<div class="card">
			<div class="card-title">Results ({ fmt.Sprintf("%d", len(data.Metrics)) } metrics)</div>
			if len(data.Metrics) == 0 {
				<p style="color: var(--text-muted); text-align: center; padding: 2rem;">No metrics found</p>
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Time</th>
							<th>Name</th>
							<th>Service</th>
							<th>Type</th>
							<th>Value</th>
						</tr>
					</thead>
						<tbody>
							for _, m := range data.Metrics {
								<tr>
									<td style="font-family: monospace; font-size: 0.8rem;">{ m.Time }</td>
									<td>{ m.Name }</td>
									<td>
									if m.Service != "" {
										<a href={ templ.SafeURL(withWindow("/services/"+pathEscape(m.Service), data.Window)) }>{ m.Service }</a>
									} else {
										<span style="color: var(--text-muted);">—</span>
									}
								</td>
									<td><sl-badge variant={ metricTypeVariant(m.Type) }>{ m.Type }</sl-badge></td>
									<td style="font-family: monospace;">{ fmt.Sprintf("%.2f", m.Value) }</td>
								</tr>
						}
					</tbody>
				</table>
				<!-- Pagination -->
				if data.Offset > 0 || data.HasMore {
					<div class="pagination">
						if data.Offset > 0 {
							<sl-button href={ metricsPaginationURL(data.Selected, data.Service, data.Window, data.Limit, data.Offset-data.Limit) } variant="default" size="small">Previous</sl-button>
						}
						<span class="pagination-info">Showing { fmt.Sprintf("%d", data.Offset+1) }-{ fmt.Sprintf("%d", data.Offset+len(data.Metrics)) }</span>
						if data.HasMore {
							<sl-button href={ metricsPaginationURL(data.Selected, data.Service, data.Window, data.Limit, data.Offset+data.Limit) } variant="default" size="small">Next</sl-button>
						}
					</div>
				}
			}
		</div>
		<style>
			.search-form .form-row {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				align-items: flex-end;
			}
			.search-form sl-input, .search-form sl-select {
				flex: 1;
				min-width: 150px;
			}
			.pagination {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				padding: 1rem;
				border-top: 1px solid var(--border-color);
				margin-top: 1rem;
			}
			.pagination-info {
				color: var(--text-muted);
				font-size: 0.875rem;
			}
		</style>
	}
}

func metricTypeVariant(mtype string) string {
	switch strings.ToLower(mtype) {
	case "gauge":
		return "primary"
	case "sum", "sum_delta":
		return "success"
	case "histogram":
		return "warning"
	default:
		return "neutral"
	}
}

func metricsPaginationURL(name, service string, window, limit, offset int) string {
	values := url.Values{}
	if name != "" {
		values.Set("name", name)
	}
	if service != "" {
		values.Set("service", service)
	}
	if window != 60 {
		values.Set("window", strconv.Itoa(window))
	}
	values.Set("limit", strconv.Itoa(limit))
	values.Set("offset", strconv.Itoa(offset))
	return "/metrics?" + values.Encode()
}
