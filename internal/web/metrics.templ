package web

import (
	"fmt"
	"strings"
)

// MetricsData for the metrics explorer page
type MetricsData struct {
	Query   string
	Window  int
	Metrics []MetricSummary
}

// MetricSummary represents an aggregated metric
type MetricSummary struct {
	Name     string
	Type     string   // gauge, sum, histogram
	Services []string // services emitting this metric
	Count    int64
	Avg      float64
	Min      float64
	Max      float64
	Latest   float64
	Trend    []float64 // bucketed values for sparkline
}

// Metrics renders the metrics explorer page
templ Metrics(data MetricsData) {
	@Layout("Metrics", "metrics", data.Window) {
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Metrics Explorer</h1>
				<p class="page-subtitle">Explore aggregated metrics</p>
			</div>
		</div>
		<!-- Search Form -->
		<sl-card style="margin-bottom: 1rem;">
			<form method="GET" action="/metrics" class="search-form">
				<div class="form-row">
					<sl-input name="q" label="Search" placeholder="name:http.* service:cart type:gauge" value={ data.Query } style="flex: 3;"></sl-input>
					if data.Window != 60 {
						<input type="hidden" name="window" value={ fmt.Sprintf("%d", data.Window) }/>
					}
					<sl-button type="submit" variant="primary">Search</sl-button>
				</div>
				<div class="search-hint">
					<sl-icon name="lightbulb"></sl-icon>
					<code>name:pattern</code> <code>service:name</code> <code>namespace:default</code> <code>type:gauge,sum</code>
				</div>
			</form>
		</sl-card>
		<!-- Results -->
		<sl-card>
			<div slot="header" class="card-header">Results ({ fmt.Sprintf("%d", len(data.Metrics)) } metrics)</div>
			if len(data.Metrics) == 0 {
				<div class="empty-state">
					<sl-icon name="bar-chart-2"></sl-icon>
					<div class="empty-state-title">No metrics found</div>
					<div class="empty-state-message">Try adjusting your search filters or check if metrics are being collected.</div>
				</div>
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Type</th>
							<th>Count</th>
							<th>Avg</th>
							<th>Min</th>
							<th>Max</th>
							<th>Trend</th>
						</tr>
					</thead>
					<tbody>
						for _, m := range data.Metrics {
							<tr>
								<td>
									<div class="metric-cell">
										<span class="metric-name"><span class="metric-prefix">{ metricPrefix(m.Name) }</span>{ metricLeaf(m.Name) }</span>
										if len(m.Services) > 0 {
											<span class="metric-services">
												for i, svc := range m.Services {
													if i < 3 {
														<a href={ templ.SafeURL(withWindow("/services/"+pathEscape(svc), data.Window)) } class="metric-svc-link">
															<sl-tag size="small" variant="primary">{ svc }</sl-tag>
														</a>
													}
												}
												if len(m.Services) > 3 {
													<sl-tag size="small" variant="primary">+{ fmt.Sprintf("%d", len(m.Services)-3) }</sl-tag>
												}
											</span>
										}
									</div>
								</td>
								<td><sl-badge variant={ metricTypeVariant(m.Type) }>{ m.Type }</sl-badge></td>
								<td class="mono">{ formatCount(m.Count) }</td>
								<td class="mono">{ formatValue(m.Avg) }</td>
								<td class="mono">{ formatValue(m.Min) }</td>
								<td class="mono">{ formatValue(m.Max) }</td>
								<td>
									@MetricSparkline(m.Trend)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</sl-card>
		<style>
			.metric-cell {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				min-width: 0;
			}
			.metric-name {
				font-family: var(--font-mono);
				font-size: 0.8125rem;
				color: var(--text-primary);
				white-space: nowrap;
			}
			.metric-prefix {
				color: var(--text-muted);
			}
			.metric-services {
				display: flex;
				align-items: center;
				gap: 0.25rem;
				flex-shrink: 0;
			}
			.metric-svc-link {
				text-decoration: none;
			}
			.metric-svc-link:hover sl-tag::part(base) {
				border-color: var(--accent);
				color: var(--accent);
			}
			.sparkline {
				width: 80px;
				height: 24px;
			}
			.sparkline polyline {
				fill: none;
				stroke: var(--accent);
				stroke-width: 1.5;
				stroke-linecap: round;
				stroke-linejoin: round;
			}
		</style>
	}
}

// MetricSparkline renders an SVG sparkline from values
templ MetricSparkline(values []float64) {
	if len(values) > 1 {
		<svg class="sparkline" viewBox="0 0 100 24" preserveAspectRatio="none">
			<polyline points={ metricSparklinePoints(values) }></polyline>
		</svg>
	} else {
		<span style="color: var(--text-muted);">—</span>
	}
}

func metricSparklinePoints(values []float64) string {
	if len(values) == 0 {
		return ""
	}

	// Find min/max for scaling
	min, max := values[0], values[0]
	for _, v := range values {
		if v < min {
			min = v
		}
		if v > max {
			max = v
		}
	}

	// Avoid division by zero
	rang := max - min
	if rang == 0 {
		rang = 1
	}

	// Generate points
	var points []string
	xStep := 100.0 / float64(len(values)-1)
	for i, v := range values {
		x := float64(i) * xStep
		// Invert Y (SVG 0 is top), leave 2px padding
		y := 22 - ((v-min)/rang)*20
		points = append(points, fmt.Sprintf("%.1f,%.1f", x, y))
	}

	return strings.Join(points, " ")
}

func metricPrefix(name string) string {
	if idx := strings.LastIndex(name, "."); idx >= 0 {
		return name[:idx+1]
	}
	return ""
}

func metricLeaf(name string) string {
	if idx := strings.LastIndex(name, "."); idx >= 0 {
		return name[idx+1:]
	}
	return name
}

func metricTypeVariant(mtype string) string {
	switch strings.ToLower(mtype) {
	case "gauge":
		return "primary"
	case "sum", "sum_delta":
		return "success"
	case "histogram":
		return "warning"
	default:
		return "neutral"
	}
}

func formatCount(n int64) string {
	if n >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(n)/1000000)
	}
	if n >= 1000 {
		return fmt.Sprintf("%.1fk", float64(n)/1000)
	}
	return fmt.Sprintf("%d", n)
}

func formatValue(v float64) string {
	if v == 0 {
		return "0"
	}
	if v >= 1000000 {
		return fmt.Sprintf("%.1fM", v/1000000)
	}
	if v >= 1000 {
		return fmt.Sprintf("%.1fk", v/1000)
	}
	if v < 0.01 {
		return fmt.Sprintf("%.4f", v)
	}
	return fmt.Sprintf("%.2f", v)
}
