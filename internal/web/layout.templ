package web

// Base layout with sidebar navigation
templ Layout(title string, activePage string, window int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - Fanout</title>
			<!-- Shoelace CSS -->
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/dark.css"/>
			<!-- HTMX -->
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
			<!-- Shoelace JS -->
			<script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace-autoloader.js"></script>
			<!-- Vega-Lite -->
			<script src="https://cdn.jsdelivr.net/npm/vega@6.2.0"></script>
			<script src="https://cdn.jsdelivr.net/npm/vega-lite@6.4.1"></script>
			<script src="https://cdn.jsdelivr.net/npm/vega-embed@7.1.0"></script>
			<style>
				:root {
					--sidebar-width: 220px;
					--header-height: 56px;
					--bg-primary: #f8fafc;
					--bg-secondary: #ffffff;
					--bg-tertiary: #f1f5f9;
					--text-primary: #0f172a;
					--text-secondary: #475569;
					--text-muted: #94a3b8;
					--border-color: #e2e8f0;
					--accent: #3b82f6;
					--accent-hover: #2563eb;
					--success: #22c55e;
					--warning: #f59e0b;
					--danger: #ef4444;
				}

				.sl-theme-dark {
					--bg-primary: #0f172a;
					--bg-secondary: #1e293b;
					--bg-tertiary: #334155;
					--text-primary: #f1f5f9;
					--text-secondary: #cbd5e1;
					--text-muted: #64748b;
					--border-color: #334155;
				}

				* { margin: 0; padding: 0; box-sizing: border-box; }

				body {
					font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
					background: var(--bg-primary);
					color: var(--text-primary);
					height: 100vh;
					overflow: hidden;
				}

				.app {
					display: grid;
					grid-template-columns: var(--sidebar-width) 1fr;
					grid-template-rows: var(--header-height) 1fr;
					height: 100vh;
				}

				/* Header */
				.header {
					grid-column: 1 / -1;
					background: var(--bg-secondary);
					border-bottom: 1px solid var(--border-color);
					display: flex;
					align-items: center;
					padding: 0 1rem;
					gap: 1rem;
				}

					.header-brand {
						font-size: 1.25rem;
						font-weight: 700;
						color: var(--accent);
						text-decoration: none;
					}

					.mobile-nav-toggle {
						display: none;
					}

					.header-spacer { flex: 1; }

				/* Sidebar */
				.sidebar {
					background: var(--bg-secondary);
					border-right: 1px solid var(--border-color);
					padding: 1rem 0;
					overflow-y: auto;
				}

				.nav { display: flex; flex-direction: column; gap: 0.25rem; padding: 0 0.5rem; }

				.nav-item {
					display: flex;
					align-items: center;
					gap: 0.75rem;
					padding: 0.625rem 0.75rem;
					border-radius: 0.5rem;
					color: var(--text-secondary);
					text-decoration: none;
					font-size: 0.875rem;
					font-weight: 500;
					transition: all 0.15s;
				}

				.nav-item:hover {
					background: var(--bg-tertiary);
					color: var(--text-primary);
				}

				.nav-item.active {
					background: var(--accent);
					color: white;
				}

				.nav-item sl-icon { font-size: 1.125rem; }

				/* Main content */
				.main {
					overflow-y: auto;
					padding: 1.5rem;
					background: var(--bg-primary);
				}

				.page-title {
					font-size: 1.5rem;
					font-weight: 700;
					color: var(--text-primary);
					margin-bottom: 0.25rem;
				}

				.page-subtitle {
					font-size: 0.875rem;
					color: var(--text-secondary);
				}

				/* Cards - using sl-card */
				sl-card {
					--border-color: var(--border-color);
					--border-radius: 0.75rem;
					--padding: 1.25rem;
				}
				sl-card::part(base) {
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
				}
				sl-card::part(header) {
					padding: var(--padding);
					padding-bottom: 0;
				}
				sl-card::part(body) {
					padding: var(--padding);
				}

				.card-header {
					font-size: 0.875rem;
					font-weight: 600;
					color: var(--text-secondary);
					text-transform: uppercase;
					letter-spacing: 0.025em;
				}

				/* Grid */
				.grid { display: grid; gap: 1rem; }
				.grid-2 { grid-template-columns: repeat(2, 1fr); }
				.grid-3 { grid-template-columns: repeat(3, 1fr); }
				.grid-4 { grid-template-columns: repeat(4, 1fr); }
				.grid > sl-badge { justify-self: start; align-self: center; }

				@media (max-width: 1024px) {
					.grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); }
				}
					@media (max-width: 640px) {
						.grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
						.app { grid-template-columns: 1fr; }
						.sidebar { display: none; }
						.mobile-nav-toggle { display: inline-flex; }
					}

				/* Metrics */
				.metric, .metric-card { text-align: center; }
				.metric-card {
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					padding: 1rem;
				}
				.metric-card::part(body) {
					display: flex;
					flex-direction: column;
					align-items: center;
				}
				.metric-value {
					font-size: 2rem;
					font-weight: 700;
					color: var(--text-primary);
					line-height: 1;
				}
				.metric-label {
					font-size: 0.75rem;
					color: var(--text-muted);
					margin-top: 0.25rem;
					text-transform: uppercase;
					letter-spacing: 0.05em;
				}

	
				/* Namespace badge */
				.namespace-badge {
					display: inline-block;
					padding: 0.125rem 0.5rem;
					border-radius: 0.25rem;
					font-size: 0.7rem;
					font-weight: 500;
					background: var(--bg-tertiary);
					color: var(--text-secondary);
					border: 1px solid var(--border-color);
				}

				/* Search section */
				.search-section {
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: 0.5rem;
					padding: 1rem 1.25rem;
					margin-bottom: 1.5rem;
				}
				.search-section .form-row {
					display: flex;
					gap: 0.75rem;
					align-items: flex-end;
				}
				.search-section sl-input {
					flex: 1;
				}
				.search-section .search-hint {
					margin-top: 0.75rem;
					font-size: 0.75rem;
					color: var(--text-muted);
					display: flex;
					flex-wrap: wrap;
					gap: 0.5rem;
					align-items: center;
				}
				.search-section .search-hint code {
					background: var(--bg-tertiary);
					padding: 0.125rem 0.375rem;
					border-radius: 0.25rem;
					font-size: 0.7rem;
				}

				/* Results section */
				.results-section {
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: 0.5rem;
					overflow: hidden;
				}
				.results-header {
					padding: 0.875rem 1.25rem;
					border-bottom: 1px solid var(--border-color);
					font-size: 0.75rem;
					font-weight: 600;
					color: var(--text-secondary);
					text-transform: uppercase;
					letter-spacing: 0.025em;
					background: var(--bg-primary);
				}

				/* Tables */
				.table {
					width: 100%;
					border-collapse: collapse;
					font-size: 0.875rem;
				}
				.table th, .table td {
					padding: 0.75rem 1rem;
					text-align: left;
				}
				.table th {
					font-weight: 600;
					color: var(--text-secondary);
					font-size: 0.7rem;
					text-transform: uppercase;
					letter-spacing: 0.03em;
					background: var(--bg-primary);
					border-bottom: 2px solid var(--border-color);
				}
				.table td {
					border-bottom: 1px solid var(--border-color);
				}
				.table tbody tr:last-child td {
					border-bottom: none;
				}
				.table tbody tr:hover td { background: var(--bg-tertiary); }
				.table a { color: var(--accent); text-decoration: none; }
				.table a:hover { text-decoration: underline; }

				/* Charts */
				.chart { width: 100%; height: 300px; }

				/* Loading - use sl-spinner inline */
				.loading {
					display: flex;
					align-items: center;
					justify-content: center;
					padding: 2rem;
					color: var(--text-muted);
				}

				/* HTMX Loading Indicator */
				.htmx-request {
					opacity: 0.6;
					transition: opacity 200ms ease-in;
				}
				.htmx-request .htmx-indicator {
					display: inline-flex !important;
				}
				.htmx-indicator.htmx-request {
					display: inline-flex !important;
				}
				.htmx-indicator {
					display: none;
				}
				.loading-overlay {
					position: relative;
				}
				.loading-overlay.htmx-request::after {
					content: '';
					position: absolute;
					inset: 0;
					background: var(--bg-secondary);
					opacity: 0.5;
					border-radius: inherit;
				}

				/* Top Loading Bar */
				.loading-bar {
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					height: 3px;
					background: var(--accent);
					z-index: 9999;
					transform: scaleX(0);
					transform-origin: left;
					transition: transform 0.3s ease-out;
				}
				.loading-bar.active {
					animation: loading-progress 2s ease-out forwards;
				}
				@keyframes loading-progress {
					0% { transform: scaleX(0); }
					50% { transform: scaleX(0.7); }
					100% { transform: scaleX(0.95); }
				}
				.loading-bar.done {
					transform: scaleX(1);
					transition: transform 0.1s ease-out;
				}
				.loading-bar.hide {
					opacity: 0;
					transition: opacity 0.2s ease-out;
				}

	
				/* Breadcrumbs */
				.breadcrumbs {
					margin-bottom: 1rem;
				}
				.breadcrumbs sl-breadcrumb-item::part(label) {
					font-size: 0.875rem;
					color: var(--text-secondary);
				}
				.breadcrumbs sl-breadcrumb-item:last-child::part(label) {
					color: var(--text-primary);
					font-weight: 500;
				}

				/* Page header with refresh */
				.page-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
					margin-bottom: 1.5rem;
				}
				.page-header-left {
					flex: 1;
				}
				.page-header-right {
					display: flex;
					align-items: center;
					gap: 0.75rem;
				}
				.last-updated {
					font-size: 0.75rem;
					color: var(--text-muted);
				}

				/* Quick Filters */
				.quick-filters {
					display: flex;
					gap: 0.5rem;
					margin-bottom: 1rem;
				}
				.quick-filters sl-button::part(base) {
					font-size: 0.75rem;
				}

				/* Sparklines */
				.sparkline {
					display: inline-block;
					vertical-align: middle;
				}
				.sparkline svg {
					display: block;
				}
				.sparkline-line {
					fill: none;
					stroke: var(--accent);
					stroke-width: 1.5;
				}
				.sparkline-error .sparkline-line {
					stroke: var(--danger);
				}

				/* Empty States */
				.empty-state {
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					padding: 3rem 1rem;
					text-align: center;
					color: var(--text-muted);
				}
				.empty-state sl-icon {
					font-size: 3rem;
					margin-bottom: 1rem;
					opacity: 0.5;
				}
				.empty-state-title {
					font-size: 1rem;
					font-weight: 600;
					color: var(--text-secondary);
					margin-bottom: 0.5rem;
				}
				.empty-state-message {
					font-size: 0.875rem;
				}
			</style>
			<script>
				// Guard against re-execution when htmx swaps body
				if (!window._fanoutInit) {
					window._fanoutInit = true;

					// Initialize UI components (called on load and after htmx swaps)
					function initUI() {
						const body = document.body;

						// Theme toggle
						const toggle = document.getElementById('theme-toggle');
						if (toggle && !toggle._initialized) {
							toggle._initialized = true;
							const saved = localStorage.getItem('theme');
							if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
								body.classList.replace('sl-theme-light', 'sl-theme-dark');
								toggle.name = 'sun';
							}
							toggle.addEventListener('click', () => {
								const isDark = body.classList.contains('sl-theme-dark');
								body.classList.replace(isDark ? 'sl-theme-dark' : 'sl-theme-light', isDark ? 'sl-theme-light' : 'sl-theme-dark');
								toggle.name = isDark ? 'moon' : 'sun';
								localStorage.setItem('theme', isDark ? 'light' : 'dark');
							});
						}

						// Mobile navigation
						const mobileNavToggle = document.getElementById('mobile-nav-toggle');
						const mobileNav = document.getElementById('mobile-nav');
						if (mobileNavToggle && mobileNav && !mobileNavToggle._initialized) {
							mobileNavToggle._initialized = true;
							mobileNavToggle.addEventListener('click', () => mobileNav.show());
						}

						// Vega charts
						document.querySelectorAll('[data-vega]').forEach(el => {
							if (el._vegaInit) return;
							el._vegaInit = true;
							try {
								const spec = JSON.parse(el.dataset.vega);
								vegaEmbed(el, spec, { actions: false, theme: body.classList.contains('sl-theme-dark') ? 'dark' : undefined });
							} catch(e) { console.error('Vega error:', e); }
						});

						// Time window selector
						const timeDropdown = document.getElementById('time-dropdown');
						const timeValue = document.getElementById('time-value');
						const timeUnit = document.getElementById('time-unit');
						const timeDisplay = document.getElementById('time-display');

						if (timeDropdown && !timeDropdown._initialized) {
							timeDropdown._initialized = true;

							const multipliers = { minutes: 1, hours: 60, days: 1440, weeks: 10080 };

							function getWindowMinutes() {
								const val = parseInt(timeValue.value) || 1;
								return val * multipliers[timeUnit.value];
							}

							function formatWindow(minutes) {
								if (minutes >= 10080 && minutes % 10080 === 0) return `${minutes/10080}w`;
								if (minutes >= 1440 && minutes % 1440 === 0) return `${minutes/1440}d`;
								if (minutes >= 60 && minutes % 60 === 0) return `${minutes/60}h`;
								return `${minutes}m`;
							}

							function setWindowFromMinutes(minutes) {
								let unit = 'minutes', val = minutes;
								if (minutes >= 10080 && minutes % 10080 === 0) { unit = 'weeks'; val = minutes / 10080; }
								else if (minutes >= 1440 && minutes % 1440 === 0) { unit = 'days'; val = minutes / 1440; }
								else if (minutes >= 60 && minutes % 60 === 0) { unit = 'hours'; val = minutes / 60; }
								timeValue.value = val;
								timeUnit.value = unit;
								timeDisplay.textContent = 'Last ' + formatWindow(minutes);
							}

							function applyWindow(minutes) {
								const url = new URL(window.location.href);
								url.searchParams.set('window', minutes);
								timeDropdown.hide();
								htmx.ajax('GET', url.pathname + url.search, {target: 'body', swap: 'innerHTML'});
								history.pushState({}, '', url.toString());
							}

							// Event listeners
							timeValue.addEventListener('sl-change', () => applyWindow(getWindowMinutes()));
							timeUnit.addEventListener('sl-change', () => applyWindow(getWindowMinutes()));
							document.querySelectorAll('[data-window]').forEach(btn => {
								btn.addEventListener('click', () => applyWindow(parseInt(btn.dataset.window)));
							});

							// Initialize from URL
							const currentWindow = new URL(window.location.href).searchParams.get('window') || '60';
							setWindowFromMinutes(parseInt(currentWindow));
						}

						// Namespace selector
						const namespaceSelect = document.getElementById('namespace-select');
						if (namespaceSelect && !namespaceSelect._initialized) {
							namespaceSelect._initialized = true;
							const currentUrl = new URL(window.location.href);
							const urlNamespace = currentUrl.searchParams.get('ns');
							const storedNamespace = localStorage.getItem('namespace') || 'default';

							async function loadNamespaces() {
								const displayNs = urlNamespace || storedNamespace;
								namespaceSelect.innerHTML = `<sl-option value="${displayNs}">${displayNs}</sl-option>`;
								await customElements.whenDefined('sl-select');
								await namespaceSelect.updateComplete;
								namespaceSelect.value = displayNs;

								try {
									const res = await fetch('/api/namespaces');
									const namespaces = await res.json();
									if (namespaces.length === 0) return;

									let namespace = storedNamespace;
									if (urlNamespace && namespaces.includes(urlNamespace)) {
										namespace = urlNamespace;
									} else if (!namespaces.includes(namespace)) {
										namespace = namespaces[0];
									}

									if (!urlNamespace) {
										localStorage.setItem('namespace', namespace);
										const url = new URL(window.location.href);
										url.searchParams.set('ns', namespace);
										htmx.ajax('GET', url.pathname + url.search, {target: 'body', swap: 'innerHTML'});
										history.replaceState({}, '', url.toString());
										return;
									}

									namespaceSelect.innerHTML = namespaces.map(n =>
										`<sl-option value="${n}">${n}</sl-option>`
									).join('');
									await namespaceSelect.updateComplete;
									namespaceSelect.value = namespace;
									localStorage.setItem('namespace', namespace);
								} catch (e) {}
							}
							loadNamespaces();

							namespaceSelect.addEventListener('sl-change', (e) => {
								const namespace = e.target.value;
								localStorage.setItem('namespace', namespace);
								const url = new URL(window.location.href);
								url.searchParams.set('ns', namespace);
								e.target.blur();
								htmx.ajax('GET', url.pathname + url.search, {target: 'body', swap: 'innerHTML'});
								history.pushState({}, '', url.toString());
							});
						}
					}

					// Last updated timestamp
					let lastUpdateTime = Date.now();
					function updateTimestamp() {
						const el = document.getElementById('last-updated');
						if (!el) return;
						const seconds = Math.floor((Date.now() - lastUpdateTime) / 1000);
						if (seconds < 5) el.textContent = 'Updated just now';
						else if (seconds < 60) el.textContent = `Updated ${seconds}s ago`;
						else el.textContent = `Updated ${Math.floor(seconds / 60)}m ago`;
					}

					// Keyboard shortcuts
					let gPressed = false;
					let gTimeout = null;
					const shortcuts = {
						'g': { 'o': '/', 's': '/services', 't': '/traces', 'l': '/logs', 'm': '/metrics', 'p': '/topology' }
					};

					function getWindowParam() {
						const w = new URL(window.location.href).searchParams.get('window');
						return w && w !== '60' ? `?window=${w}` : '';
					}

					function isInputFocused() {
						const el = document.activeElement;
						return el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SL-INPUT' || el.tagName === 'SL-SELECT' || el.isContentEditable);
					}

					function focusSearch() {
						const input = document.querySelector('sl-input[name="q"]') || document.querySelector('input[name="q"]');
						if (input) {
							input.focus();
							if (input.select) input.select();
						}
					}

					function navigateRows(direction) {
						const rows = Array.from(document.querySelectorAll('.table tbody tr'));
						if (!rows.length) return;
						const current = rows.findIndex(r => r.classList.contains('kb-selected'));
						let next = current + direction;
						if (next < 0) next = 0;
						if (next >= rows.length) next = rows.length - 1;
						rows.forEach(r => r.classList.remove('kb-selected'));
						rows[next].classList.add('kb-selected');
						rows[next].scrollIntoView({ block: 'nearest' });
					}

					function openSelectedRow() {
						const row = document.querySelector('.table tbody tr.kb-selected');
						if (row) {
							const link = row.querySelector('a');
							if (link) link.click();
						}
					}

					document.addEventListener('keydown', (e) => {
						if (isInputFocused() && e.key !== 'Escape') return;

						if (e.key === 'Escape') {
							document.activeElement?.blur();
							document.querySelector('sl-dialog[open]')?.hide();
							document.querySelectorAll('.table tbody tr').forEach(r => r.classList.remove('kb-selected'));
							return;
						}

						if (e.key === '?' && !e.shiftKey) {
							e.preventDefault();
							document.getElementById('kb-help')?.show();
							return;
						}

						if (e.key === '/') {
							e.preventDefault();
							focusSearch();
							return;
						}

						if (e.key === 'j') { navigateRows(1); return; }
						if (e.key === 'k') { navigateRows(-1); return; }

						if (e.key === 'Enter') {
							const row = document.querySelector('.table tbody tr.kb-selected');
							if (row) { e.preventDefault(); openSelectedRow(); return; }
						}

						if (e.key === 'g' && !gPressed) {
							gPressed = true;
							gTimeout = setTimeout(() => { gPressed = false; }, 1000);
							return;
						}

						if (gPressed && shortcuts.g[e.key]) {
							e.preventDefault();
							clearTimeout(gTimeout);
							gPressed = false;
							const dest = shortcuts.g[e.key] + getWindowParam();
							htmx.ajax('GET', dest, {target: 'body', swap: 'innerHTML'});
							history.pushState({}, '', dest);
							return;
						}

						if (e.key === 'r') {
							const refreshBtn = document.querySelector('[hx-get][hx-target="#overview-content"]');
							if (refreshBtn) { refreshBtn.click(); return; }
						}
					});

					// Run on DOM ready
					document.addEventListener('DOMContentLoaded', () => {
						initUI();
						setInterval(updateTimestamp, 5000);
					});

					// Run after htmx swaps content (body or partial)
					document.addEventListener('htmx:afterSwap', (e) => {
						initUI();
						lastUpdateTime = Date.now();
						updateTimestamp();
					});

					// Loading bar control
					document.addEventListener('htmx:beforeRequest', () => {
						const bar = document.getElementById('loading-bar');
						if (bar) {
							bar.classList.remove('done', 'hide');
							bar.classList.add('active');
						}
					});

					document.addEventListener('htmx:afterRequest', () => {
						const bar = document.getElementById('loading-bar');
						if (bar) {
							bar.classList.remove('active');
							bar.classList.add('done');
							setTimeout(() => bar.classList.add('hide'), 150);
							setTimeout(() => {
								bar.classList.remove('done', 'hide');
								bar.style.transform = '';
							}, 400);
						}
					});
				}
			</script>
		</head>
		<body class="sl-theme-light" hx-boost="true">
			<div id="loading-bar" class="loading-bar"></div>
			<div class="app">
				<header class="header">
					<sl-icon-button class="mobile-nav-toggle" id="mobile-nav-toggle" name="list" label="Menu"></sl-icon-button>
					<a href={ templ.SafeURL(withWindow("/", window)) } class="header-brand">Fanout</a>
					<div class="header-spacer"></div>
					<sl-select id="namespace-select" size="small" style="width: 140px;"></sl-select>
					<sl-dropdown id="time-dropdown" placement="bottom-end" distance="4">
						<sl-button slot="trigger" size="small" caret>
							<sl-icon name="clock" slot="prefix"></sl-icon>
							<span id="time-display">Last 1h</span>
						</sl-button>
						<sl-menu>
							<div style="padding: 12px; min-width: 200px;">
								<div style="display: flex; gap: 8px; margin-bottom: 12px;">
									<sl-input id="time-value" type="number" value="1" min="1" max="90" size="small" style="width: 70px;"></sl-input>
									<sl-select id="time-unit" value="hours" size="small" style="flex: 1;">
										<sl-option value="minutes">minutes</sl-option>
										<sl-option value="hours">hours</sl-option>
										<sl-option value="days">days</sl-option>
										<sl-option value="weeks">weeks</sl-option>
									</sl-select>
								</div>
								<sl-button-group style="width: 100%;">
									<sl-button size="small" data-window="60">1h</sl-button>
									<sl-button size="small" data-window="360">6h</sl-button>
									<sl-button size="small" data-window="1440">24h</sl-button>
									<sl-button size="small" data-window="10080">7d</sl-button>
									<sl-button size="small" data-window="43200">30d</sl-button>
								</sl-button-group>
							</div>
						</sl-menu>
					</sl-dropdown>
					<sl-icon-button name="moon" id="theme-toggle" label="Toggle theme"></sl-icon-button>
				</header>
				<aside class="sidebar">
					@Nav(activePage, window)
				</aside>
				<main class="main">
					{ children... }
				</main>
			</div>
			<sl-drawer id="mobile-nav" label="Navigation" placement="start">
				@Nav(activePage, window)
			</sl-drawer>
			<!-- Keyboard Help Dialog -->
			<sl-dialog id="kb-help" label="Keyboard Shortcuts" style="--width: 400px;">
				<div class="kb-help-content">
					<div class="kb-section">
						<div class="kb-section-title">Navigation</div>
						<div class="kb-row"><kbd>g</kbd> <kbd>o</kbd> <span>Overview</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>s</kbd> <span>Services</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>t</kbd> <span>Traces</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>l</kbd> <span>Logs</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>m</kbd> <span>Metrics</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>p</kbd> <span>Topology</span></div>
					</div>
					<div class="kb-section">
						<div class="kb-section-title">Tables</div>
						<div class="kb-row"><kbd>j</kbd> <span>Next row</span></div>
						<div class="kb-row"><kbd>k</kbd> <span>Previous row</span></div>
						<div class="kb-row"><kbd>Enter</kbd> <span>Open selected</span></div>
					</div>
					<div class="kb-section">
						<div class="kb-section-title">General</div>
						<div class="kb-row"><kbd>/</kbd> <span>Focus search</span></div>
						<div class="kb-row"><kbd>r</kbd> <span>Refresh data</span></div>
						<div class="kb-row"><kbd>Esc</kbd> <span>Clear / Close</span></div>
						<div class="kb-row"><kbd>?</kbd> <span>Show this help</span></div>
					</div>
				</div>
				<sl-button slot="footer" variant="primary" onclick="this.closest('sl-dialog').hide()">Close</sl-button>
			</sl-dialog>
			<style>
				.kb-help-content { display: flex; flex-direction: column; gap: 1.25rem; }
				.kb-section-title { font-weight: 600; color: var(--text-secondary); margin-bottom: 0.5rem; font-size: 0.75rem; text-transform: uppercase; }
				.kb-row { display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0; font-size: 0.875rem; }
				.kb-row span { margin-left: auto; color: var(--text-secondary); }
				kbd { display: inline-flex; align-items: center; justify-content: center; min-width: 1.5rem; padding: 0.125rem 0.375rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 0.25rem; font-family: inherit; font-size: 0.75rem; font-weight: 500; }
				.table tbody tr.kb-selected { outline: 2px solid var(--accent); outline-offset: -2px; background: var(--bg-tertiary); }
			</style>
		</body>
	</html>
}
