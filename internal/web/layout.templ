package web

// Base layout with sidebar navigation
templ Layout(title string, activePage string, window int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - Fanout</title>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<!-- Fonts -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"/>
			<!-- Shoelace CSS -->
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css" integrity="sha384-VNjXcWTFgkXi1VXtuRlXBLNB44AvISAfti9WbOPCBCiNPnUpJ6dHx1Y3XmTii9pB" crossorigin="anonymous"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/dark.css" integrity="sha384-GWYIqFA394qpD/MvZTDi2pLPBjEux2y3wDvsvEa/s+DXOt1YxPYCRsisFUKlaJf/" crossorigin="anonymous"/>
			<!-- HTMX -->
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js" integrity="sha384-/TgkGk7p307TH7EXJDuUlgG3Ce1UVolAOFopFekQkkXihi5u/6OCvVKyz1W+idaz" crossorigin="anonymous"></script>
			<!-- Shoelace JS -->
			<script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace-autoloader.js" integrity="sha384-of8LXlkyMCAT14b4mQEBHRclQhowQAA+z328bANMFZBR6em9yjBEmyaeq59nXe/x" crossorigin="anonymous"></script>
			<style>
				:root {
					--sidebar-width: 220px;
					--header-height: 52px;
					--bg-primary: #f5f6f8;
					--bg-secondary: #ffffff;
					--bg-tertiary: #edf0f4;
					--text-primary: #1a1d23;
					--text-secondary: #5a6270;
					--text-muted: #8b95a5;
					--border-color: #e2e6ec;
					/* Signal-typed colors (aligned with page accents) */
					--signal-trace: #0ea5e9;
					--signal-log: #d97706;
					--signal-metric: #059669;
					--signal-error: #ef4444;
					/* Page accent - overridden per page */
					--accent: #6366f1;
					--accent-hover: #4f46e5;
					--accent-subtle: rgba(99, 102, 241, 0.06);
					/* Status */
					--success: #22c55e;
					--warning: #f59e0b;
					--danger: #ef4444;
					/* Type */
					--font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
					--font-mono: 'JetBrains Mono', 'SF Mono', Monaco, monospace;
					--radius: 0.5rem;
					--transition: 120ms cubic-bezier(0.4, 0, 0.2, 1);
				}

				/* Signal-typed page accents (custom + Shoelace primary overrides) */
				.page-traces { --accent: #0ea5e9; --accent-hover: #0284c7; --accent-subtle: rgba(14, 165, 233, 0.06); --sl-color-primary-600: #0ea5e9; --sl-color-primary-700: #0284c7; --sl-color-primary-500: #38bdf8; }
				.page-logs { --accent: #d97706; --accent-hover: #b45309; --accent-subtle: rgba(217, 119, 6, 0.06); --sl-color-primary-600: #d97706; --sl-color-primary-700: #b45309; --sl-color-primary-500: #f59e0b; }
				.page-metrics { --accent: #059669; --accent-hover: #047857; --accent-subtle: rgba(5, 150, 105, 0.06); --sl-color-primary-600: #059669; --sl-color-primary-700: #047857; --sl-color-primary-500: #10b981; }
				.page-topology { --accent: #7c3aed; --accent-hover: #6d28d9; --accent-subtle: rgba(124, 58, 237, 0.06); --sl-color-primary-600: #7c3aed; --sl-color-primary-700: #6d28d9; --sl-color-primary-500: #8b5cf6; }
				.page-unified { --accent: #6366f1; --accent-hover: #4f46e5; --accent-subtle: rgba(99, 102, 241, 0.06); --sl-color-primary-600: #6366f1; --sl-color-primary-700: #4f46e5; --sl-color-primary-500: #818cf8; }

				.sl-theme-dark {
					--bg-primary: #0d1117;
					--bg-secondary: #161b22;
					--bg-tertiary: #21262d;
					--text-primary: #e6edf3;
					--text-secondary: #8b949e;
					--text-muted: #6e7681;
					--border-color: #30363d;
					--accent-subtle: rgba(99, 102, 241, 0.12);
				}
				.sl-theme-dark.page-traces { --accent-subtle: rgba(14, 165, 233, 0.12); }
				.sl-theme-dark.page-logs { --accent-subtle: rgba(217, 119, 6, 0.12); }
				.sl-theme-dark.page-metrics { --accent-subtle: rgba(5, 150, 105, 0.12); }
				.sl-theme-dark.page-topology { --accent-subtle: rgba(124, 58, 237, 0.12); }
				.sl-theme-dark.page-unified { --accent-subtle: rgba(99, 102, 241, 0.12); }

				* { margin: 0; padding: 0; box-sizing: border-box; }

				body {
					font-family: var(--font-sans);
					background: var(--bg-primary);
					color: var(--text-primary);
					height: 100vh;
					overflow: hidden;
				}

				.app {
					display: grid;
					grid-template-columns: var(--sidebar-width) 1fr;
					grid-template-rows: var(--header-height) 1fr;
					height: 100vh;
				}

				/* Header */
				.header {
					grid-column: 1 / -1;
					background: var(--bg-secondary);
					border-bottom: 1px solid var(--border-color);
					display: flex;
					align-items: center;
					padding: 0 1rem;
					gap: 0.75rem;
				}

					.header-brand {
						font-size: 1rem;
						font-weight: 700;
						color: var(--text-primary);
						text-decoration: none;
						letter-spacing: -0.03em;
						display: flex;
						align-items: center;
						gap: 0.5rem;
					}
					.header-logo {
						width: 24px;
						height: 24px;
						border-radius: 5px;
						flex-shrink: 0;
					}

					.mobile-nav-toggle {
						display: none;
					}

					.header-spacer { flex: 1; }

				/* Sidebar */
				.sidebar {
					background: var(--bg-secondary);
					border-right: 1px solid var(--border-color);
					padding: 0.75rem 0;
					overflow-y: auto;
				}

				.nav { display: flex; flex-direction: column; gap: 2px; padding: 0 0.5rem; }

				.nav-item {
					display: flex;
					align-items: center;
					gap: 0.625rem;
					padding: 0.5rem 0.75rem;
					border-radius: var(--radius);
					color: var(--text-muted);
					text-decoration: none;
					font-size: 0.8125rem;
					font-weight: 500;
					transition: all var(--transition);
					position: relative;
				}

				.nav-item:hover {
					background: var(--bg-tertiary);
					color: var(--text-primary);
				}

				.nav-item.active {
					background: var(--accent-subtle);
					color: var(--accent);
					font-weight: 600;
				}
				.nav-item.active::before {
					content: '';
					position: absolute;
					left: 0;
					top: 25%;
					bottom: 25%;
					width: 3px;
					background: var(--accent);
					border-radius: 0 2px 2px 0;
				}

				.nav-item sl-icon { font-size: 1rem; }

				/* Main content */
				.main {
					overflow-y: auto;
					padding: 1.25rem 1.5rem;
					background: var(--bg-primary);
				}

				.page-title {
					font-size: 1.25rem;
					font-weight: 700;
					color: var(--text-primary);
					margin-bottom: 0.125rem;
					letter-spacing: -0.025em;
				}

				.page-subtitle {
					font-size: 0.8125rem;
					color: var(--text-muted);
				}


				/* Cards - using sl-card */
				sl-card {
					--border-color: var(--border-color);
					--border-radius: var(--radius);
					--padding: 1rem;
					display: block;
					width: 100%;
				}
				sl-card::part(base) {
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
					transition: box-shadow var(--transition);
				}
				sl-card::part(header) {
					padding: var(--padding);
					padding-bottom: 0;
				}
				sl-card::part(body) {
					padding: var(--padding);
				}

				.card-header {
					font-size: 0.65rem;
					font-weight: 600;
					color: var(--text-muted);
					text-transform: uppercase;
					letter-spacing: 0.05em;
				}

				/* Grid */
				.grid { display: grid; gap: 1rem; }
				.grid-2 { grid-template-columns: repeat(2, 1fr); }
				.grid-3 { grid-template-columns: repeat(3, 1fr); }
				.grid-4 { grid-template-columns: repeat(4, 1fr); }
				.grid > sl-badge { justify-self: start; align-self: center; }

				@media (max-width: 1024px) {
					.grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); }
				}
					@media (max-width: 640px) {
						.grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
						.app { grid-template-columns: 1fr; }
						.sidebar { display: none; }
						.mobile-nav-toggle { display: inline-flex; }
					}

				/* Stats Bar */
				.stats-bar {
					display: flex;
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: var(--radius);
					overflow: hidden;
				}
				.stats-item {
					flex: 1;
					padding: 0.75rem 1rem;
					text-align: center;
					border-right: 1px solid var(--border-color);
				}
				.stats-item:last-child {
					border-right: none;
				}
				.stats-value {
					font-size: 1.25rem;
					font-weight: 700;
					color: var(--text-primary);
					line-height: 1;
					letter-spacing: -0.02em;
					font-feature-settings: 'tnum';
				}
				.stats-label {
					font-size: 0.65rem;
					color: var(--text-muted);
					margin-top: 0.25rem;
					text-transform: uppercase;
					letter-spacing: 0.05em;
					font-weight: 500;
				}

				/* Metric cards (stats with accent left border) */
				.metric-card {
					--padding: 0.75rem;
				}
				.metric-card::part(base) {
					border-left: 3px solid var(--accent);
					border-top: none;
				}
				.metric-card::part(body) {
					padding: 0.75rem 1rem;
					text-align: center;
				}
				.metric-value {
					font-size: 1.25rem;
					font-weight: 700;
					color: var(--text-primary);
					line-height: 1;
					letter-spacing: -0.02em;
					font-feature-settings: 'tnum';
				}
				.metric-label {
					font-size: 0.65rem;
					color: var(--text-muted);
					margin-top: 0.25rem;
					text-transform: uppercase;
					letter-spacing: 0.05em;
					font-weight: 500;
				}


				/* sl-tag styles */
				sl-tag {
					--sl-spacing-x-small: 0.25rem;
				}
				sl-tag::part(base) {
					font-size: 0.7rem;
					height: auto;
					padding: 0.125rem 0.5rem;
				}
				sl-tag[size="small"]::part(base) {
					font-size: 0.65rem;
					padding: 0.1rem 0.375rem;
				}
				/* Tag variants for facets */
				sl-tag.facet-error::part(base) {
					background: var(--sl-color-danger-100);
					color: var(--sl-color-danger-700);
				}
				sl-tag.facet-span::part(base) {
					background: rgba(14, 165, 233, 0.1);
					color: #0ea5e9;
				}
				sl-tag.facet-log::part(base) {
					background: rgba(245, 158, 11, 0.1);
					color: #d97706;
				}
				sl-tag.facet-metric::part(base) {
					background: rgba(34, 197, 94, 0.1);
					color: #16a34a;
				}
				/* Namespace tag styling */
				sl-tag.ns-tag::part(base) {
					background: var(--bg-tertiary);
					color: var(--text-secondary);
					border: 1px solid var(--border-color);
				}

				/* Search section */
				.search-section {
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: var(--radius);
					padding: 0.875rem 1rem;
					margin-bottom: 1rem;
				}
				.search-section .form-row,
				.search-form .form-row {
					display: flex;
					gap: 0.75rem;
					align-items: flex-end;
					flex-wrap: wrap;
				}
				.search-section sl-input,
				.search-form sl-input {
					flex: 1;
					min-width: 200px;
				}
				.search-section .search-hint,
				.search-form .search-hint {
					margin-top: 0.75rem;
					font-size: 0.75rem;
					color: var(--text-muted);
					display: flex;
					flex-wrap: wrap;
					gap: 0.5rem;
					align-items: center;
				}
				.search-section .search-hint code,
				.search-form .search-hint code {
					background: var(--bg-tertiary);
					padding: 0.125rem 0.375rem;
					border-radius: 0.25rem;
					font-family: var(--font-mono);
					font-size: 0.7rem;
				}
				.search-form .search-hint sl-icon {
					font-size: 0.875rem;
				}

				/* Results section */
				.results-section {
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: var(--radius);
					overflow: hidden;
				}
				.results-header {
					padding: 0.625rem 0.75rem;
					border-bottom: 1px solid var(--border-color);
					font-size: 0.65rem;
					font-weight: 600;
					color: var(--text-muted);
					text-transform: uppercase;
					letter-spacing: 0.05em;
					background: var(--bg-primary);
				}

				/* Tables */
				.table-container {
					overflow-x: auto;
					-webkit-overflow-scrolling: touch;
					position: relative;
				}
				.table {
					width: 100%;
					border-collapse: collapse;
					font-size: 0.8125rem;
				}
				.table th, .table td {
					padding: 0.5rem 0.75rem;
					text-align: left;
				}
				.table th {
					font-weight: 600;
					color: var(--text-muted);
					font-size: 0.65rem;
					text-transform: uppercase;
					letter-spacing: 0.05em;
					background: var(--bg-primary);
					border-bottom: 1px solid var(--border-color);
					position: sticky;
					top: 0;
					z-index: 1;
				}
				.table td {
					border-bottom: 1px solid var(--border-color);
					transition: background var(--transition);
				}
				.table tbody tr:last-child td {
					border-bottom: none;
				}
				.table tbody tr:hover td { background: var(--accent-subtle); }
				.table a { color: var(--accent); text-decoration: none; font-weight: 500; }
				.table a:hover { text-decoration: underline; }

				/* Monospace cells */
				.mono {
					font-family: var(--font-mono);
					font-size: 0.8rem;
				}

				/* Charts */
				.chart { width: 100%; height: 300px; }

				/* Loading - use sl-spinner inline */
				.loading {
					display: flex;
					align-items: center;
					justify-content: center;
					padding: 2rem;
					color: var(--text-muted);
				}

				/* HTMX Loading Indicator */
				.htmx-request {
					opacity: 0.6;
					transition: opacity 200ms ease-in;
				}
				.htmx-request .htmx-indicator {
					display: inline-flex !important;
				}
				.htmx-indicator.htmx-request {
					display: inline-flex !important;
				}
				.htmx-indicator {
					display: none;
				}
				.loading-overlay {
					position: relative;
				}
				.loading-overlay.htmx-request::after {
					content: '';
					position: absolute;
					inset: 0;
					background: var(--bg-secondary);
					opacity: 0.5;
					border-radius: inherit;
				}

				/* Top Loading Bar */
				.loading-bar {
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					height: 3px;
					background: var(--accent);
					z-index: 9999;
					transform: scaleX(0);
					transform-origin: left;
					transition: transform 0.3s ease-out;
				}
				.loading-bar.active {
					animation: loading-progress 2s ease-out forwards;
				}
				@keyframes loading-progress {
					0% { transform: scaleX(0); }
					50% { transform: scaleX(0.7); }
					100% { transform: scaleX(0.95); }
				}
				.loading-bar.done {
					transform: scaleX(1);
					transition: transform 0.1s ease-out;
				}
				.loading-bar.hide {
					opacity: 0;
					transition: opacity 0.2s ease-out;
				}


				/* Breadcrumbs */
				.breadcrumbs {
					margin-bottom: 1rem;
				}
				.breadcrumbs sl-breadcrumb-item::part(label) {
					font-size: 0.875rem;
					color: var(--text-secondary);
				}
				.breadcrumbs sl-breadcrumb-item:last-child::part(label) {
					color: var(--text-primary);
					font-weight: 500;
				}

				/* Page header with refresh */
				.page-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
					margin-bottom: 1rem;
				}
				.page-header-left {
					flex: 1;
				}
				.page-header-right {
					display: flex;
					align-items: center;
					gap: 0.5rem;
				}
				.last-updated {
					font-size: 0.7rem;
					color: var(--text-muted);
				}

				/* Quick Filters */
				.quick-filters {
					display: flex;
					gap: 0.375rem;
					margin-bottom: 0.75rem;
				}
				.quick-filters sl-button::part(base) {
					font-size: 0.7rem;
				}

				/* Sparklines */
				.sparkline {
					display: inline-block;
					vertical-align: middle;
				}
				.sparkline svg {
					display: block;
				}
				.sparkline-line {
					fill: none;
					stroke: var(--accent);
					stroke-width: 1.5;
				}
				.sparkline-error .sparkline-line {
					stroke: var(--danger);
				}

				/* Empty States */
				.empty-state {
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					padding: 3rem 1rem;
					text-align: center;
					color: var(--text-muted);
				}
				.empty-state sl-icon {
					font-size: 3rem;
					margin-bottom: 1rem;
					opacity: 0.5;
				}
				.empty-state-title {
					font-size: 1rem;
					font-weight: 600;
					color: var(--text-secondary);
					margin-bottom: 0.5rem;
				}
				.empty-state-message {
					font-size: 0.875rem;
				}

				/* Inline empty states (for smaller cards) */
				.empty-inline {
					display: flex;
					align-items: center;
					justify-content: center;
					gap: 0.5rem;
					padding: 2rem;
					color: var(--text-muted);
					font-size: 0.875rem;
				}
				.empty-inline sl-icon {
					font-size: 1rem;
					opacity: 0.6;
				}
				.empty-inline.success sl-icon {
					color: var(--success);
				}

				/* Clickable search hints */
				.search-hint code {
					cursor: pointer;
					transition: background var(--transition), color var(--transition);
				}
				.search-hint code:hover {
					background: var(--accent);
					color: white;
				}

				/* Dark mode enhancements */
				.sl-theme-dark .search-hint code {
					background: var(--bg-tertiary);
				}
				.sl-theme-dark .facet-chip {
					background: var(--bg-tertiary);
				}
				.sl-theme-dark sl-badge::part(base) {
					border: 1px solid rgba(255,255,255,0.1);
				}

				/* Skeleton loading */
				.skeleton {
					background: linear-gradient(90deg, var(--bg-tertiary) 25%, var(--bg-secondary) 50%, var(--bg-tertiary) 75%);
					background-size: 200% 100%;
					animation: skeleton-loading 1.5s infinite;
					border-radius: 0.25rem;
				}
				@keyframes skeleton-loading {
					0% { background-position: 200% 0; }
					100% { background-position: -200% 0; }
				}
				.skeleton-row {
					height: 2.5rem;
					margin-bottom: 0.5rem;
				}
				.skeleton-stat {
					height: 3rem;
					width: 60%;
					margin: 0 auto;
				}

				/* sl-relative-time styling */
				sl-relative-time {
					color: var(--text-muted);
					font-size: inherit;
				}
				sl-relative-time::part(relative-time) {
					cursor: help;
				}

				/* sl-skeleton loading */
				sl-skeleton {
					--border-radius: 0.25rem;
				}

				/* sl-tooltip styling */
				sl-tooltip::part(body) {
					font-size: 0.75rem;
				}

				/* sl-alert for anomaly banners */
				sl-alert.anomaly-alert::part(base) {
					margin-bottom: 1.5rem;
				}
				sl-alert.anomaly-alert::part(message) {
					font-size: 0.875rem;
				}

				/* Facet bar styles */
				.facets-bar {
					display: flex;
					flex-wrap: wrap;
					gap: 0.75rem;
					padding: 0.5rem 0.75rem;
					background: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: var(--radius);
					margin-bottom: 0.75rem;
				}
				.facet-group {
					display: flex;
					align-items: center;
					gap: 0.375rem;
					flex-wrap: wrap;
				}
				.facet-label {
					font-size: 0.65rem;
					font-weight: 600;
					color: var(--text-muted);
					text-transform: uppercase;
					letter-spacing: 0.05em;
				}
				.facet-count {
					font-weight: 600;
					opacity: 0.7;
					margin-left: 0.25rem;
					font-feature-settings: 'tnum';
				}

				/* Shared pagination */
				.pagination {
					display: flex;
					align-items: center;
					justify-content: center;
					gap: 0.75rem;
					padding: 0.75rem;
					border-top: 1px solid var(--border-color);
					margin-top: 0.75rem;
				}
				.pagination-info {
					color: var(--text-muted);
					font-size: 0.8rem;
					font-feature-settings: 'tnum';
				}

				/* Facet tag links */
				.facet-link {
					text-decoration: none;
				}
			</style>
			<script>
				// Guard against re-execution when htmx swaps body
				if (!window._fanoutInit) {
					window._fanoutInit = true;

					// Dynamic script loader for lazy Vega loading
					let _vegaLoadPromise = null;
					window.loadVega = function() {
						if (_vegaLoadPromise) return _vegaLoadPromise;
						if (window.vegaEmbed) return Promise.resolve();
						_vegaLoadPromise = new Promise(async (resolve, reject) => {
							try {
								await loadScript(
									'https://cdn.jsdelivr.net/npm/vega@6.2.0',
									'sha384-0Wc8+KeboSkAq/fK81pd4uFbWKu4ouB+y4KWCYxlC69hRWol7vnc6zZSruXOtc0F'
								);
								await loadScript(
									'https://cdn.jsdelivr.net/npm/vega-lite@6.4.1',
									'sha384-QtG7pnWvq1Tk0Rcvl53B1TEVw7U1PUqfciCz3XMUqSmi1fNpJwiv5ml+m5NeOOzH'
								);
								await loadScript(
									'https://cdn.jsdelivr.net/npm/vega-embed@7.1.0',
									'sha384-giTAWqsEDsWuWzWKi6NCvjgwi160SClnTYYXWPLuy/DnaQTqmk4soinrpxcCS4dx'
								);
								resolve();
							} catch(e) {
								console.error('Failed to load Vega:', e);
								reject(e);
							}
						});
						return _vegaLoadPromise;
					};

					function loadScript(src, integrity) {
						return new Promise((resolve, reject) => {
							const existing = document.querySelector('script[src="' + src + '"]');
							if (existing) {
								if (existing._loaded) { resolve(); return; }
								existing.addEventListener('load', resolve);
								return;
							}
							const s = document.createElement('script');
							s.src = src;
							if (integrity) {
								s.integrity = integrity;
								s.crossOrigin = 'anonymous';
							}
							s.onload = () => { s._loaded = true; resolve(); };
							s.onerror = reject;
							document.head.appendChild(s);
						});
					}

					// Initialize UI components (called on load and after htmx swaps)
					function initUI() {
						const body = document.body;

						// Sync page signal class from URL (htmx body swaps don't update body attributes)
						const path = window.location.pathname;
						const pageMap = { '/': 'overview', '/services': 'services', '/traces': 'traces', '/logs': 'logs', '/metrics': 'metrics', '/topology': 'topology', '/unified': 'unified' };
						let pageName = 'overview';
						for (const [prefix, name] of Object.entries(pageMap)) {
							if (prefix === '/' && path === '/') { pageName = name; break; }
							if (prefix !== '/' && path.startsWith(prefix)) { pageName = name; break; }
						}
						body.className = body.className.replace(/page-\w+/, 'page-' + pageName);

						// Clickable search hints
						document.querySelectorAll('.search-hint code').forEach(chip => {
							if (chip._clickInit) return;
							chip._clickInit = true;
							chip.addEventListener('click', () => {
								const input = document.querySelector('sl-input[name="q"]');
								if (input) {
									const currentVal = input.value || '';
									input.value = (currentVal + ' ' + chip.textContent).trim();
									input.focus();
								}
							});
						});

						// Theme toggle
						const toggle = document.getElementById('theme-toggle');
						if (toggle && !toggle._initialized) {
							toggle._initialized = true;
							const saved = localStorage.getItem('theme');
							if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
								body.classList.replace('sl-theme-light', 'sl-theme-dark');
								toggle.name = 'sun';
							}
							toggle.addEventListener('click', () => {
								const isDark = body.classList.contains('sl-theme-dark');
								body.classList.replace(isDark ? 'sl-theme-dark' : 'sl-theme-light', isDark ? 'sl-theme-light' : 'sl-theme-dark');
								toggle.name = isDark ? 'moon' : 'sun';
								localStorage.setItem('theme', isDark ? 'light' : 'dark');
							});
						}

						// Mobile navigation
						const mobileNavToggle = document.getElementById('mobile-nav-toggle');
						const mobileNav = document.getElementById('mobile-nav');
						if (mobileNavToggle && mobileNav && !mobileNavToggle._initialized) {
							mobileNavToggle._initialized = true;
							mobileNavToggle.addEventListener('click', () => mobileNav.show());
						}

						// Vega charts - lazy load
						const vegaEls = document.querySelectorAll('[data-vega]');
						if (vegaEls.length > 0) {
							loadVega().then(() => {
								vegaEls.forEach(el => {
									if (el._vegaInit) return;
									el._vegaInit = true;
									try {
										const spec = JSON.parse(el.dataset.vega);
										vegaEmbed(el, spec, { actions: false, theme: body.classList.contains('sl-theme-dark') ? 'dark' : undefined });
									} catch(e) { console.error('Vega error:', e); }
								});
							}).catch(e => console.error('Vega loading failed:', e));
						}

						// Time window selector
						const timeDropdown = document.getElementById('time-dropdown');
						const timeValue = document.getElementById('time-value');
						const timeUnit = document.getElementById('time-unit');
						const timeDisplay = document.getElementById('time-display');

						if (timeDropdown && !timeDropdown._initialized) {
							timeDropdown._initialized = true;

							const multipliers = { minutes: 1, hours: 60, days: 1440, weeks: 10080 };

							function getWindowMinutes() {
								const val = parseInt(timeValue.value) || 1;
								return val * multipliers[timeUnit.value];
							}

							function formatWindow(minutes) {
								if (minutes >= 10080 && minutes % 10080 === 0) return minutes/10080 + 'w';
								if (minutes >= 1440 && minutes % 1440 === 0) return minutes/1440 + 'd';
								if (minutes >= 60 && minutes % 60 === 0) return minutes/60 + 'h';
								return minutes + 'm';
							}

							function setWindowFromMinutes(minutes) {
								let unit = 'minutes', val = minutes;
								if (minutes >= 10080 && minutes % 10080 === 0) { unit = 'weeks'; val = minutes / 10080; }
								else if (minutes >= 1440 && minutes % 1440 === 0) { unit = 'days'; val = minutes / 1440; }
								else if (minutes >= 60 && minutes % 60 === 0) { unit = 'hours'; val = minutes / 60; }
								timeValue.value = val;
								timeUnit.value = unit;
								timeDisplay.textContent = 'Last ' + formatWindow(minutes);
							}

							function applyWindow(minutes) {
								const url = new URL(window.location.href);
								url.searchParams.set('window', minutes);
								timeDropdown.hide();
								htmx.ajax('GET', url.pathname + url.search, {target: 'body', swap: 'innerHTML'});
								history.pushState({}, '', url.toString());
							}

							// Event listeners
							timeValue.addEventListener('sl-change', () => applyWindow(getWindowMinutes()));
							timeUnit.addEventListener('sl-change', () => applyWindow(getWindowMinutes()));
							document.querySelectorAll('[data-window]').forEach(btn => {
								btn.addEventListener('click', () => applyWindow(parseInt(btn.dataset.window)));
							});

							// Initialize from URL
							const currentWindow = new URL(window.location.href).searchParams.get('window') || '60';
							setWindowFromMinutes(parseInt(currentWindow));
						}

						// Namespace selector
						const namespaceSelect = document.getElementById('namespace-select');
						if (namespaceSelect && !namespaceSelect._initialized) {
							namespaceSelect._initialized = true;
							const currentUrl = new URL(window.location.href);
							const urlNamespace = currentUrl.searchParams.get('ns');
							const storedNamespace = localStorage.getItem('namespace') || 'default';

							async function loadNamespaces() {
								const displayNs = urlNamespace || storedNamespace;
								namespaceSelect.replaceChildren();
								const initOpt = document.createElement('sl-option');
								initOpt.value = displayNs;
								initOpt.textContent = displayNs;
								namespaceSelect.appendChild(initOpt);
								await customElements.whenDefined('sl-select');
								await namespaceSelect.updateComplete;
								namespaceSelect.value = displayNs;

								try {
									const res = await fetch('/api/namespaces');
									const namespaces = await res.json();
									if (namespaces.length === 0) return;

									let namespace = storedNamespace;
									if (urlNamespace && namespaces.includes(urlNamespace)) {
										namespace = urlNamespace;
									} else if (!namespaces.includes(namespace)) {
										namespace = namespaces[0];
									}

									if (!urlNamespace) {
										localStorage.setItem('namespace', namespace);
										const url = new URL(window.location.href);
										url.searchParams.set('ns', namespace);
										htmx.ajax('GET', url.pathname + url.search, {target: 'body', swap: 'innerHTML'});
										history.replaceState({}, '', url.toString());
										return;
									}

									namespaceSelect.replaceChildren();
									namespaces.forEach(n => {
										const opt = document.createElement('sl-option');
										opt.value = n;
										opt.textContent = n;
										namespaceSelect.appendChild(opt);
									});
									await namespaceSelect.updateComplete;
									namespaceSelect.value = namespace;
									localStorage.setItem('namespace', namespace);
								} catch (e) {}
							}
							loadNamespaces();

							namespaceSelect.addEventListener('sl-change', (e) => {
								const namespace = e.target.value;
								localStorage.setItem('namespace', namespace);
								const url = new URL(window.location.href);
								url.searchParams.set('ns', namespace);
								e.target.blur();
								htmx.ajax('GET', url.pathname + url.search, {target: 'body', swap: 'innerHTML'});
								history.pushState({}, '', url.toString());
							});
						}
					}

					// Shared form submit handler (used by traces, logs, unified)
					window.cleanFormSubmit = function(form) {
						const url = new URL(form.action, window.location.origin);
						const q = form.querySelector('[name="q"]').value.trim();
						if (q) url.searchParams.set('q', q);
						const ns = new URL(window.location.href).searchParams.get('ns');
						if (ns) url.searchParams.set('ns', ns);
						const win = new URL(window.location.href).searchParams.get('window');
						if (win && win !== '60') url.searchParams.set('window', win);
						htmx.ajax('GET', url.pathname + url.search, {target: 'body', swap: 'innerHTML'}).catch(() => {
							const toast = Object.assign(document.createElement('sl-alert'), {
								variant: 'danger', closable: true, duration: 4000,
								innerHTML: '<sl-icon name="exclamation-triangle" slot="icon"></sl-icon>Search failed. Please try again.'
							});
							document.body.appendChild(toast);
							toast.toast();
						});
						history.pushState({}, '', url.toString());
						return false;
					};

					// Keyboard shortcuts
					let gPressed = false;
					let gTimeout = null;
					const shortcuts = {
						'g': { 'o': '/', 's': '/services', 't': '/traces', 'l': '/logs', 'm': '/metrics', 'p': '/topology', 'u': '/unified' }
					};

					function getWindowParam() {
						const w = new URL(window.location.href).searchParams.get('window');
						return w && w !== '60' ? '?window=' + w : '';
					}

					function isInputFocused() {
						const el = document.activeElement;
						return el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SL-INPUT' || el.tagName === 'SL-SELECT' || el.isContentEditable);
					}

					function focusSearch() {
						const input = document.querySelector('sl-input[name="q"]') || document.querySelector('input[name="q"]');
						if (input) {
							input.focus();
							if (input.select) input.select();
						}
					}

					function navigateRows(direction) {
						const rows = Array.from(document.querySelectorAll('.table tbody tr'));
						if (!rows.length) return;
						const current = rows.findIndex(r => r.classList.contains('kb-selected'));
						let next = current + direction;
						if (next < 0) next = 0;
						if (next >= rows.length) next = rows.length - 1;
						rows.forEach(r => r.classList.remove('kb-selected'));
						rows[next].classList.add('kb-selected');
						rows[next].scrollIntoView({ block: 'nearest' });
					}

					function openSelectedRow() {
						const row = document.querySelector('.table tbody tr.kb-selected');
						if (row) {
							const link = row.querySelector('a');
							if (link) link.click();
						}
					}

					document.addEventListener('keydown', (e) => {
						if (isInputFocused() && e.key !== 'Escape') return;

						if (e.key === 'Escape') {
							document.activeElement?.blur();
							document.querySelector('sl-dialog[open]')?.hide();
							document.querySelectorAll('.table tbody tr').forEach(r => r.classList.remove('kb-selected'));
							return;
						}

						if (e.key === '?' && !e.shiftKey) {
							e.preventDefault();
							document.getElementById('kb-help')?.show();
							return;
						}

						if (e.key === '/') {
							e.preventDefault();
							focusSearch();
							return;
						}

						if (e.key === 'j') { navigateRows(1); return; }
						if (e.key === 'k') { navigateRows(-1); return; }

						if (e.key === 'Enter') {
							const row = document.querySelector('.table tbody tr.kb-selected');
							if (row) { e.preventDefault(); openSelectedRow(); return; }
						}

						if (e.key === 'g' && !gPressed) {
							gPressed = true;
							gTimeout = setTimeout(() => { gPressed = false; }, 1000);
							return;
						}

						if (gPressed && shortcuts.g[e.key]) {
							e.preventDefault();
							clearTimeout(gTimeout);
							gPressed = false;
							const dest = shortcuts.g[e.key] + getWindowParam();
							htmx.ajax('GET', dest, {target: 'body', swap: 'innerHTML'});
							history.pushState({}, '', dest);
							return;
						}

						if (e.key === 'r') {
							const refreshBtn = document.querySelector('[hx-get][hx-target="#overview-content"]');
							if (refreshBtn) { refreshBtn.click(); return; }
						}
					});

					// Run on DOM ready
					document.addEventListener('DOMContentLoaded', () => {
						initUI();
					});

					// Run after htmx swaps content (body or partial)
					document.addEventListener('htmx:afterSwap', (e) => {
						initUI();
					});

					// Loading bar control
					document.addEventListener('htmx:beforeRequest', () => {
						const bar = document.getElementById('loading-bar');
						if (bar) {
							bar.classList.remove('done', 'hide');
							bar.classList.add('active');
						}
					});

					document.addEventListener('htmx:afterRequest', () => {
						const bar = document.getElementById('loading-bar');
						if (bar) {
							bar.classList.remove('active');
							bar.classList.add('done');
							setTimeout(() => bar.classList.add('hide'), 150);
							setTimeout(() => {
								bar.classList.remove('done', 'hide');
								bar.style.transform = '';
							}, 400);
						}
					});
				}
			</script>
		</head>
		<body class={ "sl-theme-light", "page-" + activePage } hx-boost="true">
			<div id="loading-bar" class="loading-bar"></div>
			<div class="app">
				<header class="header">
					<sl-icon-button class="mobile-nav-toggle" id="mobile-nav-toggle" name="list" label="Menu"></sl-icon-button>
					<a href={ templ.SafeURL(withWindow("/", window)) } class="header-brand">
						<img src="/favicon.svg" class="header-logo" alt="Fanout logo"/>
						Fanout
					</a>
					<div class="header-spacer"></div>
					<sl-select id="namespace-select" size="small" style="width: 140px;"></sl-select>
					<sl-dropdown id="time-dropdown" placement="bottom-end" distance="4">
						<sl-button slot="trigger" size="small" caret>
							<sl-icon name="clock" slot="prefix"></sl-icon>
							<span id="time-display">Last 1h</span>
						</sl-button>
						<sl-menu>
							<div style="padding: 12px; min-width: 200px;">
								<div style="display: flex; gap: 8px; margin-bottom: 12px;">
									<sl-input id="time-value" type="number" value="1" min="1" max="90" size="small" style="width: 70px;"></sl-input>
									<sl-select id="time-unit" value="hours" size="small" style="flex: 1;">
										<sl-option value="minutes">minutes</sl-option>
										<sl-option value="hours">hours</sl-option>
										<sl-option value="days">days</sl-option>
										<sl-option value="weeks">weeks</sl-option>
									</sl-select>
								</div>
								<sl-button-group style="width: 100%;">
									<sl-button size="small" data-window="60">1h</sl-button>
									<sl-button size="small" data-window="360">6h</sl-button>
									<sl-button size="small" data-window="1440">24h</sl-button>
									<sl-button size="small" data-window="10080">7d</sl-button>
									<sl-button size="small" data-window="43200">30d</sl-button>
								</sl-button-group>
							</div>
						</sl-menu>
					</sl-dropdown>
					<sl-icon-button name="moon" id="theme-toggle" label="Toggle theme"></sl-icon-button>
				</header>
				<aside class="sidebar">
					@Nav(activePage, window)
				</aside>
				<main class="main">
					{ children... }
				</main>
			</div>
			<sl-drawer id="mobile-nav" label="Navigation" placement="start">
				@Nav(activePage, window)
			</sl-drawer>
			<!-- Keyboard Help Dialog -->
			<sl-dialog id="kb-help" label="Keyboard Shortcuts" style="--width: 400px;">
				<div class="kb-help-content">
					<div class="kb-section">
						<div class="kb-section-title">Navigation</div>
						<div class="kb-row"><kbd>g</kbd> <kbd>o</kbd> <span>Overview</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>s</kbd> <span>Services</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>t</kbd> <span>Traces</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>l</kbd> <span>Logs</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>m</kbd> <span>Metrics</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>p</kbd> <span>Topology</span></div>
						<div class="kb-row"><kbd>g</kbd> <kbd>u</kbd> <span>Unified</span></div>
					</div>
					<div class="kb-section">
						<div class="kb-section-title">Tables</div>
						<div class="kb-row"><kbd>j</kbd> <span>Next row</span></div>
						<div class="kb-row"><kbd>k</kbd> <span>Previous row</span></div>
						<div class="kb-row"><kbd>Enter</kbd> <span>Open selected</span></div>
					</div>
					<div class="kb-section">
						<div class="kb-section-title">General</div>
						<div class="kb-row"><kbd>/</kbd> <span>Focus search</span></div>
						<div class="kb-row"><kbd>r</kbd> <span>Refresh data</span></div>
						<div class="kb-row"><kbd>Esc</kbd> <span>Clear / Close</span></div>
						<div class="kb-row"><kbd>?</kbd> <span>Show this help</span></div>
					</div>
				</div>
				<sl-button slot="footer" variant="primary" onclick="this.closest('sl-dialog').hide()">Close</sl-button>
			</sl-dialog>
			<style>
				.kb-help-content { display: flex; flex-direction: column; gap: 1.25rem; }
				.kb-section-title { font-weight: 600; color: var(--text-secondary); margin-bottom: 0.5rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
				.kb-row { display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0; font-size: 0.875rem; }
				.kb-row span { margin-left: auto; color: var(--text-secondary); }
				kbd { display: inline-flex; align-items: center; justify-content: center; min-width: 1.5rem; padding: 0.125rem 0.375rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 0.25rem; font-family: inherit; font-size: 0.75rem; font-weight: 500; }
				.table tbody tr.kb-selected { outline: 2px solid var(--accent); outline-offset: -2px; background: var(--accent-subtle); }
			</style>
		</body>
	</html>
}
