package web

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
)

// UnifiedData contains data for the unified timeline page.
type UnifiedData struct {
	Query       string
	Service     string
	Events      []UnifiedEvent
	SpanCount   int
	LogCount    int
	MetricCount int
	HasMore     bool
	Window      int
	Limit       int
	Offset      int
	Facets      UnifiedFacets
}

// UnifiedFacets contains aggregated counts for filtering
type UnifiedFacets struct {
	ByType    []FacetCount
	ByService []FacetCount
}

// UnifiedEvent represents an event in the unified timeline.
type UnifiedEvent struct {
	Time     string
	Type     string // span, log, metric
	Service  string
	Name     string
	Value    string
	Status   string
	TraceID  string
	SpanID   string
	Severity string
	Duration float64
}

templ Unified(data UnifiedData) {
	@Layout("Unified Timeline", "unified", data.Window) {
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Unified Timeline</h1>
				<p class="page-subtitle">Traces, logs, and metrics in one view</p>
			</div>
		</div>
		<div class="quick-filters">
			<sl-button href={ unifiedURL("", data.Window, data.Limit, 0) } size="small" variant={ unifiedFilterVariant(data.Query, "") }>All</sl-button>
			<sl-button href={ unifiedURL("type:span", data.Window, data.Limit, 0) } size="small" variant={ unifiedFilterVariant(data.Query, "type:span") }>
				<sl-icon slot="prefix" name="diagram-3"></sl-icon>
				Spans
			</sl-button>
			<sl-button href={ unifiedURL("type:log", data.Window, data.Limit, 0) } size="small" variant={ unifiedFilterVariant(data.Query, "type:log") }>
				<sl-icon slot="prefix" name="journal-text"></sl-icon>
				Logs
			</sl-button>
			<sl-button href={ unifiedURL("type:metric", data.Window, data.Limit, 0) } size="small" variant={ unifiedFilterVariant(data.Query, "type:metric") }>
				<sl-icon slot="prefix" name="graph-up"></sl-icon>
				Metrics
			</sl-button>
			<sl-button href={ unifiedURL("status:error", data.Window, data.Limit, 0) } size="small" variant={ unifiedFilterVariant(data.Query, "status:error") }>
				<sl-icon slot="prefix" name="exclamation-triangle"></sl-icon>
				Errors
			</sl-button>
		</div>
		<!-- Search Form -->
		<sl-card style="margin-bottom: 1.5rem;">
			<form method="GET" action="/unified" class="search-form" onsubmit="return cleanUnifiedSubmit(this)">
				<div class="form-row">
					<sl-input name="q" label="Search" placeholder="service:checkout status:error type:span severity:ERROR" value={ data.Query } style="flex: 3;"></sl-input>
					<sl-button type="submit" variant="primary">Search</sl-button>
				</div>
				<div class="search-hint">
					<sl-icon name="lightbulb"></sl-icon>
					<code>service:name</code> <code>type:span|log|metric</code> <code>status:error</code> <code>severity:ERROR</code> <code>op:checkout</code> <code>trace:abc123</code> <code>"phrase"</code> <code>-exclude</code>
				</div>
			</form>
			<script>
				function cleanUnifiedSubmit(form) {
					const url = new URL(form.action, window.location.origin);
					const q = form.querySelector('[name="q"]').value.trim();
					if (q) url.searchParams.set('q', q);
					const ns = new URL(window.location.href).searchParams.get('ns');
					if (ns) url.searchParams.set('ns', ns);
					const win = new URL(window.location.href).searchParams.get('window');
					if (win && win !== '60') url.searchParams.set('window', win);
					htmx.ajax('GET', url.pathname + url.search, {target: 'body', swap: 'innerHTML'});
					history.pushState({}, '', url.toString());
					return false;
				}
			</script>
		</sl-card>
		<!-- Facets -->
		<div class="facets-bar">
			<div class="facet-group">
				<span class="facet-label">Type</span>
				<a href={ unifiedFacetURL(data.Query, "type", "span", data.Window) } class="facet-chip facet-span">
					span <span class="facet-count">{ fmt.Sprintf("%d", data.SpanCount) }</span>
				</a>
				<a href={ unifiedFacetURL(data.Query, "type", "log", data.Window) } class="facet-chip facet-log">
					log <span class="facet-count">{ fmt.Sprintf("%d", data.LogCount) }</span>
				</a>
				<a href={ unifiedFacetURL(data.Query, "type", "metric", data.Window) } class="facet-chip facet-metric">
					metric <span class="facet-count">{ fmt.Sprintf("%d", data.MetricCount) }</span>
				</a>
			</div>
			if len(data.Facets.ByService) > 0 {
				<div class="facet-group">
					<span class="facet-label">Services</span>
					for _, f := range data.Facets.ByService {
						<a href={ unifiedFacetURL(data.Query, "service", f.Value, data.Window) } class="facet-chip">
							{ f.Value } <span class="facet-count">{ fmt.Sprintf("%d", f.Count) }</span>
						</a>
					}
				</div>
			}
		</div>
		<!-- Results -->
		<sl-card>
			<div slot="header" class="card-header">Results ({ fmt.Sprintf("%d", len(data.Events)) } events)</div>
			if len(data.Events) == 0 {
				<div class="empty-state">
					<sl-icon name="layers"></sl-icon>
					<div class="empty-state-title">No events found</div>
					<div class="empty-state-message">Try adjusting your search filters or expanding the time window.</div>
				</div>
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Time</th>
							<th>Type</th>
							<th>Service</th>
							<th>Name</th>
							<th>Value</th>
							<th>Status</th>
							<th>Trace</th>
						</tr>
					</thead>
					<tbody>
						for _, e := range data.Events {
							<tr class={ templ.KV("row-error", e.Status == "error" || e.Severity == "ERROR") }>
								<td class="cell-time">{ formatTime(e.Time) }</td>
								<td>
									<span class={ "type-badge", "type-" + e.Type }>{ e.Type }</span>
								</td>
								<td>
									if e.Service != "" {
										<a href={ templ.SafeURL(withWindow("/services/"+pathEscape(e.Service), data.Window)) }>{ e.Service }</a>
									} else {
										<span style="color: var(--text-muted);">—</span>
									}
								</td>
								<td class="cell-name">{ truncateName(e.Name, 40) }</td>
								<td class="cell-value">{ truncateName(e.Value, 50) }</td>
								<td>
									if e.Type == "span" {
										if e.Status == "error" {
											<sl-badge variant="danger">error</sl-badge>
										} else if e.Status != "" {
											<sl-badge variant="success">ok</sl-badge>
										}
									} else if e.Type == "log" {
										<sl-badge variant={ logSeverityVariant(e.Severity) }>{ e.Severity }</sl-badge>
									} else {
										<span style="color: var(--text-muted);">—</span>
									}
								</td>
								<td>
									if e.TraceID != "" {
										<a href={ templ.SafeURL(withWindow("/traces/"+e.TraceID, data.Window)) } class="trace-link">
											{ truncateID(e.TraceID) }
										</a>
									} else {
										<span style="color: var(--text-muted);">—</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
				<!-- Pagination -->
				if data.Offset > 0 || data.HasMore {
					<div class="pagination">
						if data.Offset > 0 {
							<sl-button href={ unifiedURL(data.Query, data.Window, data.Limit, maxInt(0, data.Offset-data.Limit)) } variant="default" size="small">Previous</sl-button>
						}
						<span class="pagination-info">Showing { fmt.Sprintf("%d", data.Offset+1) }-{ fmt.Sprintf("%d", data.Offset+len(data.Events)) }</span>
						if data.HasMore {
							<sl-button href={ unifiedURL(data.Query, data.Window, data.Limit, data.Offset+data.Limit) } variant="default" size="small">Next</sl-button>
						}
					</div>
				}
			}
		</sl-card>
		<style>
			.search-form .form-row {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				align-items: flex-end;
			}
			.search-form sl-input {
				flex: 1;
				min-width: 200px;
			}
			.search-hint {
				margin-top: 0.75rem;
				font-size: 0.75rem;
				color: var(--text-muted);
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.search-hint sl-icon {
				font-size: 0.875rem;
			}
			.search-hint code {
				background: var(--bg-tertiary);
				padding: 0.125rem 0.375rem;
				border-radius: 0.25rem;
				font-size: 0.7rem;
			}
			.facets-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				padding: 0.75rem 1rem;
				background: var(--bg-secondary);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				margin-bottom: 1rem;
			}
			.facet-group {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.facet-label {
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--text-muted);
				text-transform: uppercase;
			}
			.facet-chip {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				padding: 2px 8px;
				background: var(--bg-tertiary);
				border-radius: 12px;
				font-size: 0.75rem;
				color: var(--text-primary);
				text-decoration: none;
				transition: background 0.15s;
			}
			.facet-chip:hover {
				background: var(--sl-color-primary-100);
				color: var(--sl-color-primary-700);
			}
			.facet-chip.facet-span {
				background: rgba(99, 102, 241, 0.1);
				color: #6366f1;
			}
			.facet-chip.facet-span:hover {
				background: rgba(99, 102, 241, 0.2);
			}
			.facet-chip.facet-log {
				background: rgba(245, 158, 11, 0.1);
				color: #d97706;
			}
			.facet-chip.facet-log:hover {
				background: rgba(245, 158, 11, 0.2);
			}
			.facet-chip.facet-metric {
				background: rgba(34, 197, 94, 0.1);
				color: #16a34a;
			}
			.facet-chip.facet-metric:hover {
				background: rgba(34, 197, 94, 0.2);
			}
			.facet-count {
				font-weight: 600;
				opacity: 0.8;
			}
			.type-badge {
				display: inline-block;
				font-size: 0.65rem;
				font-weight: 600;
				text-transform: uppercase;
				padding: 2px 6px;
				border-radius: 4px;
			}
			.type-span {
				background: rgba(99, 102, 241, 0.15);
				color: #6366f1;
			}
			.type-log {
				background: rgba(245, 158, 11, 0.15);
				color: #d97706;
			}
			.type-metric {
				background: rgba(34, 197, 94, 0.15);
				color: #16a34a;
			}
			.cell-time {
				font-family: monospace;
				font-size: 0.8rem;
				white-space: nowrap;
			}
			.cell-name {
				font-family: monospace;
				font-size: 0.8rem;
				max-width: 250px;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.cell-value {
				font-size: 0.8rem;
				color: var(--text-secondary);
				max-width: 200px;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.trace-link {
				font-family: monospace;
				font-size: 0.75rem;
				color: var(--accent);
				text-decoration: none;
			}
			.trace-link:hover {
				text-decoration: underline;
			}
			.row-error {
				background: rgba(239, 68, 68, 0.05);
			}
			.row-error:hover td {
				background: rgba(239, 68, 68, 0.1) !important;
			}
			.pagination {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				padding: 1rem;
				border-top: 1px solid var(--border-color);
				margin-top: 1rem;
			}
			.pagination-info {
				color: var(--text-muted);
				font-size: 0.875rem;
			}
		</style>
	}
}

func formatTime(ts string) string {
	// Extract time portion from ISO timestamp
	if len(ts) >= 19 {
		return ts[11:19] // HH:MM:SS
	}
	return ts
}

func truncateName(s string, max int) string {
	if len(s) > max {
		return s[:max-3] + "..."
	}
	return s
}

func unifiedURL(q string, window, limit, offset int) templ.SafeURL {
	values := url.Values{}
	if q != "" {
		values.Set("q", q)
	}
	if window != 60 {
		values.Set("window", strconv.Itoa(window))
	}
	if limit != 100 && limit > 0 {
		values.Set("limit", strconv.Itoa(limit))
	}
	if offset > 0 {
		values.Set("offset", strconv.Itoa(offset))
	}
	if len(values) == 0 {
		return "/unified"
	}
	return templ.SafeURL("/unified?" + values.Encode())
}

func unifiedFilterVariant(current, target string) string {
	if target == "" && current == "" {
		return "primary"
	}
	if target != "" && strings.Contains(current, target) {
		return "primary"
	}
	return "default"
}

func unifiedFacetURL(query, facetType, value string, window int) templ.SafeURL {
	newQuery := query
	prefix := facetType + ":"
	if strings.Contains(query, prefix+value) {
		return unifiedURL(query, window, 0, 0)
	}
	if newQuery != "" {
		newQuery += " "
	}
	newQuery += prefix + value
	return unifiedURL(newQuery, window, 0, 0)
}

func maxInt(a, b int) int {
	if a > b {
		return a
	}
	return b
}
