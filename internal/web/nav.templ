package web

// NavItem represents a navigation menu item
type NavItem struct {
	Icon   string
	Label  string
	Href   string
	Active bool
}

// Nav renders the sidebar navigation
templ Nav(active string, window int) {
	<nav class="nav">
		@navItem("house-door", "Overview", "/", active == "overview", window)
		@navItem("hdd-stack", "Services", "/services", active == "services", window)
		@navItem("share", "Topology", "/topology", active == "topology", window)
		@navItem("layers", "Unified", "/unified", active == "unified", window)
		@navItem("diagram-3", "Traces", "/traces", active == "traces", window)
		@navItem("file-text", "Logs", "/logs", active == "logs", window)
		@navItem("graph-up", "Metrics", "/metrics", active == "metrics", window)
		@navItem("file-earmark-richtext", "Reports", "/reports", active == "reports", window)
	</nav>
}

templ navItem(icon, label, href string, active bool, window int) {
	<a
		href={ templ.SafeURL(withWindow(href, window)) }
		class={ "nav-item", templ.KV("active", active) }
	>
		<sl-icon name={ icon }></sl-icon>
		<span>{ label }</span>
	</a>
}
