package web

import (
	"encoding/json"
	"fmt"
)

// ServicesData for the services list page
type ServicesData struct {
	Services []ServiceRow
	Filter   string // "all", "errors", "slow"
	Window   int
}

// UniqueNamespace returns the namespace if all services share it, empty otherwise
func (d ServicesData) UniqueNamespace() string {
	if len(d.Services) == 0 {
		return ""
	}
	ns := d.Services[0].Namespace
	for _, s := range d.Services[1:] {
		if s.Namespace != ns {
			return ""
		}
	}
	return ns
}

type ServiceRow struct {
	Name      string
	Namespace string
	Status    string
	SpanCount int64
	P95Ms     float64
	ErrorRate float64
	Trend     []int64 // Last 12 5-min buckets of request counts
}

// Services renders the services list page
templ Services(data ServicesData) {
	@Layout("Services", "services", data.Window) {
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Services</h1>
				<p class="page-subtitle">
					{ fmt.Sprintf("%d services", len(data.Services)) }
					if ns := data.UniqueNamespace(); ns != "" {
						<span>in </span><sl-tag size="small" class="ns-tag">{ ns }</sl-tag>
					}
				</p>
			</div>
		</div>
		<div class="quick-filters">
			<sl-button href={ withWindow("/services", data.Window) } size="small" variant={ filterVariant(data.Filter, "") }>All</sl-button>
			<sl-button href={ withWindow("/services?filter=errors", data.Window) } size="small" variant={ filterVariant(data.Filter, "errors") }>
				<sl-icon slot="prefix" name="exclamation-triangle"></sl-icon>
				Errors
			</sl-button>
			<sl-button href={ withWindow("/services?filter=slow", data.Window) } size="small" variant={ filterVariant(data.Filter, "slow") }>
				<sl-icon slot="prefix" name="clock"></sl-icon>
				Slow
			</sl-button>
		</div>
		<sl-card>
			if len(data.Services) == 0 {
				@EmptyStateSetup("services")
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Service</th>
							if data.UniqueNamespace() == "" {
								<th>Namespace</th>
							}
							<th>Status</th>
							<th>Trend</th>
							<th>Requests</th>
							<th>P95 Latency</th>
							<th>Error Rate</th>
						</tr>
					</thead>
					<tbody>
						for _, svc := range data.Services {
							<tr>
								<td><a href={ templ.SafeURL(withWindow("/services/"+pathEscape(svc.Name), data.Window)) }>{ svc.Name }</a></td>
								if data.UniqueNamespace() == "" {
									<td>
										if svc.Namespace != "" {
											<sl-tag size="small" class="ns-tag">{ svc.Namespace }</sl-tag>
										} else {
											<span style="color: var(--text-muted);">—</span>
										}
									</td>
								}
								<td>
									<sl-badge variant={ statusVariant(svc.Status) } pill>{ svc.Status }</sl-badge>
								</td>
								<td>
									<sl-tooltip content={ sparklineTooltip(svc.Trend) }>
										@Sparkline(svc.Trend, svc.ErrorRate > 0.05)
									</sl-tooltip>
								</td>
								<td>{ fmt.Sprintf("%d", svc.SpanCount) }</td>
								<td>{ fmt.Sprintf("%.0fms", svc.P95Ms) }</td>
								<td>{ fmt.Sprintf("%.1f%%", svc.ErrorRate*100) }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</sl-card>
	}
}

// ServiceDetailData for the service detail page
type ServiceDetailData struct {
	Name         string
	Namespace    string
	Status       string
	P50Ms        float64
	P95Ms        float64
	P99Ms        float64
	ErrorRate    float64
	SpanCount    int64
	TopErrors    []ErrorInfo
	SlowOps      []SlowOp
	Dependencies []Dependency
	Timeline     []TimelinePoint
	Window       int
}

// TimelinePoint represents a single data point for charts
type TimelinePoint struct {
	Time         string
	RequestCount int64
	ErrorCount   int64
	P50Ms        float64
	P95Ms        float64
	ErrorRate    float64
}

type ErrorInfo struct {
	Operation string
	Count     int64
	TraceID   string
	Message   string
}

type SlowOp struct {
	Operation string
	P95Ms     float64
	Count     int64
}

type Dependency struct {
	Service   string
	CallCount int64
	AvgMs     float64
	ErrorRate float64
	Status    string
}

// ServiceDetail renders the service detail page
templ ServiceDetail(data ServiceDetailData) {
	@Layout(data.Name, "services", data.Window) {
		<nav class="breadcrumbs">
			<sl-breadcrumb>
				<sl-breadcrumb-item href={ withWindow("/", data.Window) }>Overview</sl-breadcrumb-item>
				<sl-breadcrumb-item href={ withWindow("/services", data.Window) }>Services</sl-breadcrumb-item>
				<sl-breadcrumb-item>{ data.Name }</sl-breadcrumb-item>
			</sl-breadcrumb>
		</nav>
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">
					{ data.Name }
					<sl-badge variant={ statusVariant(data.Status) } pill style="margin-left: 0.75rem; vertical-align: middle;">{ data.Status }</sl-badge>
				</h1>
				<p class="page-subtitle">
					if data.Namespace != "" {
						<sl-tag size="small" class="ns-tag" style="margin-right: 0.5rem;">{ data.Namespace }</sl-tag>
					}
					Service diagnostics
				</p>
			</div>
		</div>
		<!-- Latency Metrics -->
		<div class="grid grid-4" style="margin-bottom: 1rem;">
			<sl-card class="metric-card">
				<div class="metric-value">{ fmt.Sprintf("%.0f", data.P50Ms) }ms</div>
				<div class="metric-label">P50 Latency</div>
			</sl-card>
			<sl-card class="metric-card">
				<div class="metric-value">{ fmt.Sprintf("%.0f", data.P95Ms) }ms</div>
				<div class="metric-label">P95 Latency</div>
			</sl-card>
			<sl-card class="metric-card">
				<div class="metric-value">{ fmt.Sprintf("%.0f", data.P99Ms) }ms</div>
				<div class="metric-label">P99 Latency</div>
			</sl-card>
			<sl-card class="metric-card">
				<div class="metric-value" style={ errorColor(data.ErrorRate) }>{ fmt.Sprintf("%.1f", data.ErrorRate*100) }%</div>
				<div class="metric-label">Error Rate</div>
			</sl-card>
		</div>
		<!-- Trend Charts -->
		if len(data.Timeline) > 1 {
			<div class="grid grid-2" style="margin-bottom: 1rem;">
				<sl-card>
					<div slot="header" class="card-header">Latency Trend</div>
					<div class="chart" style="height: 200px;" data-vega={ latencyChartSpec(data.Timeline) }></div>
				</sl-card>
				<sl-card>
					<div slot="header" class="card-header">Request Volume</div>
					<div class="chart" style="height: 200px;" data-vega={ requestChartSpec(data.Timeline) }></div>
				</sl-card>
			</div>
		}
		<div class="grid grid-2" style="margin-bottom: 1rem;">
			<!-- Top Errors -->
			<sl-card>
				<div slot="header" class="card-header">Top Errors</div>
				if len(data.TopErrors) == 0 {
					<div class="empty-inline success">
						<sl-icon name="check-circle"></sl-icon>
						<span>No errors detected</span>
					</div>
				} else {
					<table class="table">
						<thead>
							<tr>
								<th>Operation</th>
								<th>Count</th>
								<th>Example Trace</th>
							</tr>
						</thead>
						<tbody>
							for _, err := range data.TopErrors {
								<tr>
									<td>{ err.Operation }</td>
									<td>{ fmt.Sprintf("%d", err.Count) }</td>
									<td>
										if err.TraceID != "" {
											<a href={ templ.SafeURL(withWindow("/traces/"+pathEscape(err.TraceID), data.Window)) }>{ truncateStr(err.TraceID, 12) }</a>
										} else {
											<span style="color: var(--text-muted);">-</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</sl-card>
			<!-- Slow Operations -->
			<sl-card>
				<div slot="header" class="card-header">Slow Operations</div>
				if len(data.SlowOps) == 0 {
					<div class="empty-inline success">
						<sl-icon name="check-circle"></sl-icon>
						<span>No slow operations</span>
					</div>
				} else {
					<table class="table">
						<thead>
							<tr>
								<th>Operation</th>
								<th>P95 Latency</th>
								<th>Count</th>
							</tr>
						</thead>
						<tbody>
							for _, op := range data.SlowOps {
								<tr>
									<td>{ op.Operation }</td>
									<td>{ fmt.Sprintf("%.0fms", op.P95Ms) }</td>
									<td>{ fmt.Sprintf("%d", op.Count) }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</sl-card>
		</div>
		<!-- Dependencies -->
		<sl-card>
			<div slot="header" class="card-header">Downstream Dependencies</div>
			if len(data.Dependencies) == 0 {
				<div class="empty-inline">
					<sl-icon name="diagram-3"></sl-icon>
					<span>No downstream calls detected</span>
				</div>
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Service</th>
							<th>Status</th>
							<th>Calls</th>
							<th>Avg Latency</th>
							<th>Error Rate</th>
						</tr>
					</thead>
					<tbody>
						for _, dep := range data.Dependencies {
							<tr>
								<td><a href={ templ.SafeURL(withWindow("/services/"+pathEscape(dep.Service), data.Window)) }>{ dep.Service }</a></td>
								<td>
									<sl-badge variant={ statusVariant(dep.Status) } pill>{ dep.Status }</sl-badge>
								</td>
								<td>{ fmt.Sprintf("%d", dep.CallCount) }</td>
								<td>{ fmt.Sprintf("%.0fms", dep.AvgMs) }</td>
								<td>{ fmt.Sprintf("%.1f%%", dep.ErrorRate*100) }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</sl-card>
	}
}

func errorColor(rate float64) string {
	if rate > 0.1 {
		return "color: var(--danger);"
	}
	if rate > 0.01 {
		return "color: var(--warning);"
	}
	return "color: var(--success);"
}

func filterVariant(current, target string) string {
	if current == target || (current == "" && target == "") {
		return "primary"
	}
	return "default"
}

// Sparkline renders an SVG sparkline chart
templ Sparkline(data []int64, isError bool) {
	if len(data) == 0 {
		<span class="sparkline">-</span>
	} else {
		<span class={ "sparkline", sparklineClass(isError) }>
			<svg width="80" height="20" viewBox="0 0 80 20">
				<polyline class="sparkline-line" points={ sparklinePoints(data) } fill="none"></polyline>
			</svg>
		</span>
	}
}

func sparklineClass(isError bool) string {
	if isError {
		return "sparkline-error"
	}
	return ""
}

func sparklinePoints(data []int64) string {
	if len(data) == 0 {
		return ""
	}

	// Find max for normalization
	var max int64 = 1
	for _, v := range data {
		if v > max {
			max = v
		}
	}

	// Generate points
	points := ""
	w := 80.0 / float64(len(data)-1)
	for i, v := range data {
		x := float64(i) * w
		y := 18.0 - (float64(v)/float64(max))*16.0 // Leave 2px margin top/bottom
		if i > 0 {
			points += " "
		}
		points += fmt.Sprintf("%.1f,%.1f", x, y)
	}
	return points
}

func sparklineTooltip(data []int64) string {
	if len(data) == 0 {
		return "No data"
	}
	var total int64
	for _, v := range data {
		total += v
	}
	return fmt.Sprintf("Last %d intervals: %d requests", len(data), total)
}

// latencyChartSpec generates a Vega-Lite spec for latency trend
func latencyChartSpec(data []TimelinePoint) string {
	values := make([]map[string]any, len(data))
	for i, p := range data {
		values[i] = map[string]any{
			"time": p.Time,
			"p50":  p.P50Ms,
			"p95":  p.P95Ms,
		}
	}

	spec := map[string]any{
		"$schema": "https://vega.github.io/schema/vega-lite/v6.json",
		"width":   "container",
		"height":  180,
		"data":    map[string]any{"values": values},
		"layer": []map[string]any{
			{
				"mark": map[string]any{"type": "area", "opacity": 0.2, "color": "#f59e0b"},
				"encoding": map[string]any{
					"x": map[string]any{
						"field":    "time",
						"type":     "temporal",
						"timeUnit": "yearmonthdatehoursminutes",
						"axis":     map[string]any{"title": nil, "format": "%H:%M", "labelAngle": 0, "tickCount": 6},
					},
					"y": map[string]any{"field": "p95", "type": "quantitative", "axis": map[string]any{"title": "Latency (ms)"}},
				},
			},
			{
				"mark": map[string]any{"type": "line", "strokeWidth": 2, "color": "#f59e0b"},
				"encoding": map[string]any{
					"x": map[string]any{"field": "time", "type": "temporal", "timeUnit": "yearmonthdatehoursminutes"},
					"y": map[string]any{"field": "p95", "type": "quantitative"},
				},
			},
			{
				"mark": map[string]any{"type": "line", "strokeWidth": 2, "color": "#0ea5e9"},
				"encoding": map[string]any{
					"x": map[string]any{"field": "time", "type": "temporal", "timeUnit": "yearmonthdatehoursminutes"},
					"y": map[string]any{"field": "p50", "type": "quantitative"},
				},
			},
		},
	}

	b, _ := json.Marshal(spec)
	return string(b)
}

// requestChartSpec generates a Vega-Lite spec for request volume with error rate
func requestChartSpec(data []TimelinePoint) string {
	values := make([]map[string]any, len(data))
	for i, p := range data {
		values[i] = map[string]any{
			"time":     p.Time,
			"requests": p.RequestCount,
			"errors":   p.ErrorCount,
			"errRate":  p.ErrorRate * 100,
		}
	}

	spec := map[string]any{
		"$schema": "https://vega.github.io/schema/vega-lite/v6.json",
		"width":   "container",
		"height":  180,
		"data":    map[string]any{"values": values},
		"layer": []map[string]any{
			{
				"mark": map[string]any{"type": "bar", "color": "#0ea5e9", "opacity": 0.6},
				"encoding": map[string]any{
					"x": map[string]any{
						"field":    "time",
						"type":     "temporal",
						"timeUnit": "yearmonthdatehoursminutes",
						"axis":     map[string]any{"title": nil, "format": "%H:%M", "labelAngle": 0, "tickCount": 6},
					},
					"y": map[string]any{"field": "requests", "type": "quantitative", "axis": map[string]any{"title": "Requests"}},
				},
			},
			{
				"mark": map[string]any{"type": "line", "strokeWidth": 2, "color": "#ef4444"},
				"encoding": map[string]any{
					"x": map[string]any{"field": "time", "type": "temporal", "timeUnit": "yearmonthdatehoursminutes"},
					"y": map[string]any{
						"field": "errRate",
						"type":  "quantitative",
						"axis":  map[string]any{"title": "Error %", "orient": "right"},
						"scale": map[string]any{"domain": []int{0, 100}},
					},
				},
			},
		},
		"resolve": map[string]any{"scale": map[string]any{"y": "independent"}},
	}

	b, _ := json.Marshal(spec)
	return string(b)
}
