package web

import (
	"encoding/json"
	"fmt"
)

// Topology renders the service topology page (uses TopologyData from overview.templ)
templ Topology(data TopologyData) {
	@Layout("Topology", "topology", data.Window) {
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Service Topology</h1>
				<p class="page-subtitle">Service dependency map showing call relationships</p>
			</div>
		</div>
		if len(data.Nodes) == 0 {
			<sl-card>
				@EmptyStateSetup("topology")
			</sl-card>
		} else {
			<!-- Summary Stats -->
			<div class="grid grid-4" style="margin-bottom: 1rem;">
				<sl-card class="metric-card">
					<div class="metric-value">{ fmt.Sprintf("%d", len(data.Nodes)) }</div>
					<div class="metric-label">Services</div>
				</sl-card>
				<sl-card class="metric-card">
					<div class="metric-value">{ fmt.Sprintf("%d", len(data.Edges)) }</div>
					<div class="metric-label">Connections</div>
				</sl-card>
				<sl-card class="metric-card">
					<div class="metric-value" style="color: var(--warning);">{ fmt.Sprintf("%d", countByStatus(data.Nodes, "degraded")) }</div>
					<div class="metric-label">Degraded</div>
				</sl-card>
				<sl-card class="metric-card">
					<div class="metric-value" style="color: var(--danger);">{ fmt.Sprintf("%d", countByStatus(data.Nodes, "unhealthy")) }</div>
					<div class="metric-label">Unhealthy</div>
				</sl-card>
			</div>
			<!-- Legend -->
			<sl-card style="margin-bottom: 1rem;">
				<div class="topo-legend">
					<div class="topo-legend-group">
						<span class="topo-legend-title">Nodes:</span>
						<span><span style="color: var(--success);">●</span> Healthy</span>
						<span><span style="color: var(--warning);">●</span> Degraded</span>
						<span><span style="color: var(--danger);">●</span> Unhealthy</span>
					</div>
					<div class="topo-legend-group">
						<span class="topo-legend-title">Edges:</span>
						<span><span class="topo-edge-sample topo-edge-ok"></span> Low errors</span>
						<span><span class="topo-edge-sample topo-edge-warn"></span> Some errors</span>
						<span><span class="topo-edge-sample topo-edge-error"></span> High errors</span>
					</div>
					<span style="color: var(--text-muted); margin-left: auto;">Click node for details • Edge thickness = call volume</span>
				</div>
			</sl-card>
			<!-- Topology Graph -->
			<sl-card style="position: relative;">
				<div class="topo-controls">
					<sl-button-group>
						<sl-icon-button id="topo-zoom-in" name="zoom-in" label="Zoom in"></sl-icon-button>
						<sl-icon-button id="topo-zoom-out" name="zoom-out" label="Zoom out"></sl-icon-button>
						<sl-icon-button id="topo-reset" name="arrows-angle-contract" label="Reset"></sl-icon-button>
					</sl-button-group>
				</div>
				<div id="topology-wrapper" class="topology-wrapper">
					<div id="topology-graph" class="topology-container" data-nodes={ topoNodesJSON(data.Nodes) } data-edges={ topoEdgesJSON(data.Edges) } data-window={ fmt.Sprintf("%d", data.Window) }></div>
				</div>
			</sl-card>
			<script>
				(function() {
					const container = document.getElementById('topology-graph');
					const nodes = JSON.parse(container.dataset.nodes);
					const edges = JSON.parse(container.dataset.edges);
					const isDark = document.body.classList.contains('sl-theme-dark');
					const textColor = isDark ? '#f1f5f9' : '#0f172a';

					// Build Vega spec for force-directed graph
					const nodeCount = nodes.length;
					const graphHeight = Math.max(550, Math.min(700, nodeCount * 30));
					const spec = {
						"$schema": "https://vega.github.io/schema/vega/v5.json",
						"width": 900,
						"height": graphHeight,
						"padding": 40,
						"autosize": "none",

						"signals": [
							{ "name": "cx", "update": "width / 2" },
							{ "name": "cy", "update": "height / 2" },
							{ "name": "nodeRadius", "value": 20 },
							{ "name": "linkDistance", "value": 100 },
							{ "name": "textColor", "value": textColor }
						],

						"data": [
							{
								"name": "node-data",
								"values": nodes,
								"transform": [
									{
										"type": "formula",
										"as": "color",
										"expr": "datum.status === 'unhealthy' ? '#ef4444' : datum.status === 'degraded' ? '#f59e0b' : '#22c55e'"
									}
								]
							},
							{
								"name": "link-data",
								"values": edges
							}
						],

						"scales": [
							{
								"name": "nodeSize",
								"type": "sqrt",
								"domain": {"data": "node-data", "field": "spanCount"},
								"range": [300, 2000]
							},
							{
								"name": "edgeWidth",
								"type": "sqrt",
								"domain": {"data": "link-data", "field": "callCount"},
								"range": [1.5, 6]
							},
							{
								"name": "edgeColor",
								"type": "threshold",
								"domain": [0.01, 0.05],
								"range": ["#94a3b8", "#f59e0b", "#ef4444"]
							}
						],

						"marks": [
							{
								"name": "links",
								"type": "path",
								"from": {"data": "link-data"},
								"interactive": true,
								"encode": {
									"enter": {
										"tooltip": {"signal": "'Calls: ' + datum.callCount + ' | Errors: ' + format(datum.errorRate * 100, '.1f') + '%'"}
									},
									"update": {
										"stroke": {"scale": "edgeColor", "field": "errorRate"},
										"strokeWidth": {"scale": "edgeWidth", "field": "callCount"},
										"strokeOpacity": {"value": 0.7}
									}
								},
								"transform": [
									{
										"type": "linkpath",
										"require": {"signal": "force"},
										"shape": "line",
										"sourceX": "datum.source.x",
										"sourceY": "datum.source.y",
										"targetX": "datum.target.x",
										"targetY": "datum.target.y"
									}
								]
							},
							{
								"name": "nodes",
								"type": "symbol",
								"from": {"data": "node-data"},
								"encode": {
									"enter": {
										"fill": {"field": "color"},
										"stroke": {"value": "white"},
										"strokeWidth": {"value": 2},
										"cursor": {"value": "pointer"},
										"tooltip": {"signal": "datum.name + ' | P95: ' + format(datum.p95Ms, '.0f') + 'ms | Errors: ' + format(datum.errorRate * 100, '.1f') + '%'"}
									},
									"update": {
										"size": {"scale": "nodeSize", "field": "spanCount"},
										"fill": {"field": "color"}
									}
								},
								"transform": [
									{
										"type": "force",
										"iterations": 300,
										"restart": {"signal": "linkDistance"},
										"signal": "force",
										"forces": [
											{"force": "center", "x": {"signal": "cx"}, "y": {"signal": "cy"}},
											{"force": "collide", "radius": {"signal": "nodeRadius + 15"}},
											{"force": "nbody", "strength": -80},
											{"force": "link", "links": "link-data", "distance": {"signal": "linkDistance"}, "id": "datum.name"}
										]
									}
								]
							},
							{
								"type": "text",
								"from": {"data": "nodes"},
								"encode": {
									"enter": {
										"text": {"field": "datum.name"},
										"fontSize": {"value": 11},
										"fontWeight": {"value": "600"},
										"fill": {"signal": "textColor"},
										"align": {"value": "center"},
										"baseline": {"value": "middle"},
										"dy": {"value": 32}
									},
									"update": {
										"x": {"field": "x"},
										"y": {"field": "y"}
									}
								}
							}
						]
					};

					// Render with Vega
					vegaEmbed('#topology-graph', spec, {
						actions: false,
						renderer: 'svg',
						theme: isDark ? 'dark' : undefined
						}).then(result => {
							const windowMinutes = parseInt(container.dataset.window, 10);
							// Add click handler
							result.view.addEventListener('click', (event, item) => {
								if (item && item.datum && item.datum.name) {
									let href = '/services/' + encodeURIComponent(item.datum.name);
									if (windowMinutes !== 60) {
										href += '?window=' + encodeURIComponent(windowMinutes);
									}
									htmx.ajax('GET', href, {target: 'body', swap: 'innerHTML'});
									history.pushState({}, '', href);
								}
							});
						});

					// Zoom controls
					const wrapper = document.getElementById('topology-wrapper');
					let scale = 1;
					let panX = 0, panY = 0;
					let isPanning = false;
					let startX, startY;

					function updateTransform() {
						container.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
					}

					document.getElementById('topo-zoom-in').addEventListener('click', () => {
						scale = Math.min(scale * 1.25, 3);
						updateTransform();
					});

					document.getElementById('topo-zoom-out').addEventListener('click', () => {
						scale = Math.max(scale / 1.25, 0.5);
						updateTransform();
					});

					document.getElementById('topo-reset').addEventListener('click', () => {
						scale = 1;
						panX = 0;
						panY = 0;
						updateTransform();
					});

					// Pan with mouse drag
					wrapper.addEventListener('mousedown', (e) => {
						if (e.target.closest('svg')) {
							isPanning = true;
							startX = e.clientX - panX;
							startY = e.clientY - panY;
							wrapper.style.cursor = 'grabbing';
						}
					});

					window.addEventListener('mousemove', (e) => {
						if (!isPanning) return;
						panX = e.clientX - startX;
						panY = e.clientY - startY;
						updateTransform();
					});

					window.addEventListener('mouseup', () => {
						isPanning = false;
						wrapper.style.cursor = 'grab';
					});

					// Zoom with scroll wheel
					wrapper.addEventListener('wheel', (e) => {
						e.preventDefault();
						const delta = e.deltaY > 0 ? 0.9 : 1.1;
						scale = Math.max(0.5, Math.min(3, scale * delta));
						updateTransform();
					}, { passive: false });
				})();
			</script>
		}
		<style>
			.topo-controls {
				position: absolute;
				top: 0.75rem;
				right: 0.75rem;
				z-index: 10;
			}
			.topology-wrapper {
				overflow: hidden;
				min-height: 540px;
				cursor: grab;
			}
			.topology-container {
				min-height: 540px;
				display: flex;
				align-items: center;
				justify-content: center;
				transform-origin: center center;
				transition: transform 0.1s ease-out;
			}
			.topology-container svg {
				max-width: none;
			}
			.topo-legend {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				align-items: center;
				font-size: 0.875rem;
			}
			.topo-legend-group {
				display: flex;
				gap: 1rem;
				align-items: center;
			}
			.topo-legend-title {
				font-weight: 600;
				color: var(--text-muted);
			}
			.topo-edge-sample {
				display: inline-block;
				width: 24px;
				height: 3px;
				vertical-align: middle;
				margin-right: 0.25rem;
				border-radius: 1px;
			}
			.topo-edge-ok { background: #94a3b8; }
			.topo-edge-warn { background: #f59e0b; }
			.topo-edge-error { background: #ef4444; }
		</style>
	}
}

func topoNodesJSON(nodes []ServiceNode) string {
	type jsNode struct {
		Name      string  `json:"name"`
		Status    string  `json:"status"`
		SpanCount int64   `json:"spanCount"`
		P95Ms     float64 `json:"p95Ms"`
		ErrorRate float64 `json:"errorRate"`
	}
	var out []jsNode
	for _, n := range nodes {
		out = append(out, jsNode{
			Name:      n.Name,
			Status:    n.Status,
			SpanCount: n.SpanCount,
			P95Ms:     n.P95Ms,
			ErrorRate: n.ErrorRate,
		})
	}
	b, _ := json.Marshal(out)
	return string(b)
}

func topoEdgesJSON(edges []ServiceEdge) string {
	// Convert to source/target format for Vega
	type vegaEdge struct {
		Source    string  `json:"source"`
		Target    string  `json:"target"`
		CallCount int64   `json:"callCount"`
		ErrorRate float64 `json:"errorRate"`
	}
	var out []vegaEdge
	for _, e := range edges {
		out = append(out, vegaEdge{
			Source:    e.From,
			Target:    e.To,
			CallCount: e.CallCount,
			ErrorRate: e.ErrorRate,
		})
	}
	b, _ := json.Marshal(out)
	return string(b)
}

// Format large numbers
func topoFormatCount(n int64) string {
	if n >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(n)/1000000)
	}
	if n >= 1000 {
		return fmt.Sprintf("%.1fK", float64(n)/1000)
	}
	return fmt.Sprintf("%d", n)
}

// countByStatus counts nodes with a specific status
func countByStatus(nodes []ServiceNode, status string) int {
	count := 0
	for _, n := range nodes {
		if n.Status == status {
			count++
		}
	}
	return count
}
