package web

import "fmt"

// LogsData for the logs search page
type LogsData struct {
	Query    string
	Service  string
	Severity string
	Logs     []LogRow
	// Pagination
	Limit   int
	Offset  int
	HasMore bool
}

type LogRow struct {
	Time     string
	Service  string
	Severity string
	Body     string
	TraceID  string
}

// Logs renders the logs search page
templ Logs(data LogsData) {
	@Layout("Logs", "logs") {
		<div class="page-header">
			<h1 class="page-title">Logs</h1>
			<p class="page-subtitle">Search application logs</p>
		</div>
		<!-- Search Form -->
		<div class="card" style="margin-bottom: 1.5rem;">
			<form method="GET" action="/logs" class="search-form">
				<div class="form-row">
					<div class="form-group">
						<label for="q">Search</label>
						<input type="text" name="q" id="q" placeholder="Log message pattern..." value={ data.Query }/>
					</div>
					<div class="form-group">
						<label for="service">Service</label>
						<input type="text" name="service" id="service" placeholder="All services" value={ data.Service }/>
					</div>
					<div class="form-group">
						<label for="severity">Severity</label>
						<select name="severity" id="severity">
							<option value="" selected?={ data.Severity == "" }>All</option>
							<option value="DEBUG" selected?={ data.Severity == "DEBUG" }>DEBUG</option>
							<option value="INFO" selected?={ data.Severity == "INFO" }>INFO</option>
							<option value="WARN" selected?={ data.Severity == "WARN" }>WARN</option>
							<option value="ERROR" selected?={ data.Severity == "ERROR" }>ERROR</option>
							<option value="FATAL" selected?={ data.Severity == "FATAL" }>FATAL</option>
						</select>
					</div>
					<div class="form-group" style="align-self: flex-end;">
						<button type="submit" class="btn btn-primary">Search</button>
					</div>
				</div>
			</form>
		</div>
		<!-- Results -->
		<div class="card">
			<div class="card-title">Results ({ fmt.Sprintf("%d", len(data.Logs)) } logs)</div>
			if len(data.Logs) == 0 {
				<p style="color: var(--text-muted); text-align: center; padding: 2rem;">No logs found</p>
			} else {
				<div class="logs-list">
					for _, log := range data.Logs {
						<div class={ "log-entry", logEntryClass(log.Severity) }>
							<div class="log-header">
								<span class={ "severity", severityClass(log.Severity) }>{ log.Severity }</span>
								<span class="time">{ log.Time }</span>
								<a href={ templ.SafeURL("/services/" + log.Service) } class="service">{ log.Service }</a>
								if log.TraceID != "" {
									<a href={ templ.SafeURL("/traces/" + log.TraceID) } class="trace-link">trace</a>
								}
							</div>
							<div class="log-body">{ log.Body }</div>
						</div>
					}
				</div>
				<!-- Pagination -->
				if data.Offset > 0 || data.HasMore {
					<div class="pagination">
						if data.Offset > 0 {
							<a href={ templ.SafeURL(logsPaginationURL("/logs", data.Query, data.Service, data.Severity, data.Limit, data.Offset-data.Limit)) } class="btn btn-secondary">Previous</a>
						}
						<span class="pagination-info">Showing { fmt.Sprintf("%d", data.Offset+1) }-{ fmt.Sprintf("%d", data.Offset+len(data.Logs)) }</span>
						if data.HasMore {
							<a href={ templ.SafeURL(logsPaginationURL("/logs", data.Query, data.Service, data.Severity, data.Limit, data.Offset+data.Limit)) } class="btn btn-secondary">Next</a>
						}
					</div>
				}
			}
		</div>
		<style>
			.search-form .form-row {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.form-group {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				min-width: 150px;
				flex: 1;
			}
			.form-group label {
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--text-secondary);
				text-transform: uppercase;
			}
			.form-group input, .form-group select {
				padding: 0.5rem 0.75rem;
				border: 1px solid var(--border-color);
				border-radius: 0.375rem;
				font-size: 0.875rem;
				background: var(--bg-secondary);
				color: var(--text-primary);
			}
			.btn {
				padding: 0.5rem 1rem;
				border: none;
				border-radius: 0.375rem;
				font-size: 0.875rem;
				font-weight: 500;
				cursor: pointer;
			}
			.btn-primary {
				background: var(--accent);
				color: white;
			}
			.btn-primary:hover {
				background: var(--accent-hover);
			}
			.logs-list {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.log-entry {
				padding: 0.75rem;
				border-radius: 0.375rem;
				border-left: 3px solid var(--border-color);
				background: var(--bg-tertiary);
			}
			.log-entry-error {
				border-left-color: var(--danger);
				background: #fee2e2;
			}
			.log-entry-warn {
				border-left-color: var(--warning);
				background: #fef3c7;
			}
			.sl-theme-dark .log-entry-error {
				background: rgba(239, 68, 68, 0.1);
			}
			.sl-theme-dark .log-entry-warn {
				background: rgba(245, 158, 11, 0.1);
			}
			.log-header {
				display: flex;
				gap: 1rem;
				align-items: center;
				margin-bottom: 0.5rem;
				font-size: 0.75rem;
			}
			.severity {
				padding: 0.125rem 0.5rem;
				border-radius: 4px;
				font-weight: 600;
				font-size: 0.7rem;
			}
			.severity-error {
				background: var(--danger);
				color: white;
			}
			.severity-warn {
				background: var(--warning);
				color: white;
			}
			.severity-info {
				background: var(--accent);
				color: white;
			}
			.severity-debug {
				background: var(--text-muted);
				color: white;
			}
			.time {
				color: var(--text-muted);
				font-family: monospace;
			}
			.service {
				color: var(--accent);
				text-decoration: none;
			}
			.service:hover {
				text-decoration: underline;
			}
			.trace-link {
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.7rem;
				padding: 0.125rem 0.375rem;
				background: var(--bg-secondary);
				border-radius: 4px;
			}
			.trace-link:hover {
				background: var(--accent);
				color: white;
			}
			.log-body {
				font-family: 'SF Mono', Monaco, monospace;
				font-size: 0.8rem;
				color: var(--text-primary);
				white-space: pre-wrap;
				word-break: break-word;
			}
			.btn-secondary {
				background: var(--bg-secondary);
				color: var(--text-primary);
				border: 1px solid var(--border-color);
				text-decoration: none;
				display: inline-block;
				padding: 0.5rem 1rem;
				border-radius: 0.375rem;
				font-size: 0.875rem;
			}
			.btn-secondary:hover {
				background: var(--bg-tertiary);
			}
			.pagination {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				padding: 1rem;
				border-top: 1px solid var(--border-color);
				margin-top: 1rem;
			}
			.pagination-info {
				color: var(--text-muted);
				font-size: 0.875rem;
			}
		</style>
	}
}

func logEntryClass(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "log-entry-error"
	case "WARN":
		return "log-entry-warn"
	default:
		return ""
	}
}

func severityClass(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "severity-error"
	case "WARN":
		return "severity-warn"
	case "INFO":
		return "severity-info"
	default:
		return "severity-debug"
	}
}

func logsPaginationURL(base, q, service, severity string, limit, offset int) string {
	url := base + "?"
	if q != "" {
		url += "q=" + q + "&"
	}
	if service != "" {
		url += "service=" + service + "&"
	}
	if severity != "" {
		url += "severity=" + severity + "&"
	}
	url += fmt.Sprintf("limit=%d&offset=%d", limit, offset)
	return url
}
