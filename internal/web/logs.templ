package web

import (
	"fmt"
	"net/url"
	"strconv"
)

// LogsData for the logs search page
type LogsData struct {
	Query string
	Logs  []LogRow
	// Pagination
	Limit   int
	Offset  int
	HasMore bool
	Window  int
}

type LogRow struct {
	Time           string
	ObservedTime   string
	Service        string
	Namespace      string
	Severity       string
	SeverityNumber int32
	Body           string
	TraceID        string
	SpanID         string
	Flags          uint32
	ScopeName      string
	ScopeVersion   string
	Attributes     map[string]any
}

// Logs renders the logs search page
templ Logs(data LogsData) {
	@Layout("Logs", "logs", data.Window) {
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Logs</h1>
				<p class="page-subtitle">Search application logs</p>
			</div>
		</div>
		<!-- Search Form -->
		<div class="search-section">
			<form method="GET" action="/logs" onsubmit="return cleanFormSubmit(this)">
				<div class="form-row">
					<sl-input name="q" placeholder="service:cart severity:ERROR &quot;timeout&quot; -retry" value={ data.Query }></sl-input>
					<sl-button type="submit" variant="primary">Search</sl-button>
				</div>
				<div class="search-hint">
					<code>service:name</code> <code>severity:ERROR,WARN</code> <code>"exact phrase"</code> <code>-exclude</code>
				</div>
			</form>
		</div>
		<!-- Results -->
		<div class="results-section">
			<div class="results-header">Results ({ fmt.Sprintf("%d", len(data.Logs)) } logs)</div>
			if len(data.Logs) == 0 {
				<div class="empty-state" style="padding: 3rem;">
					<sl-icon name="file-text"></sl-icon>
					<div class="empty-state-title">No logs found</div>
					<div class="empty-state-message">Try adjusting your search filters or check if logging is enabled.</div>
				</div>
			} else {
				<div class="logs-list">
					for i, log := range data.Logs {
						<div class={ "log-entry", logEntryClass(log.Severity) }>
							<div class="log-header">
								<sl-badge variant={ severityVariant(log.Severity) } pill>{ log.Severity }</sl-badge>
								<sl-relative-time class="time" date={ log.Time }></sl-relative-time>
								if log.Namespace != "" {
									<sl-tag size="small" class="ns-tag">{ log.Namespace }</sl-tag>
								}
								if log.Service != "" {
									<a href={ templ.SafeURL(withWindow("/services/"+pathEscape(log.Service), data.Window)) } class="service">{ log.Service }</a>
								}
								if log.TraceID != "" {
									<sl-button href={ withWindow("/traces/"+pathEscape(log.TraceID), data.Window) } size="small" variant="text">trace</sl-button>
								}
								if hasLogDetails(log) {
									<button class="log-expand" aria-expanded="false" aria-controls={ fmt.Sprintf("log-detail-%d", i) }>
										<sl-icon name="chevron-down" class="expand-icon"></sl-icon>
									</button>
								}
							</div>
							<div class="log-body">{ log.Body }</div>
							if hasLogDetails(log) {
								<div class="log-detail" id={ fmt.Sprintf("log-detail-%d", i) } hidden>
									<div class="log-detail-grid">
										if log.SpanID != "" {
											<div class="log-detail-item">
												<span class="log-detail-label">Span ID</span>
												<span class="log-detail-value mono">{ log.SpanID }</span>
											</div>
										}
										if log.ScopeName != "" {
											<div class="log-detail-item">
												<span class="log-detail-label">Scope</span>
												<span class="log-detail-value">{ log.ScopeName }{ fmtScopeVersion(log.ScopeVersion) }</span>
											</div>
										}
										if log.ObservedTime != "" && log.ObservedTime != log.Time {
											<div class="log-detail-item">
												<span class="log-detail-label">Observed</span>
												<span class="log-detail-value">{ log.ObservedTime }</span>
											</div>
										}
									</div>
									if len(log.Attributes) > 0 {
										<div class="log-attributes">
											<div class="log-attr-title">Attributes</div>
											for k, v := range log.Attributes {
												<div class="log-attr-row">
													<span class="log-attr-key">{ k }</span>
													<span class="log-attr-value">{ fmtAttrValue(v) }</span>
												</div>
											}
										</div>
									}
								</div>
							}
						</div>
					}
				</div>
				<script>
					document.querySelectorAll('.log-expand').forEach(btn => {
						btn.addEventListener('click', (e) => {
							e.stopPropagation();
							const entry = btn.closest('.log-entry');
							const detail = entry.querySelector('.log-detail');
							const expanded = btn.getAttribute('aria-expanded') === 'true';
							btn.setAttribute('aria-expanded', !expanded);
							btn.querySelector('.expand-icon').name = expanded ? 'chevron-down' : 'chevron-up';
							detail.hidden = expanded;
						});
					});
				</script>
				<!-- Pagination -->
				<div class="pagination">
					<sl-button href={ logsPaginationURL(data.Query, data.Window, data.Limit, clampMin(data.Offset-data.Limit)) } variant="default" size="small" disabled?={ data.Offset == 0 }>
						<sl-icon slot="prefix" name="chevron-left"></sl-icon>
						Previous
					</sl-button>
					<span class="pagination-info">{ fmt.Sprintf("%d", data.Offset+1) } - { fmt.Sprintf("%d", data.Offset+len(data.Logs)) }</span>
					<sl-button href={ logsPaginationURL(data.Query, data.Window, data.Limit, data.Offset+data.Limit) } variant="default" size="small" disabled?={ !data.HasMore }>
						Next
						<sl-icon slot="suffix" name="chevron-right"></sl-icon>
					</sl-button>
				</div>
			}
		</div>
		<style>
			.logs-list {
				display: flex;
				flex-direction: column;
				gap: 0;
				padding: 0;
			}
			.log-entry {
				padding: 0.875rem 1rem;
				border-left: 3px solid var(--border-color);
				border-bottom: 1px solid var(--border-color);
			}
			.log-entry:last-child {
				border-bottom: none;
			}
			.log-entry-error {
				border-left-color: var(--danger);
				background: rgba(239, 68, 68, 0.1);
			}
			.log-entry-warn {
				border-left-color: var(--warning);
				background: rgba(245, 158, 11, 0.1);
			}
			.log-header {
				display: flex;
				gap: 1rem;
				align-items: center;
				margin-bottom: 0.5rem;
				font-size: 0.75rem;
			}
			.time {
				color: var(--text-muted);
				font-family: var(--font-mono);
			}
			.service {
				color: var(--accent);
				text-decoration: none;
			}
			.service:hover {
				text-decoration: underline;
			}
			.log-body {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--text-primary);
				white-space: pre-wrap;
				word-break: break-word;
			}
			.log-expand {
				margin-left: auto;
				padding: 0.25rem;
				border: none;
				background: none;
				color: var(--text-muted);
				cursor: pointer;
				border-radius: 0.25rem;
			}
			.log-expand:hover {
				background: var(--bg-tertiary);
				color: var(--text-primary);
			}
			.log-detail {
				margin-top: 0.75rem;
				padding-top: 0.75rem;
				border-top: 1px solid var(--border-color);
			}
			.log-detail-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
				gap: 0.75rem;
			}
			.log-detail-item {
				display: flex;
				flex-direction: column;
				gap: 0.125rem;
			}
			.log-detail-label {
				font-size: 0.65rem;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.log-detail-value {
				font-size: 0.75rem;
				color: var(--text-primary);
			}
			.log-detail-value.mono {
				font-family: var(--font-mono);
			}
			.log-attributes {
				margin-top: 0.75rem;
			}
			.log-attr-title {
				font-size: 0.65rem;
				font-weight: 600;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 0.5rem;
			}
			.log-attr-row {
				display: flex;
				gap: 0.5rem;
				font-size: 0.75rem;
				padding: 0.25rem 0.5rem;
				background: var(--bg-tertiary);
				border-radius: 0.25rem;
				margin-bottom: 0.25rem;
			}
			.log-attr-key {
				font-weight: 500;
				color: var(--accent);
				min-width: 100px;
			}
			.log-attr-value {
				color: var(--text-primary);
				font-family: var(--font-mono);
				word-break: break-all;
			}
		</style>
	}
}

func logEntryClass(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "log-entry-error"
	case "WARN":
		return "log-entry-warn"
	default:
		return ""
	}
}

func severityVariant(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "danger"
	case "WARN":
		return "warning"
	case "INFO":
		return "primary"
	default:
		return "neutral"
	}
}

func logsPaginationURL(q string, window, limit, offset int) templ.SafeURL {
	values := url.Values{}
	if q != "" {
		values.Set("q", q)
	}
	if window != 60 {
		values.Set("window", strconv.Itoa(window))
	}
	values.Set("limit", strconv.Itoa(limit))
	values.Set("offset", strconv.Itoa(offset))
	return templ.SafeURL("/logs?" + values.Encode())
}

func hasLogDetails(log LogRow) bool {
	return log.SpanID != "" || log.ScopeName != "" || len(log.Attributes) > 0 || (log.ObservedTime != "" && log.ObservedTime != log.Time)
}

