package web

import (
	"fmt"
	"net/url"
	"strconv"
)

// LogsData for the logs search page
type LogsData struct {
	Query    string
	Service  string
	Severity string
	Logs     []LogRow
	// Pagination
	Limit   int
	Offset  int
	HasMore bool
	Window  int
}

type LogRow struct {
	Time     string
	Service  string
	Severity string
	Body     string
	TraceID  string
}

// Logs renders the logs search page
templ Logs(data LogsData) {
	@Layout("Logs", "logs", data.Window) {
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Logs</h1>
				<p class="page-subtitle">Search application logs</p>
			</div>
		</div>
	<div class="quick-filters">
		<sl-button href={ logsPaginationURL("/logs", data.Query, data.Service, "", data.Window, data.Limit, 0) } size="small" variant={ logFilterVariant(data.Severity, "") }>All</sl-button>
		<sl-button href={ logsPaginationURL("/logs", data.Query, data.Service, "ERROR", data.Window, data.Limit, 0) } size="small" variant={ logFilterVariant(data.Severity, "ERROR") }>
			<sl-icon name="exclamation-triangle" slot="prefix"></sl-icon>
			Errors
		</sl-button>
		<sl-button href={ logsPaginationURL("/logs", data.Query, data.Service, "WARN", data.Window, data.Limit, 0) } size="small" variant={ logFilterVariant(data.Severity, "WARN") }>
			<sl-icon name="exclamation-circle" slot="prefix"></sl-icon>
			Warn
		</sl-button>
		<sl-button href={ logsPaginationURL("/logs", data.Query, data.Service, "INFO", data.Window, data.Limit, 0) } size="small" variant={ logFilterVariant(data.Severity, "INFO") }>
			<sl-icon name="info-circle" slot="prefix"></sl-icon>
			Info
		</sl-button>
	</div>
		<!-- Search Form -->
	<div class="card" style="margin-bottom: 1.5rem;">
		<form method="GET" action="/logs" class="search-form">
			<div class="form-row">
				<sl-input name="q" label="Search" placeholder="Log message pattern..." value={ data.Query }></sl-input>
				<sl-input name="service" label="Service" placeholder="All services" value={ data.Service }></sl-input>
				<sl-select name="severity" label="Severity" value={ data.Severity }>
						<sl-option value="">All</sl-option>
						<sl-option value="DEBUG">DEBUG</sl-option>
						<sl-option value="INFO">INFO</sl-option>
						<sl-option value="WARN">WARN</sl-option>
					<sl-option value="ERROR">ERROR</sl-option>
					<sl-option value="FATAL">FATAL</sl-option>
				</sl-select>
				if data.Window != 60 {
					<input type="hidden" name="window" value={ fmt.Sprintf("%d", data.Window) }/>
				}
				<sl-button type="submit" variant="primary">Search</sl-button>
			</div>
		</form>
	</div>
		<!-- Results -->
		<div class="card">
			<div class="card-title">Results ({ fmt.Sprintf("%d", len(data.Logs)) } logs)</div>
			if len(data.Logs) == 0 {
				<div class="empty-state">
					<sl-icon name="file-text"></sl-icon>
					<div class="empty-state-title">No logs found</div>
					<div class="empty-state-message">Try adjusting your search filters or check if logging is enabled.</div>
				</div>
			} else {
				<div class="logs-list">
						for _, log := range data.Logs {
							<div class={ "log-entry", logEntryClass(log.Severity) }>
								<div class="log-header">
									<sl-badge variant={ severityVariant(log.Severity) }>{ log.Severity }</sl-badge>
									<span class="time">{ log.Time }</span>
									if log.Service != "" {
										<a href={ templ.SafeURL(withWindow("/services/"+pathEscape(log.Service), data.Window)) } class="service">{ log.Service }</a>
									}
									if log.TraceID != "" {
										<sl-button href={ withWindow("/traces/"+pathEscape(log.TraceID), data.Window) } size="small" variant="text">trace</sl-button>
									}
								</div>
								<div class="log-body">{ log.Body }</div>
						</div>
					}
				</div>
				<!-- Pagination -->
				if data.Offset > 0 || data.HasMore {
					<div class="pagination">
						if data.Offset > 0 {
							<sl-button href={ logsPaginationURL("/logs", data.Query, data.Service, data.Severity, data.Window, data.Limit, data.Offset-data.Limit) } variant="default" size="small">Previous</sl-button>
						}
						<span class="pagination-info">Showing { fmt.Sprintf("%d", data.Offset+1) }-{ fmt.Sprintf("%d", data.Offset+len(data.Logs)) }</span>
						if data.HasMore {
							<sl-button href={ logsPaginationURL("/logs", data.Query, data.Service, data.Severity, data.Window, data.Limit, data.Offset+data.Limit) } variant="default" size="small">Next</sl-button>
						}
					</div>
				}
			}
		</div>
		<style>
			.search-form .form-row {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				align-items: flex-end;
			}
			.search-form sl-input, .search-form sl-select {
				flex: 1;
				min-width: 150px;
			}
			.logs-list {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.log-entry {
				padding: 0.75rem;
				border-radius: 0.375rem;
				border-left: 3px solid var(--border-color);
				background: var(--bg-tertiary);
			}
			.log-entry-error {
				border-left-color: var(--danger);
				background: rgba(239, 68, 68, 0.1);
			}
			.log-entry-warn {
				border-left-color: var(--warning);
				background: rgba(245, 158, 11, 0.1);
			}
			.log-header {
				display: flex;
				gap: 1rem;
				align-items: center;
				margin-bottom: 0.5rem;
				font-size: 0.75rem;
			}
			.time {
				color: var(--text-muted);
				font-family: monospace;
			}
			.service {
				color: var(--accent);
				text-decoration: none;
			}
			.service:hover {
				text-decoration: underline;
			}
			.log-body {
				font-family: 'SF Mono', Monaco, monospace;
				font-size: 0.8rem;
				color: var(--text-primary);
				white-space: pre-wrap;
				word-break: break-word;
			}
			.pagination {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				padding: 1rem;
				border-top: 1px solid var(--border-color);
				margin-top: 1rem;
			}
			.pagination-info {
				color: var(--text-muted);
				font-size: 0.875rem;
			}
		</style>
	}
}

func logEntryClass(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "log-entry-error"
	case "WARN":
		return "log-entry-warn"
	default:
		return ""
	}
}

func severityVariant(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "danger"
	case "WARN":
		return "warning"
	case "INFO":
		return "primary"
	default:
		return "neutral"
	}
}

func logsPaginationURL(base, q, service, severity string, window, limit, offset int) string {
	values := url.Values{}
	if q != "" {
		values.Set("q", q)
	}
	if service != "" {
		values.Set("service", service)
	}
	if severity != "" {
		values.Set("severity", severity)
	}
	if window != 60 {
		values.Set("window", strconv.Itoa(window))
	}
	values.Set("limit", strconv.Itoa(limit))
	values.Set("offset", strconv.Itoa(offset))
	return base + "?" + values.Encode()
}

func logFilterVariant(current, target string) string {
	if current == target {
		return "primary"
	}
	return "default"
}
