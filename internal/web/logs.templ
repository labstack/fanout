package web

import (
	"fmt"
	"net/url"
	"strconv"
)

// LogsData for the logs search page
type LogsData struct {
	Query string
	Logs  []LogRow
	// Pagination
	Limit   int
	Offset  int
	HasMore bool
	Window  int
}

type LogRow struct {
	Time      string
	Service   string
	Namespace string
	Severity  string
	Body      string
	TraceID   string
}

// Logs renders the logs search page
templ Logs(data LogsData) {
	@Layout("Logs", "logs", data.Window) {
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Logs</h1>
				<p class="page-subtitle">Search application logs</p>
			</div>
		</div>
		<!-- Search Form -->
		<div class="card" style="margin-bottom: 1.5rem;">
			<form method="GET" action="/logs" class="search-form">
				<div class="form-row">
					<sl-input name="q" label="Search" placeholder="service:cart severity:ERROR &quot;timeout&quot; -retry" value={ data.Query } style="flex: 3;"></sl-input>
					if data.Window != 60 {
						<input type="hidden" name="window" value={ fmt.Sprintf("%d", data.Window) }/>
					}
					<sl-button type="submit" variant="primary">Search</sl-button>
				</div>
				<div class="search-hint">
					<sl-icon name="lightbulb"></sl-icon>
					<code>service:name</code> <code>namespace:default</code> <code>severity:ERROR,WARN</code> <code>"exact phrase"</code> <code>-exclude</code>
				</div>
			</form>
		</div>
		<!-- Results -->
		<div class="card">
			<div class="card-title">Results ({ fmt.Sprintf("%d", len(data.Logs)) } logs)</div>
			if len(data.Logs) == 0 {
				<div class="empty-state">
					<sl-icon name="file-text"></sl-icon>
					<div class="empty-state-title">No logs found</div>
					<div class="empty-state-message">Try adjusting your search filters or check if logging is enabled.</div>
				</div>
			} else {
				<div class="logs-list">
					for _, log := range data.Logs {
						<div class={ "log-entry", logEntryClass(log.Severity) }>
							<div class="log-header">
								<sl-badge variant={ severityVariant(log.Severity) }>{ log.Severity }</sl-badge>
								<span class="time">{ log.Time }</span>
								if log.Namespace != "" {
									<span class="namespace-badge">{ log.Namespace }</span>
								}
								if log.Service != "" {
									<a href={ templ.SafeURL(withWindow("/services/"+pathEscape(log.Service), data.Window)) } class="service">{ log.Service }</a>
								}
								if log.TraceID != "" {
									<sl-button href={ withWindow("/traces/"+pathEscape(log.TraceID), data.Window) } size="small" variant="text">trace</sl-button>
								}
							</div>
							<div class="log-body">{ log.Body }</div>
						</div>
					}
				</div>
				<!-- Pagination -->
				if data.Offset > 0 || data.HasMore {
					<div class="pagination">
						if data.Offset > 0 {
							<sl-button href={ logsPaginationURL(data.Query, data.Window, data.Limit, data.Offset-data.Limit) } variant="default" size="small">Previous</sl-button>
						}
						<span class="pagination-info">Showing { fmt.Sprintf("%d", data.Offset+1) }-{ fmt.Sprintf("%d", data.Offset+len(data.Logs)) }</span>
						if data.HasMore {
							<sl-button href={ logsPaginationURL(data.Query, data.Window, data.Limit, data.Offset+data.Limit) } variant="default" size="small">Next</sl-button>
						}
					</div>
				}
			}
		</div>
		<style>
			.search-form .form-row {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				align-items: flex-end;
			}
			.search-form sl-input, .search-form sl-select {
				flex: 1;
				min-width: 150px;
			}
			.search-hint {
				margin-top: 0.75rem;
				font-size: 0.75rem;
				color: var(--text-muted);
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.search-hint sl-icon {
				font-size: 0.875rem;
			}
			.search-hint code {
				background: var(--bg-tertiary);
				padding: 0.125rem 0.375rem;
				border-radius: 0.25rem;
				font-size: 0.7rem;
			}
			.logs-list {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.log-entry {
				padding: 0.75rem;
				border-radius: 0.375rem;
				border-left: 3px solid var(--border-color);
				background: var(--bg-tertiary);
			}
			.log-entry-error {
				border-left-color: var(--danger);
				background: rgba(239, 68, 68, 0.1);
			}
			.log-entry-warn {
				border-left-color: var(--warning);
				background: rgba(245, 158, 11, 0.1);
			}
			.log-header {
				display: flex;
				gap: 1rem;
				align-items: center;
				margin-bottom: 0.5rem;
				font-size: 0.75rem;
			}
			.time {
				color: var(--text-muted);
				font-family: monospace;
			}
			.service {
				color: var(--accent);
				text-decoration: none;
			}
			.service:hover {
				text-decoration: underline;
			}
			.log-body {
				font-family: 'SF Mono', Monaco, monospace;
				font-size: 0.8rem;
				color: var(--text-primary);
				white-space: pre-wrap;
				word-break: break-word;
			}
			.pagination {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				padding: 1rem;
				border-top: 1px solid var(--border-color);
				margin-top: 1rem;
			}
			.pagination-info {
				color: var(--text-muted);
				font-size: 0.875rem;
			}
		</style>
	}
}

func logEntryClass(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "log-entry-error"
	case "WARN":
		return "log-entry-warn"
	default:
		return ""
	}
}

func severityVariant(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "danger"
	case "WARN":
		return "warning"
	case "INFO":
		return "primary"
	default:
		return "neutral"
	}
}

func logsPaginationURL(q string, window, limit, offset int) string {
	values := url.Values{}
	if q != "" {
		values.Set("q", q)
	}
	if window != 60 {
		values.Set("window", strconv.Itoa(window))
	}
	values.Set("limit", strconv.Itoa(limit))
	values.Set("offset", strconv.Itoa(offset))
	return "/logs?" + values.Encode()
}
