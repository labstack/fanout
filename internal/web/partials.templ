package web

import (
	"fmt"
	"time"
)

// Partials - HTML fragments for htmx updates (no Layout wrapper)

// OverviewContent renders the full overview content without layout
templ OverviewContent(data OverviewData) {
	<!-- Anomaly Alert Banner -->
	if len(data.Timeline.Anomalies) > 0 {
		@alertBanner(data.Timeline.Anomalies)
	}
	<div class="page-header">
		<div class="page-header-left">
			<h1 class="page-title">System Overview</h1>
			<p class="page-subtitle" id="summary">{ data.Summary }</p>
		</div>
		<div class="page-header-right">
			<span class="last-updated" id="last-updated">
				Updated <sl-relative-time date={ nowISO() } sync></sl-relative-time>
			</span>
			<sl-icon-button
				name="arrow-clockwise"
				label="Refresh"
				hx-get={ "/partials/overview?window=" + fmt.Sprintf("%d", data.Window) }
				hx-target="#overview-content"
				hx-swap="innerHTML"
				hx-indicator="#overview-spinner"
			></sl-icon-button>
			<sl-spinner id="overview-spinner" class="htmx-indicator" style="font-size: 1rem;"></sl-spinner>
		</div>
	</div>
	@StatsGrid(data.Services)
	@KeyMetrics(data.ThroughputPerMin, data.P95Ms, data.ErrorRate)
	<div class="grid grid-2" style="margin-bottom: 1rem;">
		<sl-card>
			<div slot="header" class="card-header">Request Timeline</div>
			@timelineChart(data.Timeline)
		</sl-card>
		<sl-card>
			<div slot="header" class="card-header">Top Issues</div>
			@TopIssues(data.TopIssues, data.Window)
		</sl-card>
	</div>
	@ServicesTable(data.Topology.Nodes, data.Window)
}

// StatsGrid renders service health counts
templ StatsGrid(s ServiceSummary) {
	<div id="stats-grid" class="stats-bar" style="margin-bottom: 1rem;">
		<div class="stats-item">
			<div class="stats-value">{ fmt.Sprintf("%d", s.Total) }</div>
			<div class="stats-label">Services</div>
		</div>
		<div class="stats-item">
			<div class="stats-value" style="color: var(--success);">{ fmt.Sprintf("%d", s.Healthy) }</div>
			<div class="stats-label">Healthy</div>
		</div>
		<div class="stats-item">
			<div class="stats-value" style="color: var(--warning);">{ fmt.Sprintf("%d", s.Degraded) }</div>
			<div class="stats-label">Degraded</div>
		</div>
		<div class="stats-item">
			<div class="stats-value" style="color: var(--danger);">{ fmt.Sprintf("%d", s.Unhealthy) }</div>
			<div class="stats-label">Unhealthy</div>
		</div>
	</div>
}

// KeyMetrics renders throughput, latency, error rate
templ KeyMetrics(throughput int64, p95 float64, errorRate float64) {
	<div id="key-metrics" class="stats-bar" style="margin-bottom: 1rem;">
		<div class="stats-item">
			<div class="stats-value">{ fmt.Sprintf("%d", throughput) }</div>
			<div class="stats-label">Requests/min</div>
		</div>
		<div class="stats-item">
			<div class="stats-value">{ fmt.Sprintf("%.0f", p95) }ms</div>
			<div class="stats-label">P95 Latency</div>
		</div>
		<div class="stats-item">
			<div class="stats-value">{ fmt.Sprintf("%.1f", errorRate*100) }%</div>
			<div class="stats-label">Error Rate</div>
		</div>
	</div>
}

// TopIssues renders the issues table content
templ TopIssues(issues []TopIssue, window int) {
	if len(issues) == 0 {
		<div class="empty-inline success">
			<sl-icon name="check-circle"></sl-icon>
			<span>No issues detected</span>
		</div>
	} else {
		<table class="table">
			<thead>
				<tr>
					<th>Service</th>
					<th>Issue</th>
					<th>Detail</th>
				</tr>
			</thead>
			<tbody>
				for _, issue := range issues {
					<tr>
						<td>
							if issue.Service != "" {
								<a href={ templ.SafeURL(withWindow("/services/"+pathEscape(issue.Service), window)) }>{ issue.Service }</a>
							} else {
								<span style="color: var(--text-muted);">—</span>
							}
						</td>
						<td>
							if issue.Issue == "high_error_rate" {
								<sl-badge variant="danger" pill>Errors</sl-badge>
							} else if issue.Issue == "high_latency" {
								<sl-badge variant="warning" pill>Slow</sl-badge>
							} else if issue.Issue != "" {
								<sl-badge variant="warning" pill>{ issue.Issue }</sl-badge>
							}
						</td>
						<td>{ issue.Detail }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// ServicesTable renders the services list
templ ServicesTable(nodes []ServiceNode, window int) {
	<sl-card id="services-table">
		<div slot="header" class="card-header">Services</div>
		<table class="table">
			<thead>
				<tr>
					<th>Service</th>
					<th>Status</th>
					<th>Requests</th>
					<th>P95</th>
					<th>Error Rate</th>
				</tr>
			</thead>
			<tbody>
				for _, node := range nodes {
					<tr>
						<td><a href={ templ.SafeURL(withWindow("/services/"+pathEscape(node.Name), window)) }>{ node.Name }</a></td>
						<td>
							<sl-badge variant={ statusVariant(node.Status) } pill>{ node.Status }</sl-badge>
						</td>
						<td>{ fmt.Sprintf("%d", node.SpanCount) }</td>
						<td>{ fmt.Sprintf("%.0fms", node.P95Ms) }</td>
						<td>{ fmt.Sprintf("%.1f%%", node.ErrorRate*100) }</td>
					</tr>
				}
			</tbody>
		</table>
	</sl-card>
}

// TimelineChart renders just the chart
templ TimelineChart(data TimelineData) {
	@timelineChart(data)
}

// EmptyStateSetup renders an empty state with setup guidance
templ EmptyStateSetup(dataType string) {
	<div class="empty-state-setup">
		<div class="empty-state-icon">
			if dataType == "services" {
				<sl-icon name="hdd-stack"></sl-icon>
			} else if dataType == "traces" {
				<sl-icon name="diagram-3"></sl-icon>
			} else if dataType == "logs" {
				<sl-icon name="file-text"></sl-icon>
			} else if dataType == "metrics" {
				<sl-icon name="graph-up"></sl-icon>
			} else if dataType == "topology" {
				<sl-icon name="share"></sl-icon>
			} else {
				<sl-icon name="database"></sl-icon>
			}
		</div>
		<div class="empty-state-content">
			<h3 class="empty-state-title">No { dataType } detected</h3>
			<p class="empty-state-desc">Configure your application to send telemetry data to Fanout.</p>
			<sl-card class="setup-card">
				<div class="setup-step">
					<sl-badge variant="primary" pill>1</sl-badge>
					<div class="step-content">
						<div class="step-title">Configure OTLP endpoint</div>
						<div class="step-code">
							<code>OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317</code>
						</div>
					</div>
				</div>
				<sl-divider></sl-divider>
				<div class="setup-step">
					<sl-badge variant="primary" pill>2</sl-badge>
					<div class="step-content">
						<div class="step-title">Set service name</div>
						<div class="step-code">
							<code>OTEL_SERVICE_NAME=my-service</code>
						</div>
					</div>
				</div>
				<sl-divider></sl-divider>
				<div class="setup-step">
					<sl-badge variant="primary" pill>3</sl-badge>
					<div class="step-content">
						<div class="step-title">Use gRPC protocol</div>
						<div class="step-code">
							<code>OTEL_EXPORTER_OTLP_PROTOCOL=grpc</code>
						</div>
					</div>
				</div>
			</sl-card>
			<sl-alert variant="primary" open class="setup-alert">
				<sl-icon slot="icon" name="lightbulb"></sl-icon>
				Data typically appears within 15 seconds after your app starts sending telemetry.
			</sl-alert>
		</div>
	</div>
	<style>
		.empty-state-setup {
			display: flex;
			flex-direction: column;
			align-items: center;
			padding: 3rem 2rem;
			text-align: center;
		}
		.empty-state-icon sl-icon {
			font-size: 4rem;
			color: var(--accent);
			opacity: 0.6;
		}
		.empty-state-content {
			max-width: 480px;
		}
		.empty-state-setup .empty-state-title {
			font-size: 1.25rem;
			font-weight: 600;
			color: var(--text-primary);
			margin: 1rem 0 0.5rem;
		}
		.empty-state-desc {
			color: var(--text-muted);
			margin-bottom: 1.5rem;
		}
		.setup-card {
			text-align: left;
			--padding: 1rem;
		}
		.setup-card sl-divider {
			--spacing: 0.75rem;
		}
		.setup-step {
			display: flex;
			gap: 0.75rem;
			align-items: flex-start;
		}
		.setup-step sl-badge::part(base) {
			min-width: 24px;
			height: 24px;
		}
		.step-content {
			flex: 1;
			min-width: 0;
		}
		.step-title {
			font-size: 0.875rem;
			font-weight: 500;
			color: var(--text-primary);
			margin-bottom: 0.375rem;
		}
		.step-code {
			background: var(--bg-tertiary);
			padding: 0.5rem 0.75rem;
			border-radius: 0.375rem;
			overflow-x: auto;
		}
		.step-code code {
			font-family: var(--font-mono);
			font-size: 0.75rem;
			color: var(--accent);
			white-space: nowrap;
		}
		.setup-alert {
			margin-top: 1.5rem;
		}
		.setup-alert::part(base) {
			font-size: 0.8rem;
		}
	</style>
}

// nowISO returns current time in ISO 8601 format for sl-relative-time
func nowISO() string {
	return time.Now().UTC().Format(time.RFC3339)
}
