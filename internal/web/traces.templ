package web

import (
	"encoding/json"
	"fmt"
	"net/url"
	"strconv"
)

// TracesData for the traces search page
type TracesData struct {
	Query    string
	Service  string
	Services []string
	Status   string
	Traces   []TraceRow
	// Pagination
	Limit   int
	Offset  int
	HasMore bool
	Window  int
}

type TraceRow struct {
	TraceID   string
	Service   string
	Operation string
	Duration  float64
	Status    string
	Time      string
}

// Traces renders the traces search page
templ Traces(data TracesData) {
	@Layout("Traces", "traces", data.Window) {
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Traces</h1>
				<p class="page-subtitle">Search and analyze distributed traces</p>
			</div>
		</div>
		<div class="quick-filters">
			<sl-button href={ paginationURL("/traces", data.Query, data.Service, "", data.Window, data.Limit, 0) } size="small" variant={ traceFilterVariant(data.Status, "") }>All</sl-button>
			<sl-button href={ paginationURL("/traces", data.Query, data.Service, "error", data.Window, data.Limit, 0) } size="small" variant={ traceFilterVariant(data.Status, "error") }>
				<sl-icon slot="prefix" name="exclamation-triangle"></sl-icon>
				Errors
			</sl-button>
			<sl-button href={ paginationURL("/traces", data.Query, data.Service, "slow", data.Window, data.Limit, 0) } size="small" variant={ traceFilterVariant(data.Status, "slow") }>
				<sl-icon slot="prefix" name="clock"></sl-icon>
				Slow (&gt;1s)
			</sl-button>
		</div>
		<!-- Search Form -->
		<div class="card" style="margin-bottom: 1.5rem;">
			<form method="GET" action="/traces" class="search-form">
				<div class="form-row">
					<sl-input name="q" label="Search" placeholder="Operation or trace ID..." value={ data.Query }></sl-input>
					<sl-select name="service" label="Service" value={ data.Service }>
						<sl-option value="">All services</sl-option>
						for _, svc := range data.Services {
							<sl-option value={ svc }>{ svc }</sl-option>
						}
					</sl-select>
					<sl-select name="status" label="Status" value={ data.Status }>
						<sl-option value="">All</sl-option>
						<sl-option value="error">Errors only</sl-option>
						<sl-option value="slow">Slow only</sl-option>
					</sl-select>
					if data.Window != 60 {
						<input type="hidden" name="window" value={ fmt.Sprintf("%d", data.Window) }/>
					}
					<sl-button type="submit" variant="primary">Search</sl-button>
				</div>
			</form>
		</div>
		<!-- Results -->
		<div class="card">
			<div class="card-title">Results ({ fmt.Sprintf("%d", len(data.Traces)) } traces)</div>
			if len(data.Traces) == 0 {
				<div class="empty-state">
					<sl-icon name="search"></sl-icon>
					<div class="empty-state-title">No traces found</div>
					<div class="empty-state-message">Try adjusting your search filters or expanding the time window.</div>
				</div>
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Trace ID</th>
							<th>Service</th>
							<th>Operation</th>
							<th>Duration</th>
							<th>Status</th>
							<th>Time</th>
						</tr>
					</thead>
					<tbody>
						for _, t := range data.Traces {
							<tr>
								<td><a href={ templ.SafeURL(withWindow("/traces/"+pathEscape(t.TraceID), data.Window)) }>{ truncateID(t.TraceID) }</a></td>
								<td>
									if t.Service != "" {
										<a href={ templ.SafeURL(withWindow("/services/"+pathEscape(t.Service), data.Window)) }>{ t.Service }</a>
									} else {
										<span style="color: var(--text-muted);">—</span>
									}
								</td>
								<td>{ t.Operation }</td>
								<td>{ fmt.Sprintf("%.0fms", t.Duration) }</td>
								<td>
									if t.Status == "error" {
										<sl-badge variant="danger">error</sl-badge>
									} else {
										<sl-badge variant="success">ok</sl-badge>
									}
								</td>
								<td>{ t.Time }</td>
							</tr>
						}
					</tbody>
				</table>
				<!-- Pagination -->
				if data.Offset > 0 || data.HasMore {
					<div class="pagination">
						if data.Offset > 0 {
							<sl-button href={ paginationURL("/traces", data.Query, data.Service, data.Status, data.Window, data.Limit, data.Offset-data.Limit) } variant="default" size="small">Previous</sl-button>
						}
						<span class="pagination-info">Showing { fmt.Sprintf("%d", data.Offset+1) }-{ fmt.Sprintf("%d", data.Offset+len(data.Traces)) }</span>
						if data.HasMore {
							<sl-button href={ paginationURL("/traces", data.Query, data.Service, data.Status, data.Window, data.Limit, data.Offset+data.Limit) } variant="default" size="small">Next</sl-button>
						}
					</div>
				}
			}
		</div>
		<style>
			.search-form .form-row {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				align-items: flex-end;
			}
			.search-form sl-input, .search-form sl-select {
				flex: 1;
				min-width: 150px;
			}
			.pagination {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				padding: 1rem;
				border-top: 1px solid var(--border-color);
				margin-top: 1rem;
			}
			.pagination-info {
				color: var(--text-muted);
				font-size: 0.875rem;
			}
		</style>
	}
}

// TraceDetailData for the trace detail page
type TraceDetailData struct {
	TraceID     string
	RootService string
	RootOp      string
	Duration    float64
	SpanCount   int
	Spans       []SpanInfo
	Logs        []LogInfo
	RootCause   string
	Window      int
}

type SpanInfo struct {
	SpanID      string
	ParentID    string
	Service     string
	Operation   string
	Duration    float64
	Status      string
	StartOffset float64
	Depth       int
}

type LogInfo struct {
	Time     string
	Service  string
	Severity string
	Body     string
}

// TraceDetail renders the trace detail page with waterfall
templ TraceDetail(data TraceDetailData) {
	@Layout("Trace "+truncateID(data.TraceID), "traces", data.Window) {
		<nav class="breadcrumbs">
			<sl-breadcrumb>
				<sl-breadcrumb-item href={ withWindow("/", data.Window) }>Overview</sl-breadcrumb-item>
				<sl-breadcrumb-item href={ withWindow("/traces", data.Window) }>Traces</sl-breadcrumb-item>
				<sl-breadcrumb-item>{ truncateID(data.TraceID) }</sl-breadcrumb-item>
			</sl-breadcrumb>
		</nav>
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Trace { truncateID(data.TraceID) }</h1>
				<p class="page-subtitle">{ data.RootService } / { data.RootOp } - { fmt.Sprintf("%.0fms", data.Duration) }</p>
			</div>
		</div>
		<!-- Summary -->
		<div class="grid grid-4" style="margin-bottom: 1.5rem;">
			<div class="card">
				<div class="metric">
					<div class="metric-value">{ fmt.Sprintf("%.0f", data.Duration) }ms</div>
					<div class="metric-label">Total Duration</div>
				</div>
			</div>
			<div class="card">
				<div class="metric">
					<div class="metric-value">{ fmt.Sprintf("%d", data.SpanCount) }</div>
					<div class="metric-label">Spans</div>
				</div>
			</div>
			<div class="card">
				<div class="metric">
					<div class="metric-value">{ data.RootService }</div>
					<div class="metric-label">Root Service</div>
				</div>
			</div>
			<div class="card">
				<div class="metric">
					if data.RootCause != "" {
						<div class="metric-value" style="color: var(--danger); font-size: 1rem;">{ data.RootCause }</div>
					} else {
						<div class="metric-value" style="color: var(--success);">None</div>
					}
					<div class="metric-label">Root Cause</div>
				</div>
			</div>
		</div>
		<!-- Waterfall Chart -->
		<div class="card" style="margin-bottom: 1.5rem;">
			<div class="card-title">Trace Waterfall</div>
			<div class="waterfall" data-spans={ spansJSON(data.Spans) } data-duration={ fmt.Sprintf("%.0f", data.Duration) }>
				for _, span := range data.Spans {
					<div class="waterfall-row">
						<div class="waterfall-label" style={ fmt.Sprintf("padding-left: %dpx;", span.Depth*20) }>
							<span class="service">{ span.Service }</span>
							<span class="operation">{ span.Operation }</span>
						</div>
						<div class="waterfall-bar-container">
							<div
								class={ "waterfall-bar", waterfallBarClass(span.Status) }
								style={ waterfallBarStyle(span.StartOffset, span.Duration, data.Duration) }
							>
								{ fmt.Sprintf("%.0fms", span.Duration) }
							</div>
						</div>
					</div>
				}
			</div>
		</div>
		<!-- Logs -->
		if len(data.Logs) > 0 {
			<div class="card">
				<div class="card-title">Correlated Logs ({ fmt.Sprintf("%d", len(data.Logs)) })</div>
				<table class="table">
					<thead>
						<tr>
							<th>Time</th>
							<th>Service</th>
							<th>Severity</th>
							<th>Message</th>
						</tr>
					</thead>
					<tbody>
						for _, log := range data.Logs {
							<tr>
								<td>{ log.Time }</td>
								<td>{ log.Service }</td>
								<td>
									<sl-badge variant={ logSeverityVariant(log.Severity) }>{ log.Severity }</sl-badge>
								</td>
								<td style="font-family: monospace; font-size: 0.8rem;">{ log.Body }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<style>
			.waterfall {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}
			.waterfall-row {
				display: grid;
				grid-template-columns: 300px 1fr;
				gap: 1rem;
				align-items: center;
			}
			.waterfall-label {
				font-size: 0.8rem;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.waterfall-label .service {
				font-weight: 600;
				color: var(--accent);
			}
			.waterfall-label .operation {
				color: var(--text-secondary);
				margin-left: 0.5rem;
			}
			.waterfall-bar-container {
				height: 24px;
				background: var(--bg-tertiary);
				border-radius: 4px;
				position: relative;
			}
			.waterfall-bar {
				position: absolute;
				height: 100%;
				border-radius: 4px;
				display: flex;
				align-items: center;
				padding: 0 0.5rem;
				font-size: 0.7rem;
				color: white;
				min-width: 40px;
			}
			.waterfall-bar-ok {
				background: var(--accent);
			}
			.waterfall-bar-error {
				background: var(--danger);
			}
		</style>
	}
}

func truncateID(id string) string {
	if len(id) > 16 {
		return id[:16] + "..."
	}
	return id
}

func waterfallBarClass(status string) string {
	if status == "error" {
		return "waterfall-bar-error"
	}
	return "waterfall-bar-ok"
}

func waterfallBarStyle(startOffset, duration, totalDuration float64) string {
	if totalDuration == 0 {
		return "left: 0; width: 100%;"
	}
	left := (startOffset / totalDuration) * 100
	width := (duration / totalDuration) * 100
	if width < 2 {
		width = 2
	}
	return fmt.Sprintf("left: %.1f%%; width: %.1f%%;", left, width)
}

func logSeverityVariant(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "danger"
	case "WARN":
		return "warning"
	default:
		return "neutral"
	}
}

func spansJSON(spans []SpanInfo) string {
	b, _ := json.Marshal(spans)
	return string(b)
}

func paginationURL(base, q, service, status string, window, limit, offset int) string {
	values := url.Values{}
	if q != "" {
		values.Set("q", q)
	}
	if service != "" {
		values.Set("service", service)
	}
	if status != "" {
		values.Set("status", status)
	}
	if window != 60 {
		values.Set("window", strconv.Itoa(window))
	}
	values.Set("limit", strconv.Itoa(limit))
	values.Set("offset", strconv.Itoa(offset))
	return base + "?" + values.Encode()
}

func traceFilterVariant(current, target string) string {
	if current == target {
		return "primary"
	}
	return "default"
}
