package web

import (
	"encoding/json"
	"fmt"
	"net/url"
	"strconv"
	"strings"
)

// TracesData for the traces search page
type TracesData struct {
	Query   string
	Traces  []TraceRow
	Limit   int
	Offset  int
	HasMore bool
	Window  int
	Facets  TraceFacets
}

// UniqueNamespace returns the namespace if all traces share it, empty otherwise
func (d TracesData) UniqueNamespace() string {
	if len(d.Traces) == 0 {
		return ""
	}
	ns := d.Traces[0].Namespace
	for _, t := range d.Traces[1:] {
		if t.Namespace != ns {
			return ""
		}
	}
	return ns
}

// TraceFacets contains aggregated counts for filtering
type TraceFacets struct {
	ByService []FacetCount
	ByStatus  []FacetCount
}

// FacetCount represents a count for a facet value
type FacetCount struct {
	Value string
	Count int
}

type TraceRow struct {
	TraceID   string
	Service   string
	Namespace string
	Operation string
	Duration  float64
	Status    string
	Time      string
}

// Traces renders the traces search page
templ Traces(data TracesData) {
	@Layout("Traces", "traces", data.Window) {
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Traces</h1>
				<p class="page-subtitle">Search and analyze distributed traces</p>
			</div>
		</div>
		<div class="quick-filters">
			<sl-button href={ tracesURL("", data.Window, data.Limit, 0) } size="small" variant={ traceFilterVariant(data.Query, "") }>All</sl-button>
			<sl-button href={ tracesURL("status:error", data.Window, data.Limit, 0) } size="small" variant={ traceFilterVariant(data.Query, "status:error") }>
				<sl-icon slot="prefix" name="exclamation-triangle"></sl-icon>
				Errors
			</sl-button>
			<sl-button href={ tracesURL("status:slow", data.Window, data.Limit, 0) } size="small" variant={ traceFilterVariant(data.Query, "status:slow") }>
				<sl-icon slot="prefix" name="clock"></sl-icon>
				Slow (&gt;1s)
			</sl-button>
		</div>
		<!-- Search Form -->
		<div class="search-section">
			<form method="GET" action="/traces" onsubmit="return cleanFormSubmit(this)">
				<div class="form-row">
					<sl-input name="q" placeholder="service:cart status:error op:checkout duration:>1000" value={ data.Query }></sl-input>
					<sl-button type="submit" variant="primary">Search</sl-button>
				</div>
				<div class="search-hint">
					<code>service:name</code> <code>op:checkout</code> <code>status:error</code> <code>duration:&gt;1000</code> <code>attr:key=value</code> <code>"phrase"</code> <code>-exclude</code>
				</div>
			</form>
		</div>
		<!-- Facets -->
		if len(data.Facets.ByService) > 0 || len(data.Facets.ByStatus) > 0 {
			<div class="facets-bar">
				if len(data.Facets.ByStatus) > 0 {
					<div class="facet-group">
						<span class="facet-label">Status</span>
						for _, f := range data.Facets.ByStatus {
							<a href={ facetURL(data.Query, "status", f.Value, data.Window) } class="facet-link">
								<sl-tag size="small" class={ facetTagClass(f.Value) }>{ f.Value }<span class="facet-count">{ fmt.Sprintf("%d", f.Count) }</span></sl-tag>
							</a>
						}
					</div>
				}
				if len(data.Facets.ByService) > 0 {
					<div class="facet-group">
						<span class="facet-label">Services</span>
						for _, f := range data.Facets.ByService {
							<a href={ facetURL(data.Query, "service", f.Value, data.Window) } class="facet-link">
								<sl-tag size="small">{ f.Value }<span class="facet-count">{ fmt.Sprintf("%d", f.Count) }</span></sl-tag>
							</a>
						}
					</div>
				}
			</div>
		}
		<!-- Results -->
		<div class="results-section">
			<div class="results-header">Results ({ fmt.Sprintf("%d", len(data.Traces)) } traces)</div>
			if len(data.Traces) == 0 {
				<div class="empty-state" style="padding: 3rem;">
					<sl-icon name="search"></sl-icon>
					<div class="empty-state-title">No traces found</div>
					<div class="empty-state-message">Try adjusting your search filters or expanding the time window.</div>
				</div>
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Trace ID</th>
							<th>Service</th>
							if data.UniqueNamespace() == "" {
								<th>Namespace</th>
							}
							<th>Operation</th>
							<th>Duration</th>
							<th>Status</th>
							<th>Time</th>
						</tr>
					</thead>
					<tbody>
						for _, t := range data.Traces {
							<tr>
								<td><a href={ templ.SafeURL(withWindow("/traces/"+pathEscape(t.TraceID), data.Window)) }>{ truncateID(t.TraceID) }</a></td>
								<td>
									if t.Service != "" {
										<a href={ templ.SafeURL(withWindow("/services/"+pathEscape(t.Service), data.Window)) }>{ t.Service }</a>
									} else {
										<span style="color: var(--text-muted);">—</span>
									}
								</td>
								if data.UniqueNamespace() == "" {
									<td>
										if t.Namespace != "" {
											<sl-tag size="small" class="ns-tag">{ t.Namespace }</sl-tag>
										} else {
											<span style="color: var(--text-muted);">—</span>
										}
									</td>
								}
								<td>{ t.Operation }</td>
								<td>{ fmt.Sprintf("%.0fms", t.Duration) }</td>
								<td>
									if t.Status == "error" {
										<sl-badge variant="danger" pill>error</sl-badge>
									} else {
										<sl-badge variant="success" pill>ok</sl-badge>
									}
								</td>
								<td><sl-relative-time date={ t.Time }></sl-relative-time></td>
							</tr>
						}
					</tbody>
				</table>
				<!-- Pagination -->
				<div class="pagination">
					<sl-button href={ tracesURL(data.Query, data.Window, data.Limit, clampMin(data.Offset-data.Limit)) } variant="default" size="small" disabled?={ data.Offset == 0 }>
						<sl-icon slot="prefix" name="chevron-left"></sl-icon>
						Previous
					</sl-button>
					<span class="pagination-info">{ fmt.Sprintf("%d", data.Offset+1) } - { fmt.Sprintf("%d", data.Offset+len(data.Traces)) }</span>
					<sl-button href={ tracesURL(data.Query, data.Window, data.Limit, data.Offset+data.Limit) } variant="default" size="small" disabled?={ !data.HasMore }>
						Next
						<sl-icon slot="suffix" name="chevron-right"></sl-icon>
					</sl-button>
				</div>
			}
		</div>
	}
}

// TraceDetailData for the trace detail page
type TraceDetailData struct {
	TraceID     string
	RootService string
	RootOp      string
	Duration    float64
	SpanCount   int
	Spans       []SpanInfo
	Logs        []LogInfo
	RootCause   string
	Window      int
}

type SpanInfo struct {
	SpanID       string
	ParentID     string
	Service      string
	Operation    string
	Duration     float64
	SelfTime     float64
	Status       string
	StatusMsg    string
	Kind         string
	StartOffset  float64
	Depth        int
	Events       []SpanEvent
	Links        []SpanLink
	TraceState   string
	Flags        uint32
	ScopeName    string
	ScopeVersion string
	Attributes   map[string]any
}

type SpanEvent struct {
	Time       int64
	Name       string
	Attributes map[string]string
}

type SpanLink struct {
	TraceID    string
	SpanID     string
	TraceState string
	Attributes map[string]string
}

type LogInfo struct {
	Time           string
	ObservedTime   string
	Service        string
	Severity       string
	SeverityNumber int32
	Body           string
	SpanID         string
	Flags          uint32
	ScopeName      string
	ScopeVersion   string
	Attributes     map[string]any
}

// TraceDetail renders the trace detail page with waterfall
templ TraceDetail(data TraceDetailData) {
	@Layout("Trace "+truncateID(data.TraceID), "traces", data.Window) {
		<nav class="breadcrumbs">
			<sl-breadcrumb>
				<sl-breadcrumb-item href={ withWindow("/", data.Window) }>Overview</sl-breadcrumb-item>
				<sl-breadcrumb-item href={ withWindow("/traces", data.Window) }>Traces</sl-breadcrumb-item>
				<sl-breadcrumb-item>{ truncateID(data.TraceID) }</sl-breadcrumb-item>
			</sl-breadcrumb>
		</nav>
		<div class="page-header">
			<div class="page-header-left">
				<h1 class="page-title">Trace { truncateID(data.TraceID) }</h1>
				<p class="page-subtitle">{ data.RootService } / { data.RootOp } - { fmt.Sprintf("%.0fms", data.Duration) }</p>
			</div>
		</div>
		<!-- Summary -->
		<div class="grid grid-4" style="margin-bottom: 1rem;">
			<sl-card class="metric-card">
				<div class="metric-value">{ fmt.Sprintf("%.0f", data.Duration) }ms</div>
				<div class="metric-label">Total Duration</div>
			</sl-card>
			<sl-card class="metric-card">
				<div class="metric-value">{ fmt.Sprintf("%d", data.SpanCount) }</div>
				<div class="metric-label">Spans</div>
			</sl-card>
			<sl-card class="metric-card">
				<div class="metric-value">{ data.RootService }</div>
				<div class="metric-label">Root Service</div>
			</sl-card>
			<sl-card class="metric-card">
				if data.RootCause != "" {
					<div class="metric-value" style="color: var(--danger); font-size: 1rem;">{ data.RootCause }</div>
				} else {
					<div class="metric-value" style="color: var(--success);">None</div>
				}
				<div class="metric-label">Root Cause</div>
			</sl-card>
		</div>
		<!-- Waterfall Chart -->
		<sl-card style="margin-bottom: 1rem;">
			<div slot="header" class="card-header" style="display: flex; align-items: center; justify-content: space-between;">
				<span>Trace Waterfall</span>
				<div class="waterfall-legend">
					<span class="legend-item"><span class="legend-dot legend-server"></span>Server</span>
					<span class="legend-item"><span class="legend-dot legend-client"></span>Client</span>
					<span class="legend-item"><span class="legend-dot legend-internal"></span>Internal</span>
					<span class="legend-item"><span class="legend-dot legend-error"></span>Error</span>
				</div>
			</div>
			<!-- Time Ruler -->
			<div class="waterfall-ruler">
				<div class="ruler-spacer"></div>
				<div class="ruler-scale">
					<span class="ruler-tick" style="left: 0%;">0ms</span>
					<span class="ruler-tick" style="left: 25%;">{ fmt.Sprintf("%.0fms", data.Duration*0.25) }</span>
					<span class="ruler-tick" style="left: 50%;">{ fmt.Sprintf("%.0fms", data.Duration*0.5) }</span>
					<span class="ruler-tick" style="left: 75%;">{ fmt.Sprintf("%.0fms", data.Duration*0.75) }</span>
					<span class="ruler-tick" style="left: 100%;">{ fmt.Sprintf("%.0fms", data.Duration) }</span>
				</div>
			</div>
			<div class="waterfall">
				for i, span := range data.Spans {
					<div class={ "waterfall-row", spanRowClass(span.Status) } data-span-id={ span.SpanID }>
						<div class="waterfall-info" style={ fmt.Sprintf("padding-left: %dpx;", span.Depth*20+8) }>
							<button class="waterfall-toggle" aria-expanded="false" aria-controls={ fmt.Sprintf("span-detail-%d", i) }>
								<sl-icon name="chevron-right" class="toggle-icon"></sl-icon>
							</button>
							<div class="waterfall-label">
								<span class="service">{ span.Service }</span>
								<span class="operation">{ span.Operation }</span>
								if span.Status == "error" && span.StatusMsg != "" {
									<sl-tooltip content={ span.StatusMsg }>
										<span class="error-hint">
											<sl-icon name="exclamation-circle"></sl-icon>
										</span>
									</sl-tooltip>
								}
								if len(span.Events) > 0 {
									<span class="events-badge" title={ eventsTitle(span.Events) }>
										<sl-icon name="lightning-charge"></sl-icon>
										{ fmt.Sprintf("%d", len(span.Events)) }
									</span>
								}
								if len(span.Links) > 0 {
									<span class="links-badge" title={ fmt.Sprintf("%d linked traces", len(span.Links)) }>
										<sl-icon name="link-45deg"></sl-icon>
										{ fmt.Sprintf("%d", len(span.Links)) }
									</span>
								}
							</div>
						</div>
						<div class="waterfall-bar-container">
							<div
								class={ "waterfall-bar", waterfallBarClass(span.Status, span.Kind) }
								style={ waterfallBarStyle(span.StartOffset, span.Duration, data.Duration) }
							>
								{ fmt.Sprintf("%.0fms", span.Duration) }
							</div>
						</div>
					</div>
					<div class="span-detail" id={ fmt.Sprintf("span-detail-%d", i) } hidden>
						<div class="span-detail-content" style={ fmt.Sprintf("margin-left: %dpx;", span.Depth*20+32) }>
							<div class="span-detail-grid">
								<div class="span-detail-item">
									<span class="span-detail-label">Span ID</span>
									<span class="span-detail-value mono">{ span.SpanID }</span>
								</div>
								if span.ParentID != "" {
									<div class="span-detail-item">
										<span class="span-detail-label">Parent ID</span>
										<span class="span-detail-value mono">{ span.ParentID }</span>
									</div>
								}
								<div class="span-detail-item">
									<span class="span-detail-label">Duration</span>
									<span class="span-detail-value">{ fmt.Sprintf("%.2fms", span.Duration) }</span>
								</div>
								<div class="span-detail-item">
									<span class="span-detail-label">Self Time</span>
									<span class="span-detail-value">{ fmt.Sprintf("%.2fms", span.SelfTime) }</span>
								</div>
								<div class="span-detail-item">
									<span class="span-detail-label">Start Offset</span>
									<span class="span-detail-value">{ fmt.Sprintf("+%.2fms", span.StartOffset) }</span>
								</div>
								if span.Kind != "" {
									<div class="span-detail-item">
										<span class="span-detail-label">Kind</span>
										<span class="span-detail-value">{ span.Kind }</span>
									</div>
								}
								<div class="span-detail-item">
									<span class="span-detail-label">Status</span>
									<span class={ "span-detail-value", spanStatusClass(span.Status) }>{ span.Status }</span>
								</div>
								if span.ScopeName != "" {
									<div class="span-detail-item">
										<span class="span-detail-label">Scope</span>
										<span class="span-detail-value">{ span.ScopeName }{ fmtScopeVersion(span.ScopeVersion) }</span>
									</div>
								}
							</div>
							if span.StatusMsg != "" {
								<div class="span-error-msg">
									<sl-icon name="exclamation-triangle"></sl-icon>
									{ span.StatusMsg }
								</div>
							}
							if len(span.Events) > 0 {
								<div class="span-section">
									<div class="span-section-title">Events ({ fmt.Sprintf("%d", len(span.Events)) })</div>
									<div class="span-events">
										for _, ev := range span.Events {
											<div class="span-event">
												<span class="event-name">{ ev.Name }</span>
												if len(ev.Attributes) > 0 {
													<span class="event-attrs">{ fmtAttrs(ev.Attributes) }</span>
												}
											</div>
										}
									</div>
								</div>
							}
							if len(span.Links) > 0 {
								<div class="span-section">
									<div class="span-section-title">Links ({ fmt.Sprintf("%d", len(span.Links)) })</div>
									<div class="span-links">
										for _, ln := range span.Links {
											<div class="span-link">
												<a href={ templ.SafeURL(withWindow("/traces/"+pathEscape(ln.TraceID), data.Window)) } class="link-trace">{ truncateID(ln.TraceID) }</a>
												<span class="link-span">span: { truncateID(ln.SpanID) }</span>
											</div>
										}
									</div>
								</div>
							}
							if len(span.Attributes) > 0 {
								<div class="span-section">
									<div class="span-section-title">Attributes</div>
									<div class="span-attributes">
										for k, v := range span.Attributes {
											<div class="attr-row">
												<span class="attr-key">{ k }</span>
												<span class="attr-value">{ fmtAttrValue(v) }</span>
											</div>
										}
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>
		</sl-card>
		<script>
			// Waterfall expand/collapse
			document.querySelectorAll('.waterfall-toggle').forEach(btn => {
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					const row = btn.closest('.waterfall-row');
					const detail = row.nextElementSibling;
					const expanded = btn.getAttribute('aria-expanded') === 'true';
					btn.setAttribute('aria-expanded', !expanded);
					btn.querySelector('.toggle-icon').name = expanded ? 'chevron-right' : 'chevron-down';
					detail.hidden = expanded;
				});
			});
			// Click row to toggle
			document.querySelectorAll('.waterfall-row').forEach(row => {
				row.addEventListener('click', () => {
					row.querySelector('.waterfall-toggle')?.click();
				});
			});
		</script>
		<!-- Logs -->
		if len(data.Logs) > 0 {
			<sl-card>
				<div slot="header" class="card-header">Correlated Logs ({ fmt.Sprintf("%d", len(data.Logs)) })</div>
				<table class="table">
					<thead>
						<tr>
							<th>Time</th>
							<th>Service</th>
							<th>Severity</th>
							<th>Message</th>
						</tr>
					</thead>
					<tbody>
						for _, log := range data.Logs {
							<tr>
								<td>{ log.Time }</td>
								<td>{ log.Service }</td>
								<td>
									<sl-badge variant={ logSeverityVariant(log.Severity) } pill>{ log.Severity }</sl-badge>
								</td>
								<td style="font-family: var(--font-mono); font-size: 0.8rem;">{ log.Body }</td>
							</tr>
						}
					</tbody>
				</table>
			</sl-card>
		}
		<style>
			/* Time Ruler */
			.waterfall-ruler {
				display: grid;
				grid-template-columns: 320px 1fr;
				gap: 1rem;
				padding: 0 0 0.5rem;
				border-bottom: 1px solid var(--border-color);
				margin-bottom: 0.5rem;
			}
			.ruler-spacer {
				/* Matches waterfall-info width */
			}
			.ruler-scale {
				position: relative;
				height: 20px;
			}
			.ruler-tick {
				position: absolute;
				transform: translateX(-50%);
				font-size: 0.65rem;
				color: var(--text-muted);
				white-space: nowrap;
			}
			.ruler-tick:first-child {
				transform: translateX(0);
			}
			.ruler-tick:last-child {
				transform: translateX(-100%);
			}

			/* Legend */
			.waterfall-legend {
				display: flex;
				gap: 1rem;
				font-size: 0.75rem;
				font-weight: 400;
			}
			.legend-item {
				display: flex;
				align-items: center;
				gap: 0.375rem;
				color: var(--text-muted);
			}
			.legend-dot {
				width: 10px;
				height: 10px;
				border-radius: 2px;
			}
			.legend-server { background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); }
			.legend-client { background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); }
			.legend-internal { background: linear-gradient(135deg, #64748b 0%, #475569 100%); }
			.legend-error { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); }

			.waterfall {
				display: flex;
				flex-direction: column;
			}
			.waterfall-row {
				display: grid;
				grid-template-columns: 320px 1fr;
				gap: 1rem;
				align-items: center;
				padding: 0.375rem 0;
				border-radius: 0.375rem;
				cursor: pointer;
				transition: background 0.1s;
			}
			.waterfall-row:hover {
				background: var(--bg-tertiary);
			}
			.waterfall-row-error {
				background: rgba(239, 68, 68, 0.05);
			}
			.waterfall-row-error:hover {
				background: rgba(239, 68, 68, 0.1);
			}
			.waterfall-info {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.waterfall-toggle {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 20px;
				height: 20px;
				padding: 0;
				border: none;
				background: none;
				color: var(--text-muted);
				cursor: pointer;
				border-radius: 0.25rem;
				flex-shrink: 0;
			}
			.waterfall-toggle:hover {
				background: var(--bg-tertiary);
				color: var(--text-primary);
			}
			.waterfall-toggle .toggle-icon {
				font-size: 0.75rem;
			}
			.waterfall-label {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.8rem;
				overflow: hidden;
				min-width: 0;
			}
			.waterfall-label .service {
				font-weight: 600;
				color: var(--accent);
				flex-shrink: 0;
			}
			.waterfall-label .operation {
				color: var(--text-secondary);
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.waterfall-label .error-hint {
				color: var(--danger);
				flex-shrink: 0;
			}
			.waterfall-label .events-badge,
			.waterfall-label .links-badge {
				display: inline-flex;
				align-items: center;
				gap: 2px;
				font-size: 10px;
				padding: 1px 4px;
				border-radius: 4px;
				flex-shrink: 0;
				cursor: help;
			}
			.waterfall-label .events-badge {
				background: var(--sl-color-warning-100);
				color: var(--sl-color-warning-700);
			}
			.waterfall-label .links-badge {
				background: var(--sl-color-primary-100);
				color: var(--sl-color-primary-700);
			}
			.waterfall-bar-container {
				height: 24px;
				background: var(--bg-tertiary);
				border-radius: 4px;
				position: relative;
			}
			.waterfall-bar {
				position: absolute;
				height: 100%;
				border-radius: 4px;
				display: flex;
				align-items: center;
				padding: 0 0.5rem;
				font-size: 0.7rem;
				color: white;
				min-width: 40px;
				font-weight: 500;
				text-shadow: 0 1px 1px rgba(0,0,0,0.2);
			}
			/* Error always takes priority */
			.waterfall-bar-error {
				background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
			}
			/* Kind-based colors (when not error) */
			.waterfall-bar-server {
				background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
			}
			.waterfall-bar-client {
				background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
			}
			.waterfall-bar-producer {
				background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
			}
			.waterfall-bar-consumer {
				background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
			}
			.waterfall-bar-internal {
				background: linear-gradient(135deg, #64748b 0%, #475569 100%);
			}
			/* Default fallback */
			.waterfall-bar-ok {
				background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
			}
			/* Span detail panel */
			.span-detail {
				overflow: hidden;
			}
			.span-detail-content {
				padding: 0.75rem 1rem;
				margin: 0.25rem 0 0.5rem;
				background: var(--bg-tertiary);
				border-radius: 0.5rem;
				border-left: 3px solid var(--accent);
			}
			.waterfall-row-error + .span-detail .span-detail-content {
				border-left-color: var(--danger);
			}
			.span-detail-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 0.75rem;
			}
			.span-detail-item {
				display: flex;
				flex-direction: column;
				gap: 0.125rem;
			}
			.span-detail-label {
				font-size: 0.65rem;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.span-detail-value {
				font-size: 0.8rem;
				color: var(--text-primary);
			}
			.span-detail-value.mono {
				font-family: var(--font-mono);
				font-size: 0.75rem;
			}
			.span-detail-value.status-error {
				color: var(--danger);
				font-weight: 600;
			}
			.span-detail-value.status-ok {
				color: var(--success);
			}
			.span-error-msg {
				display: flex;
				align-items: flex-start;
				gap: 0.5rem;
				margin-top: 0.75rem;
				padding: 0.625rem 0.75rem;
				background: rgba(239, 68, 68, 0.1);
				border-radius: 0.375rem;
				font-size: 0.8rem;
				color: var(--danger);
				font-family: var(--font-mono);
				word-break: break-word;
			}
			.span-error-msg sl-icon {
				flex-shrink: 0;
				margin-top: 0.125rem;
			}
			/* New sections for events, links, attributes */
			.span-section {
				margin-top: 0.75rem;
				padding-top: 0.75rem;
				border-top: 1px solid var(--border-color);
			}
			.span-section-title {
				font-size: 0.7rem;
				font-weight: 600;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 0.5rem;
			}
			.span-events, .span-links {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}
			.span-event {
				display: flex;
				gap: 0.5rem;
				font-size: 0.75rem;
				padding: 0.25rem 0.5rem;
				background: var(--bg-tertiary);
				border-radius: 0.25rem;
			}
			.event-name {
				font-weight: 500;
				color: var(--text-primary);
			}
			.event-attrs {
				color: var(--text-muted);
				font-family: var(--font-mono);
				font-size: 0.7rem;
			}
			.span-link {
				display: flex;
				gap: 0.5rem;
				font-size: 0.75rem;
				padding: 0.25rem 0.5rem;
				background: var(--bg-tertiary);
				border-radius: 0.25rem;
			}
			.link-trace {
				color: var(--accent);
				text-decoration: none;
				font-family: var(--font-mono);
			}
			.link-trace:hover {
				text-decoration: underline;
			}
			.link-span {
				color: var(--text-muted);
				font-family: var(--font-mono);
			}
			.span-attributes {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}
			.attr-row {
				display: flex;
				gap: 0.5rem;
				font-size: 0.75rem;
				padding: 0.25rem 0.5rem;
				background: var(--bg-tertiary);
				border-radius: 0.25rem;
			}
			.attr-key {
				font-weight: 500;
				color: var(--accent);
				min-width: 120px;
			}
			.attr-value {
				color: var(--text-primary);
				font-family: var(--font-mono);
				word-break: break-all;
			}
			/* Mobile responsive waterfall */
			@media (max-width: 768px) {
				.waterfall-ruler {
					grid-template-columns: 1fr;
					gap: 0;
				}
				.ruler-spacer { display: none; }
				.waterfall-row {
					grid-template-columns: 1fr;
					gap: 0.25rem;
				}
				.waterfall-info {
					padding-left: 8px !important;
				}
				.waterfall-bar-container {
					margin-left: 28px;
				}
				.span-detail-content {
					margin-left: 8px !important;
				}
			}
		</style>
	}
}

func waterfallBarClass(status, kind string) string {
	if status == "error" {
		return "waterfall-bar-error"
	}
	// Map span kind to color class
	switch {
	case strings.Contains(kind, "SERVER"):
		return "waterfall-bar-server"
	case strings.Contains(kind, "CLIENT"):
		return "waterfall-bar-client"
	case strings.Contains(kind, "PRODUCER"):
		return "waterfall-bar-producer"
	case strings.Contains(kind, "CONSUMER"):
		return "waterfall-bar-consumer"
	case strings.Contains(kind, "INTERNAL"):
		return "waterfall-bar-internal"
	default:
		return "waterfall-bar-ok"
	}
}

func waterfallBarStyle(startOffset, duration, totalDuration float64) string {
	if totalDuration == 0 {
		return "left: 0; width: 100%;"
	}
	left := (startOffset / totalDuration) * 100
	width := (duration / totalDuration) * 100
	if width < 2 {
		width = 2
	}
	return fmt.Sprintf("left: %.1f%%; width: %.1f%%;", left, width)
}

func logSeverityVariant(severity string) string {
	switch severity {
	case "ERROR", "FATAL":
		return "danger"
	case "WARN":
		return "warning"
	default:
		return "neutral"
	}
}

func spansJSON(spans []SpanInfo) string {
	b, _ := json.Marshal(spans)
	return string(b)
}

func tracesURL(q string, window, limit, offset int) templ.SafeURL {
	values := url.Values{}
	if q != "" {
		values.Set("q", q)
	}
	if window != 60 {
		values.Set("window", strconv.Itoa(window))
	}
	if limit != 50 {
		values.Set("limit", strconv.Itoa(limit))
	}
	if offset > 0 {
		values.Set("offset", strconv.Itoa(offset))
	}
	if len(values) == 0 {
		return "/traces"
	}
	return templ.SafeURL("/traces?" + values.Encode())
}

func traceFilterVariant(current, target string) string {
	// Check if current query contains the target filter
	if target == "" && current == "" {
		return "primary"
	}
	if target != "" && strings.Contains(current, target) {
		return "primary"
	}
	return "default"
}

func facetURL(query, facetType, value string, window int) templ.SafeURL {
	// Build a URL that adds/replaces the facet filter in the query
	newQuery := query
	prefix := facetType + ":"
	// Check if facet is already in query
	if strings.Contains(query, prefix+value) {
		return tracesURL(query, window, 0, 0)
	}
	// Add facet to query
	if newQuery != "" {
		newQuery += " "
	}
	newQuery += prefix + value
	return tracesURL(newQuery, window, 0, 0)
}

func facetChipClass(value string) string {
	if value == "error" {
		return "facet-error"
	}
	return ""
}

func facetTagClass(value string) string {
	if value == "error" {
		return "facet-error"
	}
	return ""
}

func spanRowClass(status string) string {
	if status == "error" {
		return "waterfall-row-error"
	}
	return ""
}

func spanStatusClass(status string) string {
	if status == "error" {
		return "status-error"
	}
	return "status-ok"
}

func eventsTitle(events []SpanEvent) string {
	if len(events) == 0 {
		return ""
	}
	names := make([]string, 0, len(events))
	for _, e := range events {
		names = append(names, e.Name)
	}
	return strings.Join(names, ", ")
}

