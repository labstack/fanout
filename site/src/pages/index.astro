---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Nav from "../components/site/Nav.astro";
import Hero from "../components/site/Hero.astro";
import OverviewPreview from "../components/site/OverviewPreview.astro";
import OutcomeCards from "../components/site/OutcomeCards.astro";
import ChatInvestigator from "../components/site/ChatInvestigator.astro";
import HowItWorks from "../components/site/HowItWorks.astro";
import CtaStrip from "../components/site/CtaStrip.astro";
import Footer from "../components/site/Footer.astro";

const title = "Fanout — Observability that runs anywhere you can run a binary.";
const description =
  "Send your traces, logs, and metrics over OpenTelemetry. Get a fast UI, a chat investigator, and alerts — without standing up a stack. Self-hosted, single binary.";
---

<MarketingLayout title={title} description={description}>
  <Nav />
  <main class="site">
    <Hero />
    <OverviewPreview />
    <OutcomeCards />
    <ChatInvestigator />
    <HowItWorks />
    <CtaStrip />
  </main>
  <Footer />
</MarketingLayout>
