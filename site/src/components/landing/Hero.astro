---
import ThroughputReplay from "./ThroughputReplay.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<div class="fo-hero">
  <div class="fo-hero-copy">
    <h1 id="_top">{title}</h1>
    {tagline && <p class="fo-hero-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="fo-hero-actions">
          {actions.map((action, i) => (
            <a
              href={action.link}
              class={i === 0 ? "fo-action fo-action-primary" : "fo-action"}
              data-analytics-event="cta_click"
              data-analytics-action={action.link.includes("demo") ? "live_demo" : "install"}
              data-analytics-location="hero"
              {...action.attrs}
            >
              {action.text}
            </a>
          ))}
        </div>
      )
    }
  </div>
  <ThroughputReplay />
</div>

<style>
  .fo-hero {
    display: grid;
    min-width: 0;
    gap: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.5rem, 4vw, 3rem) 0 2rem;
    font-family: var(--fo-font-display);
  }

  .fo-hero-copy { max-width: 58rem; }

  .fo-hero-copy h1#_top {
    font-family: var(--fo-font-display);
    font-size: clamp(2.1rem, 4vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin: 0 0 1.25rem;
    color: var(--sl-color-white);
    text-wrap: balance;
    overflow-wrap: normal;
  }

  .fo-hero-tagline {
    font-family: var(--fo-font-body);
    color: var(--sl-color-gray-2);
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0 0 1.5rem;
    max-width: 54ch;
    text-wrap: pretty;
  }

  .fo-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  /* The filled white button is the CTA's whole job. Nothing else on the page
     may use a filled light surface — that is what keeps one button reading as
     the single thing to press. */
  .fo-action {
    display: inline-block;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 7px;
    padding: 0.78rem 1.25rem;
    font-family: var(--fo-font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .fo-action:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }

  .fo-action:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .fo-action-primary {
    background: var(--sl-color-white);
    border-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .fo-action-primary:hover {
    background: var(--sl-color-gray-1);
    border-color: var(--sl-color-gray-1);
  }

  @media (min-width: 72rem) {
    .fo-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
    }

    .fo-hero-copy h1#_top {
      font-size: clamp(2rem, 2.75vw, 2.5rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .fo-action {
      transition:
        border-color 0.15s ease,
        background-color 0.15s ease;
    }
  }

</style>
