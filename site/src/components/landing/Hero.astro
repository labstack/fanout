---
/* The landing page's hero, registered as Starlight's `Hero` override.
 *
 * Starlight renders this component instead of a page title whenever a page
 * declares `hero` in its frontmatter. Only the landing page does, so the
 * override is effectively page-scoped — but it is a global registration, and a
 * second splash page with a hero would get this layout too.
 *
 * The headline, tagline and actions stay in frontmatter so the copy is edited
 * where the rest of the site's copy lives. The transcript is here instead,
 * because it is structure rather than copy: the argument of the page is that
 * you ask Fanout a question in the words you would use to a colleague, and the
 * hero has to show one being asked and answered rather than describe it.
 *
 * The transcript is illustrative, not a recording. The numbers are the ones the
 * demo instance produces, and they are here to show the shape of an answer —
 * a claim, then the evidence it rests on, then the thing to do about it.
 */
import Icon from "../Icon.astro";

// A flat hour with a step change two thirds through: the shape of a regression
// rather than of noise, which is what makes the annotation worth drawing.
const series =
  "M0,92 L20,89 L40,94 L60,90 L80,93 L100,88 L120,92 L140,90 L160,94 L180,89 L200,92 L220,88 L240,84 L252,52 L272,44 L296,48 L320,44 L344,49 L372,45 L400,47";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<div class="fo-hero">
  <div class="fo-hero-copy">
    <h1 id="_top">{title}</h1>
    {tagline && <p class="fo-hero-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="fo-hero-actions">
          {actions.map((action, i) => (
            <a
              href={action.link}
              class={i === 0 ? "fo-action fo-action-primary" : "fo-action"}
              data-analytics-event="cta_click"
              data-analytics-action={action.link.includes("demo") ? "live_demo" : "install"}
              data-analytics-location="hero"
              {...action.attrs}
            >
              {action.text}
            </a>
          ))}
        </div>
      )
    }
    <p class="fo-hero-note">
      One Go process: OTLP in over gRPC or HTTP, authoritative Parquet on disk,
      indexed trace reads, and embedded DuckDB analytics. No database to
      operate.
    </p>
  </div>

  <div class="fo-scope" data-fo-scope>
    <div class="fo-scope-head">
      <span class="fo-scope-service">checkout</span>
      <span class="fo-scope-metric">p95 latency · last 1h</span>
    </div>

    <svg class="fo-scope-chart" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="fo-scope-fill" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="var(--fo-status-bad)" stop-opacity="0.28"></stop>
          <stop offset="1" stop-color="var(--fo-status-bad)" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path class="fo-scope-area" d={`${series} L400,120 L0,120 Z`} fill="url(#fo-scope-fill)"></path>
      <path class="fo-scope-line" d={series} fill="none" stroke="var(--fo-status-bad)" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"></path>
      <line class="fo-scope-mark" x1="252" y1="8" x2="252" y2="120"
        stroke="var(--sl-color-gray-4)" stroke-width="1" stroke-dasharray="3 3"></line>
      <circle class="fo-scope-dot" cx="252" cy="52" r="4.5" fill="var(--fo-status-bad)"></circle>
    </svg>

    <div class="fo-scope-axis">
      <span>13:20</span><span class="fo-scope-at">14:22</span><span>now</span>
    </div>

    <div class="fo-scope-readout">
      <div class="fo-scope-stat">
        <span>p95</span><b>412<i>ms</i></b><em class="fo-up">+38%</em>
      </div>
      <div class="fo-scope-stat">
        <span>errors</span><b>2.4<i>%</i></b><em class="fo-up">+0.2</em>
      </div>
      <div class="fo-scope-stat">
        <span>rps</span><b>1.2<i>k</i></b><em>stable</em>
      </div>
    </div>

    <p class="fo-scope-ask">why is checkout slow right now?</p>

    <p class="fo-scope-found">
      <Icon name="check-circle" weight="fill" />
      <span>missing index on <code>orders(user_id)</code> — 88% of slow spans block on db-orders</span>
    </p>
  </div>
</div>

<style>
  .fo-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding: 1.5rem 0 4.5rem;
    font-family: var(--fo-font-display);
  }

  @media (min-width: 62rem) {
    .fo-hero {
      /* The left column has to hold "Observability" on one line at the display
         size below. It was 0.86fr against a 31rem minimum on the right, which
         left 428px for a word that measures 487px — and Starlight sets
         `overflow-wrap: break-word`, so it snapped mid-word to "Observabili /
         ty" rather than overflowing visibly. */
      grid-template-columns: minmax(0, 1fr) minmax(27rem, 1fr);
      gap: clamp(2.5rem, 4vw, 4.5rem);
      align-items: center;
      padding-top: 3rem;
    }
  }

  /* The id is Starlight's own — it is what the skip link targets, and
     fanout.css already styles `h1#_top` for every other page. An id selector
     outranks any number of classes, so the landing headline has to be named the
     same way to set its own tracking. */
  .fo-hero-copy h1#_top {
    font-family: var(--fo-font-display);
    font-size: clamp(2.1rem, 3.2vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin: 0 0 1.5rem;
    color: var(--sl-color-white);
    text-wrap: balance;
    max-width: 17ch;
    /* A headline never breaks inside a word. Starlight's break-word is right
       for prose and wrong here: mono has no hyphenation to soften it, so the
       result reads as a typo rather than as a wrap. Sized above so the longest
       word fits the column; if a future headline does not, it should overflow
       loudly and be rewritten. */
    overflow-wrap: normal;
    word-break: normal;
  }

  .fo-hero-tagline {
    font-family: var(--fo-font-body);
    color: var(--sl-color-gray-2);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 1.8rem;
    max-width: 42rem;
  }

  .fo-hero-tagline code {
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
    background: none;
    border: 0;
    color: var(--sl-color-white);
    padding: 0;
  }

  .fo-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  /* The filled white button is the CTA's whole job. Nothing else on the page
     may use a filled light surface — that is what keeps one button reading as
     the single thing to press. */
  .fo-action {
    display: inline-block;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 7px;
    padding: 0.78rem 1.25rem;
    font-family: var(--fo-font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .fo-action:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }

  .fo-action:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .fo-action-primary {
    background: var(--sl-color-white);
    border-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .fo-action-primary:hover {
    background: var(--sl-color-gray-1);
    border-color: var(--sl-color-gray-1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .fo-action {
      transition:
        border-color 0.15s ease,
        background-color 0.15s ease;
    }
  }

  .fo-hero-note {
    font-family: var(--fo-font-body);
    margin: 1.5rem 0 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    max-width: 54ch;
  }

  /* The instrument, not a terminal. Fanout is read as charts and health
     states, so the hero shows one degrading service the way the product would
     — the question and the finding sit under the evidence rather than instead
     of it. */
  .fo-scope {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background: var(--sl-color-gray-6);
    padding: 1rem 1.1rem 1.15rem;
    box-shadow: 0 24px 60px -32px rgba(0, 0, 0, 0.65);
  }

  .fo-scope-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .fo-scope-service {
    font-size: 0.9rem;
    color: var(--sl-color-white);
  }

  .fo-scope-metric {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    margin-inline-start: auto;
  }

  .fo-scope-chart {
    display: block;
    width: 100%;
    height: 104px;
    overflow: visible;
  }

  .fo-scope-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.35rem;
    font-size: 0.64rem;
    color: var(--sl-color-gray-4);
  }

  .fo-scope-at {
    color: var(--fo-status-bad);
  }

  .fo-scope-readout {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
  }

  .fo-scope-stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .fo-scope-stat span {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-4);
  }

  .fo-scope-stat b {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--sl-color-white);
    font-variant-numeric: tabular-nums;
  }

  .fo-scope-stat b i {
    font-style: normal;
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
    margin-inline-start: 0.1rem;
  }

  .fo-scope-stat em {
    font-family: var(--fo-font-body);
    font-style: normal;
    font-size: 0.66rem;
    color: var(--sl-color-gray-3);
  }

  .fo-up {
    color: var(--fo-status-bad) !important;
  }

  /* The question, in the words a person would use. Set as a quotation rather
     than a prompt: there is no shell here, and a `>` would imply one. */
  .fo-scope-ask {
    margin: 1rem 0 0;
    padding-inline-start: 0.75rem;
    border-inline-start: 2px solid var(--sl-color-accent);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .fo-scope-found {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.7rem 0 0;
    font-family: var(--fo-font-body);
    font-size: 0.83rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }

  .fo-scope-found :global(svg) {
    color: var(--fo-status-ok);
    margin-top: 0.15rem;
  }

  .fo-scope-found code {
    font-family: var(--fo-font-display);
    font-size: 0.94em;
    color: var(--sl-color-white);
    background: none;
    padding: 0;
    border: 0;
  }

  /* The line draws itself once, on arrival. A chart that appears fully formed
     is a picture; one that draws is an instrument reporting. Everything after
     the line fades in behind it, and anyone who asked for less motion gets the
     finished state immediately. */
  @media (prefers-reduced-motion: no-preference) {
    .fo-scope[data-pending] .fo-scope-line {
      stroke-dasharray: 620;
      stroke-dashoffset: 620;
      animation: fo-draw 1.1s ease-out forwards;
    }

    .fo-scope[data-pending] .fo-scope-area,
    .fo-scope[data-pending] .fo-scope-mark,
    .fo-scope[data-pending] .fo-scope-dot,
    .fo-scope[data-pending] .fo-scope-ask,
    .fo-scope[data-pending] .fo-scope-found {
      opacity: 0;
      animation: fo-fade 0.5s ease-out forwards;
    }

    .fo-scope[data-pending] .fo-scope-area { animation-delay: 0.5s; }
    .fo-scope[data-pending] .fo-scope-mark { animation-delay: 0.9s; }
    .fo-scope[data-pending] .fo-scope-dot { animation-delay: 1s; }
    .fo-scope[data-pending] .fo-scope-ask { animation-delay: 1.2s; }
    .fo-scope[data-pending] .fo-scope-found { animation-delay: 1.5s; }
  }

  @keyframes fo-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes fo-fade {
    to { opacity: 1; }
  }

  @media (max-width: 38rem) {
    .fo-hero {
      padding-top: 0.75rem;
      padding-bottom: 3.5rem;
    }

    .fo-hero-copy h1#_top {
      font-size: clamp(2.2rem, 10vw, 2.9rem);
    }

    .fo-scope-metric {
      display: none;
    }
  }
</style>

<script>
  /* Arm the draw-in only when the panel is on screen, and only for readers who
     have not asked for reduced motion. The attribute is set by script rather
     than authored, so a page without JS shows the finished chart instead of an
     empty box waiting for an animation that will never run. */
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const scope = document.querySelector<HTMLElement>("[data-fo-scope]");

  if (scope && !reduced && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            scope.setAttribute("data-pending", "");
            observer.disconnect();
          }
        }
      },
      { threshold: 0.25 },
    );
    observer.observe(scope);
  }
</script>
