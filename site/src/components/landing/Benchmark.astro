---
/* Published v2026.10.7-alpha ingest result. The shared report data drives the
 * sustained composition, peak ranges, and the reusable sweep charts here and
 * on the methodology page. Green marks passed gates; throughput uses violet.
 */
import BenchmarkSweep from "./BenchmarkSweep.astro";
import { acceptedTotal, benchmark, composition, formatRate, peak, signalNames, type Signal } from "../../data/benchmark";

const signals: Signal[] = ["mixed", "traces", "logs", "metrics"];
const gates = ["generators exited successfully", "dropped rows 0", "no restarts", "Parquet verified"];
const compositionTotal = composition.reduce((sum, signal) => sum + signal.rate, 0);
---

<div class="fo-benchmark not-content" role="group" aria-labelledby="fo-benchmark-title">
  <div class="fo-benchmark-status">
    <span class="fo-published-dot" aria-hidden="true"></span>
    <span>Published benchmark · {benchmark.release}</span>
    <a href="/explanation/performance">methodology</a>
  </div>
  <p class="fo-benchmark-setup">Hetzner ccx33 · 8 dedicated vCPUs · 32 GB RAM · separate ccx33 generators</p>
  <div class="fo-benchmark-main">
    <div class="fo-benchmark-headline">
      <p class="fo-benchmark-kicker">Sustained mixed ingest</p>
      <p class="fo-benchmark-value" id="fo-benchmark-title">{formatRate(benchmark.sustained.accepted_per_second)} <span>items/s</span></p>
      <p class="fo-benchmark-copy">{benchmark.sustained.seconds} s · {benchmark.sustained.processes_per_signal} processes per signal<br />
        Fanout: {benchmark.sustained.fanout_cpu.toFixed(2)} cores average · {benchmark.sustained.peak_rss_gib.toFixed(1)} GiB peak RSS<br />
        Generator: {benchmark.sustained.generator_cpu.toFixed(2)} of 8 cores average</p>
      <div class="fo-composition" role="img" aria-label={composition.map((signal) => `${formatRate(signal.rate)} ${signal.label.toLowerCase()} per second`).join(", ")}>
        {composition.map((signal, index) => <span class={`fo-composition-${index}`} style={{ flexGrow: signal.rate / compositionTotal }}></span>)}
      </div>
      <ul class="fo-composition-key">
        {composition.map((signal, index) => <li><i class={`fo-composition-${index}`} aria-hidden="true"></i><span>{signal.label}</span><strong>{formatRate(signal.rate)}/s</strong></li>)}
      </ul>
    </div>
    <div class="fo-benchmark-chart"><BenchmarkSweep id="landing" signals={["mixed"]} /></div>
  </div>
  <div class="fo-signals-grid" role="group" aria-label="Median peak accepted items per second and ranges across three repetitions">
    {signals.map((signal) => {
      const point = peak(signal);
      return <div>
        <span>{signalNames[signal]} median peak</span>
        <strong>{formatRate(point.median)}<small> items/s</small></strong>
        <small>{formatRate(point.min)}–{formatRate(point.max)}</small>
        <small>{point.processes_per_signal} processes per signal</small>
      </div>;
    })}
  </div>
  <div class="fo-benchmark-foot">
    <div class="fo-gates" aria-label="Passed quality gates">{gates.map((gate) => <span><i aria-hidden="true">✓</i>{gate}</span>)}</div>
    <p>{(acceptedTotal / 1e6).toFixed(1)}M items accepted across the suite · <a href={benchmark.evidence}>raw evidence</a></p>
  </div>
</div>

<style>
  .fo-benchmark {
    --fo-bench-muted: var(--sl-color-gray-3);
    margin-top: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 2px;
    overflow: hidden;
    background: var(--sl-color-gray-6);
    font-family: var(--fo-font-display);
  }
  :global(:root[data-theme="light"]) .fo-benchmark { --fo-bench-muted: var(--sl-color-gray-2); }
  @media print { .fo-benchmark { --fo-bench-muted: var(--sl-color-gray-2); } }
  .fo-benchmark-status {
    padding: 0.7rem clamp(0.75rem, 2vw, 1.2rem);
    border-bottom: 1px solid var(--sl-color-gray-5);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--sl-color-black);
    font-size: 0.7rem;
    color: var(--sl-color-gray-2);
  }
  .fo-published-dot { width: 0.45rem; height: 0.45rem; flex-shrink: 0; border-radius: 50%; background: var(--fo-status-ok); }
  .fo-benchmark-status a { margin-inline-start: auto; }
  .fo-benchmark a { color: var(--sl-color-accent-high); text-underline-offset: 0.25em; }
  p.fo-benchmark-setup { margin: 0; max-width: none; padding: 0.7rem 1rem; border-bottom: 1px solid var(--sl-color-gray-5); font-family: var(--fo-font-display); font-size: 0.7rem; line-height: 1.6; color: var(--fo-bench-muted); }
  .fo-benchmark-main { display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); }
  .fo-benchmark-headline { min-width: 0; padding: clamp(1rem, 3vw, 2rem); }
  p.fo-benchmark-kicker { margin: 0; font-family: var(--fo-font-display); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fo-bench-muted); }
  p#fo-benchmark-title { margin: 0.7rem 0 0; max-width: none; font-family: var(--fo-font-display); font-size: clamp(2.25rem, 5.6vw, 4.25rem); font-weight: 400; line-height: 1; letter-spacing: -0.065em; color: var(--sl-color-white); white-space: nowrap; }
  .fo-benchmark-value span { font-size: 0.28em; letter-spacing: 0.02em; color: var(--fo-bench-muted); }
  p.fo-benchmark-copy { margin: 1rem 0 0; font-family: var(--fo-font-body); font-size: 0.8rem; line-height: 1.7; color: var(--fo-bench-muted); }
  .fo-benchmark-chart { min-width: 0; display: grid; align-content: center; background: var(--sl-color-black); border-inline-start: 1px solid var(--sl-color-gray-5); }
  .fo-composition { display: flex; height: 0.6rem; gap: 2px; margin-top: 1.5rem; }
  .fo-composition-0 { background: var(--sl-color-accent-high); }
  .fo-composition-1 { background: var(--sl-color-gray-2); }
  .fo-composition-2 { background: var(--sl-color-gray-4); }
  ul.fo-composition-key { list-style: none; margin: 0.75rem 0 0; padding: 0; }
  .fo-composition-key li { display: flex; align-items: center; gap: 0.5rem; margin: 0.25rem 0 0; font-family: var(--fo-font-display); font-size: 0.7rem; color: var(--fo-bench-muted); }
  .fo-composition-key i { width: 0.5rem; height: 0.5rem; flex-shrink: 0; }
  .fo-composition-key strong { margin-inline-start: auto; color: var(--sl-color-white); font-weight: 400; }
  .fo-signals-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--sl-color-gray-5); }
  .fo-signals-grid > div { min-width: 0; padding: 1rem clamp(0.75rem, 2vw, 1.2rem); border-inline-start: 1px solid var(--sl-color-gray-5); display: grid; gap: 0.3rem; }
  .fo-signals-grid > div:first-child { border-inline-start: 0; }
  .fo-signals-grid span, .fo-signals-grid small { font-size: 0.65rem; color: var(--fo-bench-muted); }
  .fo-signals-grid span { text-transform: uppercase; letter-spacing: 0.04em; }
  .fo-signals-grid strong { font-size: clamp(1rem, 2.2vw, 1.45rem); font-weight: 400; letter-spacing: -0.04em; color: var(--sl-color-white); }
  .fo-signals-grid strong small { letter-spacing: normal; white-space: nowrap; }
  .fo-benchmark-foot { padding: 0.8rem 1rem; border-top: 1px solid var(--sl-color-gray-5); background: var(--sl-color-black); }
  .fo-gates { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; }
  .fo-gates span { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.68rem; color: var(--sl-color-gray-2); }
  .fo-gates i { color: var(--fo-status-ok); font-style: normal; }
  .fo-benchmark-foot p { margin: 0.7rem 0 0; max-width: none; font-family: var(--fo-font-display); font-size: 0.68rem; color: var(--fo-bench-muted); }
  @media (max-width: 52rem) {
    .fo-benchmark-main { grid-template-columns: minmax(0, 1fr); }
    .fo-benchmark-chart { border-inline-start: 0; border-top: 1px solid var(--sl-color-gray-5); }
  }
  @media (max-width: 36rem) {
    .fo-benchmark-status { flex-wrap: wrap; }
    .fo-benchmark-status a { margin-inline-start: 1rem; }
    p#fo-benchmark-title { font-size: clamp(2rem, 12vw, 3.25rem); }
    .fo-signals-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fo-signals-grid > div:nth-child(3) { border-inline-start: 0; }
    .fo-signals-grid > div:nth-child(n + 3) { border-top: 1px solid var(--sl-color-gray-5); }
  }
</style>
