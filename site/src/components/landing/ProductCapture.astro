---
import { Picture } from "astro:assets";
import overviewLight from "../../assets/landing/overview-light.png";
import overviewDark from "../../assets/landing/overview-dark.png";
import mapLight from "../../assets/landing/service-map-light.png";
import mapDark from "../../assets/landing/service-map-dark.png";
import traceLight from "../../assets/landing/trace-light.png";
import traceDark from "../../assets/landing/trace-dark.png";

interface Props {
  view: "overview" | "service-map" | "trace";
  alt: string;
  eager?: boolean;
}

const { view, alt, eager = false } = Astro.props;
const captures = {
  overview: { light: overviewLight, dark: overviewDark },
  "service-map": { light: mapLight, dark: mapDark },
  trace: { light: traceLight, dark: traceDark },
};
const capture = captures[view];
const sizes = "(min-width: 72rem) 43rem, (min-width: 52rem) 65vw, 100vw";
---

<div class="fo-capture not-content">
  {(["light", "dark"] as const).map(theme => (
    <Picture pictureAttributes={{ class: `fo-capture-${theme}` }} src={capture[theme]} alt={alt}
      formats={["avif", "webp"]} width={capture[theme].width} height={capture[theme].height}
      widths={[480, 960, 1440, capture[theme].width].filter((width, index, widths) => width <= capture[theme].width && widths.indexOf(width) === index)} sizes={sizes}
      loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} />
  ))}
</div>

<style>
  .fo-capture {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-black);
  }
  .fo-capture :global(img) { display: block; width: 100%; height: auto; margin: 0; }
  .fo-capture :global(picture) { display: block; }
  .fo-capture :global(.fo-capture-light) { display: none; }
  :global(:root[data-theme="light"]) .fo-capture :global(.fo-capture-dark) { display: none; }
  :global(:root[data-theme="light"]) .fo-capture :global(.fo-capture-light) { display: block; }
  @media print {
    .fo-capture :global(.fo-capture-dark) { display: none; }
    .fo-capture :global(.fo-capture-light) { display: block; }
  }
</style>
