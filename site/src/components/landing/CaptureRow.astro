---
interface Props {
  eyebrow: string;
  columns?: boolean;
}

const { eyebrow, columns = false } = Astro.props;
---

<section class:list={["fo-capture-row not-content", { "fo-capture-columns": columns }]}>
  <div class="fo-capture-copy"><span class="fo-capture-eyebrow">{eyebrow}</span><slot /></div>
  {Astro.slots.has("capture") && <div class="fo-capture-media"><slot name="capture" /></div>}
</section>

<style>
  .fo-capture-row {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--fo-capture-gap);
  }
  .fo-capture-copy, .fo-capture-media { min-width: 0; width: 100%; margin: 0; }
  .fo-capture-eyebrow {
    display: block;
    margin-bottom: 0.75rem;
    font-family: var(--fo-font-display);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .fo-capture-copy :global(.sl-heading-wrapper) { margin: 0; }
  .fo-capture-copy :global(h2) {
    margin: 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.25;
    color: var(--sl-color-white);
    text-wrap: balance;
    overflow-wrap: normal;
  }
  .fo-capture-copy :global(p) {
    margin: 1rem 0 0;
    font-family: var(--fo-font-body);
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 60ch;
    text-wrap: pretty;
  }
  @media (min-width: 60rem) {
    .fo-capture-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; }
  }
</style>
