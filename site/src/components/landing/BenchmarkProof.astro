---
/* A publication-candidate benchmark rendered as an instrument, not a claim card.
 *
 * Every number in this component comes from the same fanout-bench report. The
 * status line is deliberately impossible to miss: this branch previews the
 * presentation before the required clean, repeated run replaces the candidate.
 * Green remains a health/status colour, matching the product; throughput uses
 * the site's violet interaction accent instead.
 */
const signals = [
  { name: "Traces", unit: "spans/s", value: "220,324" },
  { name: "Logs", unit: "records/s", value: "187,303" },
  { name: "Metrics", unit: "points/s", value: "209,638" },
];

const gates = ["server drops 0", "no restarts", "Parquet verified"];
---

<div class="fo-benchmark" aria-labelledby="fo-benchmark-title" data-fo-benchmark>
  <div class="fo-benchmark-status">
    <span class="fo-candidate-dot" aria-hidden="true"></span>
    <span>Publication candidate</span>
    <span class="fo-status-detail">one repetition · harness checkout was dirty</span>
  </div>

  <div class="fo-benchmark-main">
    <div class="fo-benchmark-headline">
      <p class="fo-benchmark-kicker">Sustained three-signal ingest</p>
      <p class="fo-benchmark-value" id="fo-benchmark-title">
        296,196 <span>items/s</span>
      </p>
      <p class="fo-benchmark-copy">
        Fanout's accepted-row counter over five minutes—not the load
        generator's requested rate.
      </p>

      <div class="fo-benchmark-flow" aria-label="Traces, logs, and metrics enter one Fanout binary and are stored as verified Parquet">
        <div class="fo-flow-inputs" aria-hidden="true">
          <span>TRACES</span>
          <span>LOGS</span>
          <span>METRICS</span>
        </div>
        <span class="fo-flow-line" aria-hidden="true"></span>
        <span class="fo-flow-core">FANOUT<br /><small>ONE BINARY</small></span>
        <span class="fo-flow-line" aria-hidden="true"></span>
        <span class="fo-flow-output">PARQUET<br /><small>VERIFIED</small></span>
      </div>
    </div>

    <figure class="fo-benchmark-chart">
      <figcaption>
        <span>Accepted throughput</span>
        <span>processes per signal</span>
      </figcaption>
      <svg viewBox="0 0 640 205" role="img" aria-labelledby="fo-chart-title fo-chart-desc">
        <title id="fo-chart-title">Accepted three-signal throughput by generator process count</title>
        <desc id="fo-chart-desc">Throughput rose from 38,853 items per second with one process per signal to 355,938 with sixteen processes per signal.</desc>
        <g class="fo-grid">
          <line x1="66" y1="20" x2="582" y2="20"></line>
          <line x1="66" y1="57.5" x2="582" y2="57.5"></line>
          <line x1="66" y1="95" x2="582" y2="95"></line>
          <line x1="66" y1="132.5" x2="582" y2="132.5"></line>
          <line x1="66" y1="170" x2="582" y2="170"></line>
        </g>
        <g class="fo-y-labels">
          <text x="54" y="24">400k</text>
          <text x="54" y="61.5">300k</text>
          <text x="54" y="99">200k</text>
          <text x="54" y="136.5">100k</text>
          <text x="54" y="174">0</text>
        </g>
        <path class="fo-area" d="M66 155 L195 139 L324 114 L453 56 L582 37 L582 170 L66 170 Z"></path>
        <path class="fo-line" d="M66 155 L195 139 L324 114 L453 56 L582 37"></path>
        <g class="fo-points">
          <circle cx="66" cy="155" r="4"></circle>
          <circle cx="195" cy="139" r="4"></circle>
          <circle cx="324" cy="114" r="4"></circle>
          <circle cx="453" cy="56" r="4"></circle>
          <circle cx="582" cy="37" r="4"></circle>
        </g>
        <g class="fo-x-labels">
          <text x="66" y="195">1</text>
          <text x="195" y="195">2</text>
          <text x="324" y="195">4</text>
          <text x="453" y="195">8</text>
          <text x="582" y="195">16</text>
        </g>
      </svg>
      <div class="fo-chart-endpoint" aria-hidden="true">
        <strong>355,938/s</strong>
        <span>short peak</span>
      </div>
    </figure>
  </div>

  <div class="fo-benchmark-signals" aria-label="Signal-specific peak throughput">
    {signals.map((signal) => (
      <div>
        <span>{signal.name}</span>
        <strong>{signal.value}</strong>
        <small>{signal.unit}</small>
      </div>
    ))}
    <div class="fo-total">
      <span>Entire suite</span>
      <strong>153.8M</strong>
      <small>items accepted</small>
    </div>
  </div>

  <div class="fo-benchmark-foot">
    <div class="fo-gates" aria-label="Quality gates">
      {gates.map((gate) => (
        <span><i aria-hidden="true">✓</i>{gate}</span>
      ))}
    </div>
    <p>v2026.8.11 · 8 logical CPUs · 15.6 GiB · same-host generators · OTLP/gRPC</p>
  </div>
</div>

<style>
  .fo-benchmark {
    --fo-bench-pass: #7fd962;
    --fo-bench-warn: #ffb454;
    margin-top: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 2px;
    overflow: hidden;
    background: var(--sl-color-gray-6);
    font-family: var(--fo-font-display);
  }

  :global(:root[data-theme="light"]) .fo-benchmark {
    --fo-bench-pass: #3c7a2a;
    --fo-bench-warn: #9a5b00;
  }

  .fo-benchmark-status {
    min-height: 2.35rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fo-bench-warn);
  }

  .fo-candidate-dot {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 16%, transparent);
  }

  .fo-status-detail {
    margin-inline-start: auto;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--sl-color-gray-3);
  }

  .fo-benchmark-main {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  }

  .fo-benchmark-headline,
  .fo-benchmark-chart {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .fo-benchmark-headline {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  p.fo-benchmark-kicker.fo-benchmark-kicker {
    margin: 0;
    font-family: var(--fo-font-display);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  p#fo-benchmark-title {
    margin: 0.7rem 0 0;
    max-width: none;
    font-family: var(--fo-font-display);
    font-size: clamp(2.25rem, 5.6vw, 4.25rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.065em;
    color: var(--sl-color-white);
    white-space: nowrap;
  }

  .fo-benchmark .fo-benchmark-value span {
    font-size: 0.28em;
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-3);
  }

  p.fo-benchmark-copy.fo-benchmark-copy {
    margin: 0.9rem 0 0;
    max-width: 44ch;
    font-family: var(--fo-font-body);
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--sl-color-gray-3);
  }

  .fo-benchmark-flow {
    display: grid;
    grid-template-columns: auto minmax(0.8rem, 1fr) auto minmax(0.8rem, 1fr) auto;
    align-items: center;
    margin-top: clamp(1.5rem, 4vw, 2.75rem);
    color: var(--sl-color-gray-3);
  }

  .fo-flow-inputs {
    display: grid;
    gap: 0.28rem;
    font-size: 0.54rem;
    letter-spacing: 0.07em;
  }

  .fo-flow-line {
    height: 1px;
    background: var(--sl-color-gray-4);
  }

  .fo-flow-core,
  .fo-flow-output {
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 1px;
    font-size: 0.68rem;
    line-height: 1.25;
    text-align: center;
    color: var(--sl-color-white);
  }

  .fo-flow-output {
    border-color: color-mix(in srgb, var(--fo-bench-pass) 45%, var(--sl-color-gray-5));
  }

  .fo-flow-core small,
  .fo-flow-output small {
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
  }

  .fo-flow-output small {
    color: var(--fo-bench-pass);
  }

  .fo-benchmark-chart {
    position: relative;
    margin: 0;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    background: color-mix(in srgb, var(--sl-color-black) 58%, transparent);
  }

  .fo-benchmark-chart figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .fo-benchmark-chart svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 1rem;
    overflow: visible;
  }

  .fo-grid line {
    stroke: var(--sl-color-gray-5);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  .fo-y-labels text,
  .fo-x-labels text {
    fill: var(--sl-color-gray-3);
    font-family: var(--fo-font-display);
    font-size: 10px;
  }

  .fo-y-labels text { text-anchor: end; }
  .fo-x-labels text { text-anchor: middle; }

  .fo-area {
    fill: color-mix(in srgb, var(--sl-color-accent) 13%, transparent);
  }

  .fo-line {
    fill: none;
    stroke: var(--sl-color-accent-high);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .fo-points circle {
    fill: var(--sl-color-black);
    stroke: var(--sl-color-accent-high);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .fo-chart-endpoint {
    position: absolute;
    top: 4rem;
    right: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    pointer-events: none;
  }

  .fo-chart-endpoint strong {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--sl-color-white);
  }

  .fo-chart-endpoint span {
    font-size: 0.55rem;
    color: var(--sl-color-gray-3);
  }

  .fo-benchmark-signals {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .fo-benchmark-signals > div {
    min-width: 0;
    padding: 1rem clamp(0.75rem, 2vw, 1.2rem);
    border-inline-start: 1px solid var(--sl-color-gray-5);
    display: grid;
    gap: 0.18rem;
  }

  .fo-benchmark-signals > div:first-child { border-inline-start: 0; }

  .fo-benchmark-signals span,
  .fo-benchmark-signals small {
    font-size: 0.58rem;
    color: var(--sl-color-gray-3);
  }

  .fo-benchmark-signals span {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fo-benchmark-signals strong {
    font-size: clamp(1rem, 2.2vw, 1.45rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    color: var(--sl-color-white);
  }

  .fo-total strong { color: var(--sl-color-accent-high); }

  .fo-benchmark-foot {
    padding: 0.75rem 0.9rem;
    border-top: 1px solid var(--sl-color-gray-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--sl-color-black);
  }

  .fo-gates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .fo-gates span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.58rem;
    color: var(--sl-color-gray-2);
  }

  .fo-gates i {
    color: var(--fo-bench-pass);
    font-style: normal;
  }

  .fo-benchmark .fo-benchmark-foot p {
    margin: 0;
    max-width: none;
    font-family: var(--fo-font-display);
    font-size: 0.56rem;
    line-height: 1.4;
    text-align: right;
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 52rem) {
    .fo-benchmark-main { grid-template-columns: minmax(0, 1fr); }
    .fo-benchmark-chart {
      border-inline-start: 0;
      border-top: 1px solid var(--sl-color-gray-5);
    }
    .fo-benchmark-foot {
      align-items: flex-start;
      flex-direction: column;
    }
    .fo-benchmark .fo-benchmark-foot p { text-align: left; }
  }

  @media (max-width: 36rem) {
    .fo-benchmark-status { align-items: flex-start; flex-wrap: wrap; }
    .fo-status-detail { width: 100%; margin-inline-start: 1rem; }
    p#fo-benchmark-title { font-size: clamp(2rem, 12vw, 3.25rem); }
    .fo-benchmark-flow { grid-template-columns: auto 1fr auto; row-gap: 0.55rem; }
    .fo-flow-inputs { grid-row: 1 / 3; }
    .fo-flow-line:nth-of-type(3) { display: none; }
    .fo-flow-output { grid-column: 3; }
    .fo-benchmark-signals { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fo-benchmark-signals > div:nth-child(3) { border-inline-start: 0; }
    .fo-benchmark-signals > div:nth-child(n + 3) { border-top: 1px solid var(--sl-color-gray-5); }
    .fo-chart-endpoint { top: 3.75rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-fo-benchmark][data-animate] .fo-line {
      stroke-dasharray: 820;
      stroke-dashoffset: 820;
      animation: fo-benchmark-draw 1.1s cubic-bezier(0.2, 0.75, 0.25, 1) 0.15s forwards;
    }

    [data-fo-benchmark][data-animate] .fo-points circle {
      opacity: 0;
      animation: fo-benchmark-point 0.2s ease forwards;
    }

    [data-fo-benchmark][data-animate] .fo-points circle:nth-child(1) { animation-delay: 0.25s; }
    [data-fo-benchmark][data-animate] .fo-points circle:nth-child(2) { animation-delay: 0.4s; }
    [data-fo-benchmark][data-animate] .fo-points circle:nth-child(3) { animation-delay: 0.55s; }
    [data-fo-benchmark][data-animate] .fo-points circle:nth-child(4) { animation-delay: 0.7s; }
    [data-fo-benchmark][data-animate] .fo-points circle:nth-child(5) { animation-delay: 0.85s; }
  }

  @keyframes fo-benchmark-draw { to { stroke-dashoffset: 0; } }
  @keyframes fo-benchmark-point { to { opacity: 1; } }
</style>

<script>
  const benchmark = document.querySelector<HTMLElement>("[data-fo-benchmark]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (benchmark && !reduced && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          benchmark.setAttribute("data-animate", "");
          observer.disconnect();
        }
      },
      { threshold: 0.25 },
    );
    observer.observe(benchmark);
  }
</script>
