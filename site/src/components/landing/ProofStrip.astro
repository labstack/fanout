---
import { benchmark, formatRate } from "../../data/benchmark";

// Keep the Markdown statistic readable in llms.txt and enforce the shared report
// as its authority: a changed result requires updating the authored text too.
const content = await Astro.slots.render("default");
const sustained = `${formatRate(benchmark.sustained.accepted_per_second)} items/s`;
if (!content.includes(`<strong>${sustained}</strong>`)) {
  throw new Error(`Landing stat band must use the published sustained rate: ${sustained}`);
}
---

<div class="fo-proof not-content" set:html={content} />

<style>
  .fo-proof :global(ul) {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    border-block: 1px solid var(--sl-color-gray-5);
  }
  div.fo-proof :global(li) {
    margin: 0;
    font-family: var(--fo-font-display);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  .fo-proof :global(li > p) { margin: 0; font: inherit; }
  .fo-proof :global(strong) { font-weight: 500; color: var(--sl-color-white); }
  .fo-proof :global(a) { color: var(--sl-color-accent-high); text-underline-offset: 0.25em; }
  .fo-proof :global(a strong) { color: inherit; }
  .fo-proof :global(a:focus-visible) { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }
  @media (min-width: 72rem) {
    .fo-proof :global(ul) { display: flex; }
  }
  @media (max-width: 39.999rem) {
    .fo-proof :global(ul) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fo-proof :global(li:first-child) { grid-column: 1 / -1; }
  }
</style>
