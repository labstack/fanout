---
/* The end of the page.
 *
 * A landing page that stops after its last argument leaves the reader to
 * scroll back up for the button. This restates the one action and shows the
 * command, because for a single binary the command *is* the product demo —
 * there is nothing to sign up for and nothing to provision.
 *
 * The command is the one from the install page, in the form that verifies its
 * download. Keep the two in step; a copyable command that has drifted is worse
 * than no command.
 *
 * The copy button reports the copy itself. Analytics counts installs from the
 * browser's own `copy` event, which fires for a hand-made selection and not for
 * the Clipboard API — so a button that only wrote to the clipboard would take
 * over the common path and stop the metric without anything looking broken.
 */
import CopyButton from "./CopyButton.astro";
---

<div class="fo-cta">
  <h2>Install Fanout. Send OpenTelemetry.</h2>
  <p>
    One binary and one data directory. Add an AI provider key to enable the
    built-in agent.
  </p>
  <div class="fo-cta-command">
    <pre
      data-analytics-copy="install_command"
      tabindex="0"
      role="region"
      aria-label="Install command, scrollable"
    ><code id="fo-install-command">curl -fsSL https://raw.githubusercontent.com/labstack/fanout/main/scripts/install.sh | sh</code></pre>
    <CopyButton target="fo-install-command" event="install_command" />
  </div>
  <div class="fo-cta-actions">
    <a
      class="fo-cta-primary"
      href="/docs/get-started/install"
      data-analytics-event="cta_click"
      data-analytics-action="install_guide"
      data-analytics-location="closing_cta"
    >Read the install guide</a>
    <a
      class="fo-cta-ghost"
      href="/docs/guides/mcp"
      data-analytics-event="cta_click"
      data-analytics-action="connect_agent"
      data-analytics-location="closing_cta"
    >Connect your agent</a>
  </div>
  <p class="fo-cta-links">
    <a href="/docs/get-started/install">Deployment requirements</a>{" · "}<a href="/docs/reference/configuration/ai">AI configuration</a>{" · "}<a href="/docs/guides/retention">Storage and retention</a>
  </p>
</div>

<style>
  .fo-cta {
    min-width: 0;
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background: var(--sl-color-gray-6);
  }

  .fo-cta h2 {
    font-family: var(--fo-font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    font-weight: 500;
    margin: 0;
    color: var(--sl-color-white);
    overflow-wrap: normal;
    text-wrap: balance;
  }

  .fo-cta p {
    font-family: var(--fo-font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--sl-color-gray-2);
    margin: 0.85rem 0 0;
    max-width: 60ch;
  }

  .fo-cta-command {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  /* The command scrolls inside its own box rather than widening the page — the
     same rule the reference tables follow, and it is focusable for the same
     reason: an overflow a keyboard cannot reach cannot be read. */
  .fo-cta pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0.85rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-black);
  }

  .fo-cta pre:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .fo-cta code {
    font-family: var(--fo-font-display);
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
    white-space: pre;
  }

  .fo-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .fo-cta .fo-cta-links { max-width: none; font-size: 0.8125rem; }
  .fo-cta-links a { color: inherit; text-underline-offset: 0.2em; }
  .fo-cta-links a:hover { color: var(--sl-color-white); }
  .fo-cta-links a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }

  .fo-cta-primary,
  .fo-cta-ghost {
    display: inline-block;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 7px;
    padding: 0.7rem 1.15rem;
    font-family: var(--fo-font-display);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--sl-color-white);
  }

  .fo-cta-primary {
    background: var(--sl-color-white);
    border-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .fo-cta-primary:hover {
    background: var(--sl-color-gray-1);
    border-color: var(--sl-color-gray-1);
  }

  .fo-cta-ghost:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-black);
  }

  .fo-cta-primary:focus-visible,
  .fo-cta-ghost:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
