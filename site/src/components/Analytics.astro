---
/* Privacy-respecting Google Analytics 4.
 *
 * The component is absent unless PUBLIC_GA_MEASUREMENT_ID is configured for a
 * production build. It denies analytics/ad storage before loading gtag, turns
 * off advertising signals, honors DNT and GPC before making a request, and
 * drops query strings from recorded locations. That keeps local builds and
 * forks silent and avoids asking for consent to store identifiers Fanout does
 * not need.
 */
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim().toUpperCase();

if (measurementId && !/^G-[A-Z0-9]{6,}$/.test(measurementId)) {
  throw new Error(
    `PUBLIC_GA_MEASUREMENT_ID is ${JSON.stringify(measurementId)}, which is not a GA4 measurement id.\n` +
      `Expected the G-XXXXXXXXXX form shown in Admin → Data streams. ` +
      `Leave the variable unset to build the site without analytics.`,
  );
}

const enabled = Boolean(measurementId) && import.meta.env.PROD;
---

{
  enabled && (
    <script is:inline define:vars={{ measurementId }}>
      (function () {
        var signals = [navigator.doNotTrack, window.doNotTrack, navigator.msDoNotTrack];
        for (var i = 0; i < signals.length; i++) {
          if (signals[i] === "1" || signals[i] === "yes") return;
        }
        if (navigator.globalPrivacyControl === true) return;

        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;

        gtag("consent", "default", {
          analytics_storage: "denied",
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
        });

        gtag("js", new Date());
        gtag("config", measurementId, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
          page_location: window.location.origin + window.location.pathname,
        });

        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;

          var link = target.closest("a");
          if (!link) return;

          var eventName = link.dataset.analyticsEvent;
          var action = link.dataset.analyticsAction;
          var location = link.dataset.analyticsLocation;

          // The header's GitHub link is generated by Starlight and cannot carry
          // the explicit attributes used by Fanout-owned links.
          if (!eventName) {
            try {
              var url = new URL(link.href, window.location.href);
              if (url.hostname === "github.com" && url.pathname === "/labstack/fanout") {
                eventName = "outbound_click";
                action = "fanout_github";
                location = "site_header";
              }
            } catch (_) {
              return;
            }
          }

          if (!eventName) return;
          gtag("event", eventName, {
            action: action || "unknown",
            location: location || "unknown",
            link_text: (link.textContent || link.getAttribute("aria-label") || "").trim(),
            link_url: link.href,
          });
        });

        document.addEventListener("copy", function () {
          var selection = window.getSelection();
          var node = selection && selection.anchorNode;
          var element = node && (node.nodeType === Node.ELEMENT_NODE ? node : node.parentElement);
          var source = element && element.closest("[data-analytics-copy]");
          if (!source) return;

          gtag("event", "copy_command", {
            action: source.dataset.analyticsCopy,
            location: "closing_cta",
          });
        });

        var tag = document.createElement("script");
        tag.async = true;
        tag.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(measurementId);
        document.head.appendChild(tag);
      })();
    </script>
  )
}
