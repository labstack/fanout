{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.labstack/pitot",
  "title": "Pitot",
  "description": "Investigate OpenTelemetry traces, metrics, and logs, and manage personal dashboards.",
  "websiteUrl": "https://pitot.dev",
  "icons": [
    {
      "src": "https://pitot.dev/favicon.svg",
      "mimeType": "image/svg+xml"
    }
  ],
  "repository": {
    "url": "https://github.com/labstack/pitot",
    "source": "github"
  },
  "version": "2026.9.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{pitot_host}/mcp",
      "variables": {
        "pitot_host": {
          "description": "Public hostname of your Pitot instance, without a scheme or path.",
          "isRequired": true,
          "placeholder": "pitot.example.com"
        }
      }
    }
  ]
}
