# Traefik edge proxy — secrets.
# Copy to traefik/.env (gitignored) and fill in.

# Scoped Cloudflare API Token used by lego (Traefik's ACME client) for
# the DNS-01 challenge. Required scope (Cloudflare dashboard wording):
#   Permissions: Zone / Zone / Read
#                Zone / DNS  / Edit
#   Zone Resources: include every zone whose hostnames Traefik serves
#                   (one token can cover several). "All zones" works too.
# Create at https://dash.cloudflare.com/profile/api-tokens (API Tokens,
# NOT Global API Key). lego reads this exact variable name automatically.
CF_DNS_API_TOKEN=

# Contact address Let's Encrypt uses for expiry notices. Traefik reads static
# configuration from the environment, so this overrides certificatesResolvers
# in static.yml without putting a personal address in a public file.
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_EMAIL=
