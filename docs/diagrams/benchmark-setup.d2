# Benchmark topology: the load generator runs on its own machine so it is not
# competing for the cores being measured. Render with `just diagrams`.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 5
  }
}

direction: right

driver: "Load driver\nHetzner cpx22 — 2 shared vCPU" {
  style.stroke-dash: 3
  bench: "cmd/bench\nadaptive ramp + query load"
}

net: "Hetzner private network\n10.10.1.0/24, same datacenter" {
  shape: hexagon
}

sut: "System under test\nHetzner ccx13 — 2 DEDICATED vCPU, 8 GB" {
  style.stroke-width: 2
  fanout: "ghcr.io/labstack/fanout\nsha256:feebc9cf" {
    style.stroke-width: 2
  }
  store: "DuckLake + Parquet\nDUCKDB_MEMORY=3GB" {shape: cylinder}
  fanout -> store
}

driver.bench -> net: "OTLP/gRPC :4317"
driver.bench -> net: "HTTP queries :7520"
net -> sut.fanout

note: |md
  The driver is deliberately a separate machine.
  Generating load on the box under test spends
  part of the two cores producing the work being
  measured, which understates the result.
| {near: bottom-center; style.stroke-dash: 3}
