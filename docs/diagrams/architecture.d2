# Fanout runtime architecture: what one process owns, and how a request reaches
# storage. Render with `just diagrams`; commit the SVG beside this file.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 5
  }
}

direction: down

clients: Clients {
  style.fill: transparent
  collector: "OTLP collector or SDK" {style.stroke-dash: 3}
  browser: Browser {style.stroke-dash: 3}
  ext: "External MCP host" {style.stroke-dash: 3}
}

fanout: "fanout — one Go process" {
  style.stroke-width: 2

  http: "HTTP :7520\nroutes + auth middleware"
  ingest: "Ingest\nOTLP gRPC :4317 + HTTP :4318"
  ui: "Embedded React assets"
  agent: "Agent runtime\nmodel + tool loop"
  mcp: "MCP server\n5 typed + 4 dashboard tools"
  obs: "Typed observability contract"
  commit: "Telemetry commit workers\natomic Parquet batches"
  query: "Query kernel\nDuckDB + rollups"
  maint: "Storage maintenance\nretention + native compaction"
  alert: "Alert engine\nrule evaluation + webhooks"

  ingest -> commit
  http -> ui: serves embedded assets
  http -> agent: AG-UI stream
  http -> mcp
  mcp -> agent: in-memory transport
  mcp -> obs
  http -> obs: typed HTTP API
  obs -> query
  alert -> query: evaluates rollups
}

store: Storage {
  style.fill: transparent
  telemetry: "Parquet batches + trace indexes\nstorage.data_dir/telemetry" {shape: cylinder}
  qstate: "Query catalog\nstorage.data_dir/query" {shape: cylinder}
  control: "Control SQLite\nstorage.data_dir/control" {shape: cylinder}
}

model: "Anthropic or OpenAI" {style.stroke-dash: 3}

clients.collector -> fanout.ingest: "OTLP/gRPC or OTLP/HTTP"
clients.browser -> fanout.http: HTTPS
clients.ext -> fanout.http: "/mcp — OAuth"

fanout.commit -> store.telemetry
fanout.query -> store.telemetry: "indexed traces + SQL scans"
fanout.query -> store.qstate
fanout.maint -> store.telemetry: "atomic replacement"
fanout.http -> store.control: "users, sessions, settings, dashboards, threads"
fanout.alert -> store.control: "rules and fired alerts"
fanout.agent -> model: HTTPS
