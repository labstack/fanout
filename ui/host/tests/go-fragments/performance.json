      "sql": "WITH base AS (SELECT * FROM span_rollup WHERE \"bucket\" \u003e= ?::TIMESTAMP_NS AND \"bucket\" \u003c ?::TIMESTAMP_NS AND ((namespace = 'shop'))) SELECT epoch_ms(time_bucket(INTERVAL '60 seconds', \"bucket\"::TIMESTAMP_NS))::BIGINT AS \"_t\", (SELECT CASE WHEN k=-2147483648 THEN 0.0 ELSE\n pow(2.0,(k-1)/8.0)+(pow(2.0,k/8.0)-pow(2.0,(k-1)/8.0))*greatest(0.0,least(1.0,(0.95*total-(cum-n))/n)) END\n FROM (SELECT k,n,sum(n) OVER (ORDER BY k) cum,sum(n) OVER () total\n FROM (SELECT e.key k,sum(e.value)::DOUBLE n\n FROM unnest(flatten(list_transform(list(hist), lambda h: map_entries(h)))) entries(e)\n GROUP BY e.key)) cumulative WHERE cum \u003e= 0.95*total ORDER BY k LIMIT 1) AS \"p95\" FROM base GROUP BY time_bucket(INTERVAL '60 seconds', \"bucket\"::TIMESTAMP_NS) ORDER BY \"_t\" LIMIT 14000",
