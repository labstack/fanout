{
  "name": "@fanout/web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "bun run lint && bun run build:host && bun run build:apps",
    "build:host": "bun --bun vite build",
    "build:apps": "bun --bun vite build --config vite.apps.config.ts",
    "build:watch": "bun --bun vite build --watch",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "deadcode": "cd .. && bun host/node_modules/knip/bin/knip.js --production --config knip.json --include files,exports"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.4",
    "knip": "6.43.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.1",
    "nanoid": "3.3.18"
  }
}
