{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "build/*.ts",
    "vite*.ts",
    "tests/build-graph.test.ts",
    "playwright.config.ts",
    "e2e/failure-report.ts",
    "e2e/fixtures/**/*.ts",
    "e2e/host/**/*.ts",
    "e2e/specs/**/*.ts",
    "e2e/support/**/*.ts"
  ]
}
